}

// ── Rendered repo config (tokens substituted from .ghost/config.json by ghost-kit's
//    render-workflows.sh — every token lives ONLY inside a string literal) ──────────
const REPO           = '__CFG_repo__'
const PLUGIN_VERSION = '__CFG_plugin_version__'
const KEY_VAR        = '__CFG_key_var__'        // talisman env var name in the env file
const ENV_FILE       = '__CFG_env_file__'       // repo-relative env file holding the talisman
// auth.prod.org_id: binds the key to one Coven. When set (and only then) the talisman falls back to
// the per-user GHOST_HUNTING_API_KEY__<ORG8> line /ghost-onboard writes — same order as PHASE0.md.
const ORG_ID         = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test('__CFG_org_id__') ? '__CFG_org_id__' : ''
const USER_KEY_FALLBACK = ORG_ID ? `; [ -z "$TALISMAN" ] && TALISMAN=$(awk -F= '/^GHOST_HUNTING_API_KEY__${ORG_ID.slice(0, 8).toUpperCase()}=/{sub(/^[^=]*=/, ""); print}' "\${XDG_CONFIG_HOME:-$HOME/.config}/ghost-hunting/.env" | tr -d '"'\\''[:space:]')` : ''
const ISOLATION_MODE = '__CFG_isolation_mode__' // 'none' = repo has no isolation primitives
const WT_SCRIPT      = '__CFG_worktree_script__'// repo-relative worktree script (provision/remove)
const DB_SCRIPT      = '__CFG_db_script__'      // repo-relative scratch-DB script (create/url/drop/reap)
const COMMIT_SCRIPT  = '__CFG_commit_script__'  // repo-relative secret-scanned no-push commit primitive
const MIGRATION_GATE = '__CFG_migration_gate__' // repo-relative migration drift gate; empty = none
const DB_PREFIX      = '__CFG_db_prefix__'      // scratch-DB name prefix (e.g. myapp)
const TEST_BACKEND   = '__CFG_test_backend__'   // full backend-suite command, run from the repo root
const TEST_FRONTEND  = '__CFG_test_frontend__'  // full frontend-suite command; empty = none

// ── Args ────────────────────────────────────────────────────────────────
let A = args
if (typeof A === 'string') { try { A = JSON.parse(A) } catch (e) { A = {} } }
if (!A || typeof A !== 'object') A = {}
const GHOST_IDS   = Array.isArray(A.ghosts) ? A.ghosts : null
const HAUNTING_ID = A.haunting_id || null
const RITE_ID     = A.rite_id || null
if (!GHOST_IDS && !HAUNTING_ID && !RITE_ID) throw new Error('extermination requires args.ghosts[] | args.haunting_id | args.rite_id')
const BASE       = A.base_branch || 'main'
const WAVE_CAP   = A.wave_cap || 2
const MECH_ONLY  = !!A.mech_only
// ALLOW_VISUAL: accept frontend/UI ghosts into the set (v1 rejected them). Passes frontend_ok
// through to every ghost-lane so the lane prompts + independent verifier handle frontend work.
const ALLOW_VISUAL = !!A.allow_visual
const INTEG_CAP  = A.integration_fix_cap || 3
const API        = A.api_base || '__CFG_api_base__'
// May render EMPTY — every handoff-hunter reference below guards on it (never invent a user id).
const HUMAN_HUNTER = A.human_hunter_id || '__CFG_human_hunter_id__'
// May render EMPTY — the qa stage guards on it and skips with a log instead of crashing.
const QA_SEANCE  = A.qa_seance_id || '__CFG_qa_seance_id__'
// Deterministic run tag (no Date.now/Math.random in workflows) — from the set spec, valid_slug-safe.
const RUN_TAG = 'integ' + String(HAUNTING_ID || RITE_ID || (GHOST_IDS || []).join('')).replace(/[^a-zA-Z0-9]/g, '').slice(0, 12)
const INTEG_BRANCH = `ext/${RUN_TAG}`

// ── Runtime config guards (a token may render empty — degrade loudly, never crash) ──
// Extermination is built ON the isolation primitives: no worktree/db/commit scripts → no set runs.
if (!WT_SCRIPT || !DB_SCRIPT || !COMMIT_SCRIPT || !DB_PREFIX) {
  log(`ABORT: extermination requires the repo's isolation primitives in .ghost/config.json — worktree_script="${WT_SCRIPT}", db_script="${DB_SCRIPT}", commit_script="${COMMIT_SCRIPT}", db_prefix="${DB_PREFIX}" (isolation.mode="${ISOLATION_MODE}"). Configure isolation (see the ghost-kit docs) before running a set; until then run ghosts one at a time via the default ghost-lane.`)
  return { aborted: true, stage: 'config', reason: 'missing-isolation-config' }
}
if (!TEST_BACKEND) log('WARN: no tests.backend command configured (.ghost/config.json) — the baseline stage is skipped and the integrate gate cannot run the full suite; verification degrades to the migration gate + panels only.')
if (!MIGRATION_GATE) log('note: no isolation.migration_gate configured — migration-gate steps are skipped in lanes and at the integrate gate.')

const CREDS = `## Credentials & context
- This orchestrator runs from the MAIN checkout (cwd = the main repo root). Read the talisman: TALISMAN=$(awk -F= '/^${KEY_VAR}=/{print $2}' "$(git rev-parse --show-toplevel)/${ENV_FILE}" | tr -d '"'\\''[:space:]')${USER_KEY_FALLBACK}; AUTH="Authorization: Bearer $TALISMAN"; API="${API}"
- Client header — set once, then pass -H "$XGC" on EVERY curl to $API alongside -H "$AUTH": XGC="X-Ghost-Client: plugin/${PLUGIN_VERSION} repo/${REPO} wf/$(jq -r '.bundle // empty' "$(git rev-parse --show-toplevel)/.ghost/sync-state.json" 2>/dev/null)"
- EVP field is "content" not "body". List endpoints return {"items":[...]}.
- pipeline_stage and context are DIFFERENT endpoints. Set a stage with PUT /pipeline-stage {"pipeline_stage":"<value>"} (valid: planning/plan_review/implementing/code_review/human_review). NEVER PUT /context with an empty or {"context_payload":{}} body — it wipes objective/acceptance_criteria/agent_notes. To edit agent_notes: GET /context, take .context_payload, merge, PUT the full unwrapped object.
- You are running INSIDE the extermination Workflow. Do ONLY what the stage says.`

// ── Resilient structured-agent gate ─────────────────────────────────────
// A structured agent() call THROWS on a transient subagent failure (StructuredOutput-not-called
// "flake", mid-response connection drop, terminal Overloaded) or RETURNS null (user-skip / terminal
// death). Bare at a top-level stage (collate/integrate/exorcise/ship/…) one throw aborts the ENTIRE
// multi-hour run uncaught, losing the bookkeeping for already-collated work. tryAgent retries the
// transient cases, fails fast on a FATAL account error (credits/quota/auth), and on exhaustion returns
// null so the call site's existing null-handling degrades to a clean abort instead of a crash.
const FATAL_ERR = /out of (usage )?credits|usage limit|quota|401|403|invalid (x-)?api[- ]?key|authentication/i
async function tryAgent(prompt, opts, tries = 3) {
  let last = 'no attempt'
  for (let attempt = 1; attempt <= tries; attempt++) {
    try {
      const r = await agent(prompt, opts)
      if (r != null) return r
      last = 'agent() returned null (user-skip or terminal death)'
    } catch (e) {
      last = String((e && e.message) || e)
      if (FATAL_ERR.test(last)) { log(`FATAL ${opts && opts.label}: ${last} — not retrying`); return null }
    }
    if (attempt < tries) log(`retry ${opts && opts.label} (${attempt}/${tries - 1}) after: ${last}`)
  }
  log(`exhausted ${opts && opts.label} after ${tries} attempts: ${last}`)
  return null
}

// ── Schemas ─────────────────────────────────────────────────────────────
const RESOLVE = { type:'object', additionalProperties:false, required:['ok','ghosts','notes'], properties:{
  ok:{type:'boolean'}, notes:{type:'string'},
  abort_reason:{type:'string'},
  ghosts:{type:'array', items:{ type:'object', additionalProperties:false, required:['id','title','deps'], properties:{
    id:{type:'string'}, title:{type:'string'}, deps:{type:'array',items:{type:'string'},description:'in-SET Spirit-Bond dependency ghost ids'} } } } } }
const ANALYSIS = { type:'object', additionalProperties:false, required:['id','files','migration','dep_toucher','visual','notes'], properties:{
  id:{type:'string'}, files:{type:'array',items:{type:'string'}}, migration:{type:'boolean'},
  dep_toucher:{type:'boolean',description:'touches requirements*/pyproject/package.json/lockfiles (shared dependency manifests → solo)'},
  visual:{type:'boolean',description:'frontend/UI surface → REJECT unless allow_visual (lane default is backend/non-visual)'}, notes:{type:'string'} } }
const BASELINE = { type:'object', additionalProperties:false, required:['ok','red_tests','notes'], properties:{
  ok:{type:'boolean',description:'false ONLY if the suite could not RUN (collection/DB/import error) — not for individual test failures'},
  red_tests:{type:'array',items:{type:'string'},description:'pre-existing failing test ids on the untouched base (pytest node-ids / vitest "file > name")'},
  notes:{type:'string'} } }
const PROV = { type:'object', additionalProperties:false, required:['ok','worktree_path','notes'], properties:{
  ok:{type:'boolean'}, worktree_path:{type:'string'}, notes:{type:'string'} } }
const COLLATE = { type:'object', additionalProperties:false, required:['collated','reason','new_tip'], properties:{
  collated:{type:'boolean'}, reason:{type:'string'}, new_tip:{type:'string'} } }
const INTEG = { type:'object', additionalProperties:false, required:['verdict','notes'], properties:{
  verdict:{type:'string',enum:['PASS','NEEDS_WORK','ESCALATE']}, notes:{type:'string'} } }
const SHIP = { type:'object', additionalProperties:false, required:['pr_url','pr_number','already_existed'], properties:{
  pr_url:{type:'string'}, pr_number:{type:'integer'}, already_existed:{type:'boolean'} } }
const QA = { type:'object', additionalProperties:false, required:['qa_parent_id','auto_passed','human_remaining'], properties:{
  qa_parent_id:{type:'string'}, auto_passed:{type:'integer'}, human_remaining:{type:'array',items:{type:'string'}} } }
const DONE = { type:'object', additionalProperties:false, required:['done','summary'], properties:{
  done:{type:'boolean'}, summary:{type:'string'} } }

// ── The validated wave scheduler (unit-checked in /tmp/p2_scheduler_test.js) ──
function computeWaves(ghosts, waveCap) {
  const cap = waveCap || 2
  const byId = new Map(ghosts.map(g => [g.id, g]))
  const mustSolo = g => !!(g.migration || g.dep_toucher)
  const filesOverlap = (a, b) => { const s = new Set(a.files || []); return (b.files || []).some(f => s.has(f)) }
  const deps = g => (g.deps || []).filter(d => byId.has(d))
  const indeg = new Map(ghosts.map(g => [g.id, deps(g).length]))
  const q = ghosts.filter(g => indeg.get(g.id) === 0).map(g => g.id)
  const topo = []
  while (q.length) {
    const id = q.shift(); topo.push(id)
    for (const g of ghosts) if (deps(g).includes(id)) {
      indeg.set(g.id, indeg.get(g.id) - 1)
      if (indeg.get(g.id) === 0) q.push(g.id)
    }
  }
  if (topo.length !== ghosts.length) throw new Error('dependency cycle in set')
  const waves = []; const placed = new Map()
  for (const id of topo) {
    const g = byId.get(id)
    let minWave = 0
    for (const d of deps(g)) minWave = Math.max(minWave, placed.get(d) + 1)
    let w = minWave
    for (;;) {
      const wave = waves[w] || []
      const members = wave.map(x => byId.get(x))
      const full = wave.length >= cap
      const conflictSolo = mustSolo(g) ? wave.length > 0 : members.some(mustSolo)
      const conflictFiles = members.some(m => filesOverlap(g, m))
      if (!full && !conflictSolo && !conflictFiles) break
      w++
    }
    if (!waves[w]) waves[w] = []
    waves[w].push(id); placed.set(id, w)
  }
  return waves
}

// Track ghosts exorcised at collation, so an abort/closed-PR can reverse them.
const exorcisedAtCollation = []
async function reverseExorcisedOnAbort(reason) {
  if (!exorcisedAtCollation.length) return
  await tryAgent(`${CREDS}

The extermination set ABORTED before merge (${reason}). These ghosts were exorcised at collation to unblock their dependents, but their code is NOT merged: ${JSON.stringify(exorcisedAtCollation)}.
For EACH, REVERSE the premature completion: PUT /api/agent/ghosts/<id>/status {"status":"active_haunt"} and POST a durable EVP: "exorcised-at-integration then the set ABORTED (${reason}); code NOT merged — reopened. Re-run the set or handle individually."
Return done=true.`, { label:'compensate', phase:'handoff', schema:DONE, model:'sonnet', effort:'high' })
}

// ── Stage 1: resolve the set ────────────────────────────────────────────
phase('resolve')
const setSpec = GHOST_IDS ? `the explicit ghost ids ${JSON.stringify(GHOST_IDS)}`
  : HAUNTING_ID ? `every active (non-exorcised) ghost in haunting ${HAUNTING_ID} (GET /api/agent/hauntings/${HAUNTING_ID}/ghosts or list+filter)`
  : `every active ghost in rite ${RITE_ID} (GET /api/agent/rites/${RITE_ID}/ghosts)`
// Model tiers (user-approved 2026-06-11): inherit for the judgment gates (analyze, baseline,
// collate, integrate — mispredictions there silently drop work); 'sonnet' for mechanical stages.
// Per-ghost lanes carry their own tiers in ghost-lane.js.
const resolved = await tryAgent(`${CREDS}

You are the RESOLVE stage of extermination. Build the working set from ${setSpec}.
1. Expand to the concrete ghost id list (skip already-exorcised ghosts).
2. For EACH ghost, GET /api/agent/ghosts/<id>/with-dependencies. Record its Spirit-Bond dependencies. A dependency is "in-set" if its id is also in this set.
3. ABORT (ok=false, abort_reason) if any ghost has an UNEXORCISED dependency that is NOT in this set — extermination can't satisfy out-of-set bonds. (In-set bonds are fine; the scheduler orders them.)
4. Return ok=true with ghosts=[{id, title, deps:[in-set dep ids]}].`, { label:'resolve', phase:'resolve', schema:RESOLVE, model:'sonnet', effort:'high' })

if (!resolved || !resolved.ok || !resolved.ghosts || !resolved.ghosts.length) {
  log(`ABORT at resolve: ${resolved ? (resolved.abort_reason || resolved.notes) : 'no result'}`)
  return { aborted:true, stage:'resolve', detail: resolved }
}
log(`resolved ${resolved.ghosts.length} ghosts: ${resolved.ghosts.map(g => g.id.slice(0,8)).join(', ')}`)

// ── Stage 2: per-ghost analysis (parallel) ──────────────────────────────
phase('analyze')
// deliberate inherit (no model override): file/migration predictions drive wave scheduling —
// a miss isn't caught until realized-overlap AFTER a full lane has run.
const analyses = (await parallel(resolved.ghosts.map(g => () => tryAgent(`${CREDS}

You are an ANALYSIS agent for ghost ${g.id} ("${g.title}"). Read its context: \`curl -s -H "$AUTH" -H "$XGC" "$API/api/agent/ghosts/${g.id}/context" | jq '.context_payload'\` (objective, files, acceptance_criteria, constraints). Optionally grep the MAIN codebase at $(git rev-parse --show-toplevel) to ground predictions — but do NOT edit anything.
Predict, for wave scheduling:
- files: the repo-relative paths this ghost will most likely create/modify (best effort from the plan + a quick look).${ALLOW_VISUAL ? ' When the ghost context_payload.files lists paths, copy them VERBATIM (exact repo-relative strings) and add any others you predict — overlap detection compares exact strings.' : ''}
- migration: true if it will add/alter a DB model or a schema migration (whatever migrations directory this repo uses — e.g. alembic/versions, migrations/versions, drizzle).
- dep_toucher: true if it will touch requirements*/pyproject/package.json/lockfiles (shared dependency manifests).
- visual: true if it touches a FRONTEND / UI surface (components, pages, styles). ${ALLOW_VISUAL ? 'Visual ghosts ARE ALLOWED in this run (allow_visual) — predict honestly; do NOT shade toward false to keep a ghost in the set.' : 'This run rejects these.'}
Return the schema (id=${g.id}).`, { label:`analyze:${g.id.slice(0,8)}`, phase:'analyze', schema:ANALYSIS }))))
  .filter(Boolean)

const visual = analyses.filter(a => a.visual)
const accepted = ALLOW_VISUAL ? analyses : analyses.filter(a => !a.visual)
const setGhosts = accepted.map(a => {
  const r = resolved.ghosts.find(g => g.id === a.id)
  return { id:a.id, title:(r && r.title) || a.id, files:a.files || [], migration:!!a.migration, dep_toucher:!!a.dep_toucher, deps:(r && r.deps) || [] }
})
// Deterministic scheduling: honor the caller's args order (computeWaves breaks topo ties by input
// order, and the resolve agent's output order is otherwise unpinned).
if (GHOST_IDS) setGhosts.sort((a, b) => GHOST_IDS.indexOf(a.id) - GHOST_IDS.indexOf(b.id))
// Ghosts removed from the set here (analysis agent died, or visual-rejected) must seed `dropped`,
// or computeWaves silently erases their in-set bond (byId.has filter) and a dependent burns a
// provisioned worktree + full lane before failing at claim.
const dropped = []    // ghost ids dropped (unanalyzed / visual-rejected / lane escalated / collation refused)
const unanalyzed = resolved.ghosts.map(g => g.id).filter(id => !analyses.some(a => a.id === id))
if (unanalyzed.length) {
  dropped.push(...unanalyzed)
  log(`DROPPED ${unanalyzed.length} ghost(s) whose analysis agent returned nothing: ${unanalyzed.map(id => id.slice(0,8)).join(', ')}`)
}
if (visual.length && !ALLOW_VISUAL) {
  dropped.push(...visual.map(v => v.id))
  log(`REJECTED ${visual.length} visual/frontend ghost(s) from the set (default = backend/non-visual; pass allow_visual to accept): ${visual.map(v => v.id.slice(0,8)).join(', ')}`)
} else if (visual.length) {
  log(`ACCEPTED ${visual.length} visual/frontend ghost(s) (allow_visual): ${visual.map(v => v.id.slice(0,8)).join(', ')}`)
}
if (!setGhosts.length) { log('ABORT: no eligible ghosts left after analysis'); return { aborted:true, stage:'analyze', rejected_visual: visual.map(v=>v.id), unanalyzed } }

// ── Stage 3: schedule ───────────────────────────────────────────────────
phase('schedule')
let waves
try { waves = computeWaves(setGhosts, WAVE_CAP) } catch (e) { log(`ABORT at schedule: ${e.message}`); return { aborted:true, stage:'schedule', reason:e.message } }
const totalGhosts = setGhosts.length
const estTokens = totalGhosts * (MECH_ONLY ? 0.4 : 0.55) // ~M tokens/ghost from the all-inherit Stage-1 smokes — recalibrate after the first model-routed run
log(`wave schedule (${waves.length} waves, cap ${WAVE_CAP}): ${waves.map((w,i)=>`w${i}=[${w.map(id=>id.slice(0,8)).join(',')}]`).join(' ')}`)
log(`estimate: ${totalGhosts} ghosts ≈ ${estTokens.toFixed(1)}M tokens, ${MECH_ONLY ? 'mech-only' : 'full-panel'} mode`)

// ── Stage 4: provision the integration worktree ─────────────────────────
phase('integ-setup')
const integProv = await tryAgent(`${CREDS}

You are the INTEG-SETUP stage. Provision the integration worktree that collects every ghost's commit:
\`"$(git rev-parse --show-toplevel)/${WT_SCRIPT}" provision ${RUN_TAG} ${BASE}\`
Parse stdout: worktree_path = the line beginning "  worktree:". Confirm it's an absolute existing dir on branch ${INTEG_BRANCH}. If the worktree script exits nonzero (e.g. missing repo-root ${ENV_FILE}) → ok=false with the error.
Return ok, worktree_path, notes.`, { label:'integ-setup', phase:'integ-setup', schema:PROV, model:'sonnet', effort:'high' })
if (!integProv || !integProv.ok || !integProv.worktree_path) { log(`ABORT: integration worktree provisioning failed: ${integProv ? integProv.notes : 'no result'}`); return { aborted:true, stage:'integ-setup', detail:integProv } }
const INTEG_WT = integProv.worktree_path
log(`integration worktree: ${INTEG_WT} (branch ${INTEG_BRANCH})`)

// ── Stage 4b: baseline — capture PRE-EXISTING test failures on the untouched integration
//    worktree so a lane / the integrate gate is never blamed for INHERITED red (the halt's root
//    cause). We CLASSIFY (green-at-baseline → red-after = a real regression); we do NOT abort on
//    red tests. We abort ONLY if the suite cannot run at all (no baseline is establishable).
phase('baseline')
const anyVisual = ALLOW_VISUAL && visual.length > 0
const baseline = MECH_ONLY ? { ok:true, red_tests:[], notes:'mech-only: baseline suite skipped' }
  : !TEST_BACKEND ? { ok:true, red_tests:[], notes:'no tests.backend configured — baseline suite skipped (BASELINE_RED empty)' }
  : await tryAgent(`${CREDS}

You are the BASELINE stage. Establish the PRE-EXISTING test failures on the UNTOUCHED integration worktree ${INTEG_WT} (branch ${INTEG_BRANCH}) — no ghost has landed yet — so lanes and the integrate gate don't get blamed for inherited red. Work ONLY in ${INTEG_WT}.
1. Create BOTH scratch DBs: \`"${INTEG_WT}/${DB_SCRIPT}" create ${DB_PREFIX}_${RUN_TAG}base_test\` AND \`"${INTEG_WT}/${DB_SCRIPT}" create ${DB_PREFIX}_${RUN_TAG}base\`.
2. Run the backend suite: \`cd "${INTEG_WT}" && DATABASE_URL=$("${INTEG_WT}/${DB_SCRIPT}" url ${RUN_TAG}base) ${TEST_BACKEND}\`. Record every FAILED/ERROR test id (e.g. pytest's "FAILED path::Class::test" / "ERROR path::..." lines) into red_tests.${anyVisual && TEST_FRONTEND ? ` Then run the frontend suite: \`cd "${INTEG_WT}" && ${TEST_FRONTEND}\` and add each failing test ("file > name") to red_tests.` : ''}
3. Drop both scratch DBs (always, even on failure): \`"${INTEG_WT}/${DB_SCRIPT}" drop ${DB_PREFIX}_${RUN_TAG}base_test\` and \`"${INTEG_WT}/${DB_SCRIPT}" drop ${DB_PREFIX}_${RUN_TAG}base\`.
4. If the suite COULD NOT RUN at all (test-collection error, DB connection error, import error — NOT individual test failures) → ok=false with the error in notes; we cannot establish a baseline.
Return ok=true even when tests FAILED (those failures ARE the baseline), red_tests = the exact failing ids (possibly empty), and a one-line note with the failure counts.`, { label:'baseline', phase:'baseline', schema:BASELINE, effort:'high' }) // deliberate model inherit: honest suite-triage judgment
if (!baseline || !baseline.ok) {
  log(`ABORT at baseline: the suite could not RUN on the untouched base — ${baseline ? baseline.notes : 'no result'} (fix the base, then re-run)`)
  return { aborted:true, stage:'baseline', detail: baseline }
}
const BASELINE_RED = Array.isArray(baseline.red_tests) ? baseline.red_tests : []
if (BASELINE_RED.length) log(`baseline-red (${BASELINE_RED.length} pre-existing failure(s) — will NOT block lanes/integrate): ${BASELINE_RED.slice(0,6).join(' | ')}${BASELINE_RED.length>6?' …':''}`)
else log(`baseline clean — no pre-existing failures${!TEST_BACKEND && !MECH_ONLY ? ' (suite skipped: no tests.backend configured)' : ''}`)

// ── Stage 5+6: run waves, collate serially onto the integration branch ──
phase('waves')
const collated = []   // ghost ids successfully collated
for (let wi = 0; wi < waves.length; wi++) {
  const wave = waves[wi].filter(id => !dropped.includes(id))
  // Skip a ghost whose in-set dependency was dropped (its bond can't be satisfied).
  const runnable = wave.filter(id => {
    const g = setGhosts.find(x => x.id === id)
    const blocked = (g.deps || []).some(d => dropped.includes(d))
    if (blocked) { dropped.push(id); log(`drop ${id.slice(0,8)}: in-set dependency was dropped`) }
    return !blocked
  })
  if (!runnable.length) continue
  log(`── wave ${wi}: ${runnable.map(id=>id.slice(0,8)).join(', ')} ──`)

  // Provision each ghost's worktree off the LIVE integration tip (the prior wave has landed).
  // SERIALIZED: concurrent worktree-script runs race on `git worktree prune`/ref locks in the shared
  // .git, and a failed provision is a permanent drop — seconds of wall-clock buys determinism.
  const provs = []
  for (const id of runnable) {
    provs.push(await tryAgent(`${CREDS}

Provision an isolated worktree for ghost ${id}, branched off the live integration tip:
\`"$(git rev-parse --show-toplevel)/${WT_SCRIPT}" provision g${id.slice(0,8)} ${INTEG_BRANCH}\`
Parse stdout for the "  worktree:" path; confirm it's an absolute existing dir. ok=false + notes on any nonzero exit.
Return ok, worktree_path, notes.`, { label:`prov:${id.slice(0,8)}`, phase:'waves', schema:PROV, model:'sonnet', effort:'high' }))
