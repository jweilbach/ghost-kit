      id: `R${n + 1}`, unit: '', unit8: '', kind: 'R', label: `R${n + 1}`, text: `${str(f.rule, 120)}: ${str(f.finding, 600)}`, source_quote: '', evidence: null,
      verdict: 'not_met', severity: f.severity === 'blocker' ? 'must_fix' : 'note', needs: '', path: str(f.path, 300), start: Number(f.start) || 0, end: Number(f.end) || 0,
      quote: str(f.quote, 1500), missing: str(f.finding, 600), reason: `rule ${str(f.rule, 120)} (${f.severity})`,
    }),
  );
};

if (MODE === 'recheck') {
  phase('judge');
  const prevItems = arr(RECHECK.items).filter((x) => x && x.id);
  for (const x of prevItems) {
    const u = UNITS.find((y) => y.id === x.unit) || { id: String(x.unit || ''), id8: String(x.unit8 || '') };
    ITEMS.push({ id: String(x.id), unit: u.id, unit8: u.id8, kind: String(x.kind || 'FS'), label: String(x.id), text: str(x.text, 1500), source_quote: '', evidence: null, verdict: '', missing: str(x.missing, 600), path: str(x.path, 300), start: Number(x.start) || 0, sibling: str(x.sibling, 300), round1: 'must_fix' });
  }
  for (const u of UNITS) Object.assign(unitState.get(u.id), { read: true, judged: true });
  const items = ITEMS.slice();
  let r = null;
  await all([
    async () => {
      r = await spawn('judge.1', recheckPrompt(items, false), recheckPrompt(items, true), { phase: 'judge', schema: RECHECKED, ...OPUS }, (x) => Array.isArray(x.items) && Array.isArray(x.new_findings));
    },
    rulesPass,
  ]);
  if (!r) INCOMPLETE.push('the round-2 judge died after its retry');
  const v = new Map(arr(r && r.items).map((x) => [String(x.id), x]));
  for (const it of items) {
    const got = v.get(it.id);
    if (got) applyVerdict(it, { ...got, sibling: got.sibling || it.sibling });
  }
  addClaims(r && r.pr_claims);
  takeWording(r);
  takeAnswers(r);
  arr(r && r.new_findings).forEach((f, n) =>
    ITEMS.push({
      id: `${IDP}N${n + 1}`, unit: '', unit8: '', kind: 'N', label: `N${n + 1}`, text: `${f.kind === 'breaks_criterion' ? 'breaks a criterion' : f.kind === 'same_class' ? 'same mistake elsewhere' : 'not asked for'}: ${str(f.text, 600)}`,
      source_quote: '', evidence: null, verdict: 'not_met', severity: f.severity === 'must_fix' ? 'must_fix' : 'note', needs: '', path: str(f.path, 300), start: Number(f.start) || 0, end: Number(f.end) || 0,
      quote: str(f.quote, 1500), missing: str(f.missing, 600), reason: f.kind,
    }),
  );
} else if (MODE === 'single') {
  phase('judge');
  const entryFor = (r, u) => arr(r && r.units).find((e) => String(e.unit || '').slice(0, 8) === u.id8) || null;
  const answers = new Array(GROUPS.length).fill(null);
  await all([
    ...GROUPS.map((group, k) => async () => {
      // A judge must return an entry for every unit it owns, or it is retried once.
      answers[k] = await spawn(`judge.${k + 1}`, soloPrompt(false, k), soloPrompt(true, k), { phase: 'judge', schema: SOLO, ...OPUS }, (x) => Array.isArray(x.units) && group.every((u) => entryFor(x, u)));
    }),
    rulesPass,
  ]);
  // A unit's entry counts only from the judge that owns it.
  const byUnit = new Map();
  GROUPS.forEach((group, k) => {
    for (const u of group) {
      const e = entryFor(answers[k], u);
      if (e) byUnit.set(u.id8, e);
    }
  });
  const verdicts = answers.map((r) => verdictsOf(r));
  addClaims(mergeClaims(answers.map((r) => r && r.pr_claims)));
  takeWording(answers[0]);
  takeAnswers(answers[0]);
  // Honor every unit first, so an item can be deferred to a wisp listed after it or read by
  // another judge.
  for (const u of UNITS) {
    const e = byUnit.get(u.id8) || null;
    const st = honor(u, e ? e.declared : 'built', e ? e.open_reason_quote : '');
    st.read = !!e;
    st.judge = OWNER.get(u.id8) || 1;
  }
  for (const u of UNITS) {
    const e = byUnit.get(u.id8) || null;
    const st = unitState.get(u.id);
    buildItems(u, e);
    if (!e) {
      INCOMPLETE.push(`unit ${u.id8} was never read${answers[st.judge - 1] ? ' (the judge skipped it)' : ' (the judge died)'}`);
      continue;
    }
    if (st.open_honored) {
      addLeftover(st, e.leftover_ok !== false, e.leftover_note);
      continue;
    }
    if (st.untouched) {
      addUntouched(st);
      continue;
    }
    st.judged = true;
    // Only the owning judge's lists are read for this unit.
    const v = verdicts[st.judge - 1];
    for (const it of judgeable(u)) {
      const got = v.get(itemKey(`${u.id8}.${it.label}`));
      if (got) applyVerdict(it, got);
    }
  }
}

// Any item still without a verdict (a skipped id, a dead judge) is unverified, never met.
for (const it of ITEMS) {
  if (it.verdict) continue;
  if (unitState.get(it.unit) && unitState.get(it.unit).open_honored) {
    it.verdict = 'open';
    continue;
  }
  it.verdict = 'unverified';
  it.reason = 'no verdict was returned for this item';
}

phase('verify');
const mustFix = ITEMS.filter((it) => (it.verdict === 'partly' || it.verdict === 'not_met') && it.severity === 'must_fix');
await all(
  chunk(DOUBLE_CHECK ? mustFix : [], LIM.reader_batch).map((batch, bi) => async () => {
    const r = await spawn(`reader.${bi + 1}`, readerPrompt(batch, false), readerPrompt(batch, true), { phase: 'verify', schema: READ, ...OPUS }, (x) => Array.isArray(x.verdicts));
    const byId = new Map(arr(r && r.verdicts).map((v) => [String(v.id), v]));
    for (const it of batch) {
      const v = byId.get(it.id);
      // A dead or silent reader is never a refutation: the gap stays, flagged.
      if (!v) it.reader = 'lost';
      else if (v.holds !== false) it.reader = 'held';
      else if (v.path && v.quote) {
        Object.assign(it, { verdict: 'met', severity: '', overturned: true, reader: 'overturned', path: str(v.path, 300), start: Number(v.start) || 0, end: Number(v.end) || 0, quote: str(v.quote, 1500), reason: `second reader: ${str(v.evidence, 600)}`, missing: '' });
      } else it.reader = 'held';
    }
  }),
);

const result = {
  mode: MODE,
  ghost: { id: String(GHOST.id || ''), title: str(GHOST.title, 300) },
  pr: { number: PR.number, branch: String(PR.branch || '') },
  head: HEAD,
  base: BASE,
  round: num(A.round, 1),
  status: INCOMPLETE.length ? 'incomplete' : 'complete',
  incomplete_reasons: INCOMPLETE.slice(),
  units: [...unitState.values()],
  items: ITEMS.map(({ evidence, label, ...it }) => ({
    ...it,
    sibling: it.sibling || (evidence ? str(evidence.sibling, 300) : ''),
    searched: evidence ? str(evidence.searched, 300) : '',
    evidence_paths: evidence ? arr(evidence.snippets).map((s) => str(s.path, 300)).slice(0, 6) : [],
  })),
  caps: CAPS.slice(),
  double_check: DOUBLE_CHECK,
  wording: WORDS,
  answers: ANSWERED,
  judges: JUDGES,
  effort: OPUS.effort,
  agents: { spawned: STATS.spawned, sonnet: 0, opus: STATS.opus, retries: STATS.retries, dead: STATS.dead.slice(), budget_refused: STATS.budget_refused },
};
const djb2 = (s) => {
  let h = 5381;
  for (let i = 0; i < s.length; i++) h = ((h * 33) ^ s.charCodeAt(i)) >>> 0;
  return h.toString(16).padStart(8, '0');
};
log(`validate: ${result.status} — ${mustFix.length} must-fix before the second reader, ${STATS.spawned} agent(s), ${STATS.dead.length} dead`);
return { result, djb2: djb2(JSON.stringify(result)) };
