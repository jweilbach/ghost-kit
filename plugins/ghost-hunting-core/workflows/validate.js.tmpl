  it.needs = NEEDS.includes(v.needs) ? v.needs : '';
  it.path = str(v.path, 300);
  it.start = Number(v.start) || 0;
  it.end = Number(v.end) || 0;
  it.quote = str(v.quote, 1500);
  it.base_quote = str(v.base_quote, 1500);
  it.behavioral = !!v.behavioral;
  it.test_ref = str(v.test_ref, 300);
  it.sibling = str(v.sibling, 300) || (it.evidence ? str(it.evidence.sibling, 300) : '');
  it.reason = str(v.reason, 600);
  it.missing = str(v.missing, 600);
  it.deferred_to = str(v.deferred_to, 40).slice(0, 8);
