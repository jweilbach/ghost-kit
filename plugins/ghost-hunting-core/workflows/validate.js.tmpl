const pin = (m) => (typeof MODEL_REMAP[m] === 'string' && MODEL_REMAP[m] ? MODEL_REMAP[m] : m);
// The Hunter's ruling: Opus judges at xhigh. Fable is never used. (A Sonnet gather stage in front
// of the judge was measured on six PRs and dropped: no time saved, weaker on one, ~380k Sonnet more.)
// A run may ask for `high` (validate.effort): about half the time and the same findings in
// testing, but softer grading on one borderline criterion, so it is opt-in.
const OPUS = { model: pin('opus'), effort: A.effort === 'high' ? 'high' : 'xhigh' };
// The second reader re-checks every must-fix. It overturned none of ~45 in testing, so it runs only
// when asked (--double-check).
const DOUBLE_CHECK = A.double_check === true;
// A read-only leaf: Read, Grep, Glob, Bash and no Write, so Codex runs it in a read-only sandbox.
// A session that has not loaded the persona yet passes leaf_agent_type: '' (no persona).
const LEAF_TYPE = A.leaf_agent_type === undefined ? 'ghost-hunting-core:validate-leaf' : String(A.leaf_agent_type || '');
const asLeaf = LEAF_TYPE ? { agentType: LEAF_TYPE } : {};

// ── Judges: up to three in parallel, each owning a share of the units ────────────────────────
// One judge's wall-clock is its output (about 7 s per 1,000 tokens), so only a second stream goes
// under it. Every judge gets the whole pack; the parent ghost and the PR-wide work sit with the
// first. Prep picks the count; without a pack there is one judge (a split would re-read the bundle).
const JUDGES = PACKED && MODE === 'single' ? Math.max(1, Math.min(3, num(A.judges, 1), UNITS.length)) : 1;
const unitWeight = (u) => 3 + u.acs.filter((a) => !a.run).length + (u.fixed ? u.fixed.length : 4);
const GROUPS = Array.from({ length: JUDGES }, () => []);
{
  const load = new Array(JUDGES).fill(0);
  const place = (u, k) => {
    GROUPS[k].push(u);
    load[k] += unitWeight(u);
  };
  const parent = UNITS.find((u) => u.kind === 'parent');
  if (parent) place(parent, 0);
  // Heaviest first to the lightest judge; ties keep the list order.
  for (const u of UNITS.filter((x) => x !== parent).sort((a, b) => unitWeight(b) - unitWeight(a))) place(u, load.indexOf(Math.min(...load)));
  for (const g of GROUPS) g.sort((a, b) => UNITS.indexOf(a) - UNITS.indexOf(b));
