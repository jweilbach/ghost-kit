export const meta = {
  name: 'validate',
  description:
    'Read-only acceptance check behind /validate-haunt: ONE pull request against its ghost and every wisp, at the PR head commit, in a detached tree the skill pinned. Prep hands each judge one PACK in its prompt (the PR, every unit\'s text, the whole diff with line numbers) and one LOOK command that takes many file ranges and searches per call, so a judge spends its turns judging, not fetching. ONE Opus judge by default (effort xhigh; up to three in parallel when asked, each owning a share of the units and seeing the whole PR) judges every unit item by item: its acceptance criteria as written (ids fixed by the prep script) and its fix steps as their own list (the first hand run\'s lesson: every real gap was a missed fix step). Each verdict is met / partly / not_met / cant_tell / not_checkable with a citation and, for a gap, a severity (must_fix / note / pre_existing / deferred). It also checks the PR body\'s claims against the code, optionally verifies the PR body\'s wording list line by line (validate.wording), and an optional RULES pass checks the repo\'s named rule files. ROUND 2 (recheck) re-judges only round 1\'s must-fix items, reads the incremental diff, checks what it touches, looks for the same mistake in the PR\'s files and checks what the PR body says the fixes did. An optional SECOND READER (--double-check) searches harder on every must_fix and overturns only with a citation. ENGINE-OWNED: run-result and tracker claims are not_checkable, never gaps; the parent ghost is never "left open"; a wisp is skipped as left open only when its quoted reason is in the PR body and it is not exorcised; a unit\'s verdicts count only from the judge that owns it; a missing verdict is unverified; an acceptance criterion judged not_met is always must_fix; a cant_tell with no code cited becomes not_met; a dead judge or rules pass makes the run incomplete (never a pass); a dead reader leaves the gap in place. Every agent is pinned (Opus, through models.remap), so none inherits the session model. It runs no tests, servers, installs or browsers, writes nothing and calls no API: the skill\'s finish step anchors every citation in the tree, applies the verdict rules and renders the EVP. Returns {result, djb2}.',
  phases: [{ title: 'judge' }, { title: 'verify' }],
};

// ── Args ──────────────────────────────────────────────────────────────────────────────────────
// validate-prep.mjs composes a copy of this file with the args embedded as a const after the meta
// block (reckoning-bus.sh compose, which names it __RECKONING_ARGS__); the Codex runner passes them
// as `args` instead. `typeof` on an undeclared name is safe.
let A = typeof __RECKONING_ARGS__ === 'object' && __RECKONING_ARGS__ !== null ? __RECKONING_ARGS__ : args;
if (typeof A === 'string') {
  try {
    A = JSON.parse(A);
  } catch (e) {
    A = {};
  }
}
if (!A || typeof A !== 'object') A = {};

const arr = (v) => (Array.isArray(v) ? v : []);
// Truncate without splitting a surrogate pair: the result is checksummed, and jq rewrites a lone
// surrogate on the way to finish, which would break the checksum.
const str = (v, max) => {
  const s = String(v == null ? '' : v);
  let end = max || 4000;
  if (s.length <= end) return s;
  const c = s.charCodeAt(end - 1);
  if (c >= 0xd800 && c <= 0xdbff) end -= 1;
  return s.slice(0, end);
};
const trimSlash = (s) => String(s || '').replace(/\/+$/, '');
const num = (v, d) => (Number.isFinite(Number(v)) && Number(v) > 0 ? Math.trunc(Number(v)) : d);
const chunk = (xs, n) => {
  const out = [];
  for (let i = 0; i < xs.length; i += n) out.push(xs.slice(i, i + n));
  return out;
};
const all = (thunks) => parallel(thunks.map((t) => () => Promise.resolve().then(t).catch(() => null)));
// Text is compared with whitespace collapsed and backslashes dropped (judges leave them out).
const squash = (s) => String(s || '').replace(/\\/g, '').replace(/\s+/g, ' ').trim().toLowerCase();

const REPO = '__CFG_repo__';
const MODE = A.mode === 'recheck' ? 'recheck' : 'single';
// Round 2 in brief: round 1's must-fix items, the incremental diff, and what that diff touches.
const RECHECK = A.recheck && typeof A.recheck === 'object' ? A.recheck : null;
const TREE = trimSlash(A.tree);
const CITE = String(A.cite || '');
// The pack (PR, every unit, the whole diff) rides in the judge's prompt, and `look` is one command
// for many ranges and searches. Measured on 17 recorded runs: a judge took ~65 turns, ~20 of them
// only loading the bundle a slice at a time, each turn re-reading a growing context.
const LOOK = String(A.look || '');
const PACK = typeof A.pack === 'string' ? A.pack : '';
const PACKED = !!(LOOK && PACK);
const HEAD = String(A.head || '');
const BASE = String(A.base || '');
const PR = A.pr && typeof A.pr === 'object' ? A.pr : {};
const PR_BODY = squash(str(A.pr_body, 40000));
const GHOST = A.ghost && typeof A.ghost === 'object' ? A.ghost : {};
const UNITS = arr(A.units)
  .filter((u) => u && u.id && u.id8)
  .map((u) => ({
    id: String(u.id),
    id8: String(u.id8),
    kind: u.kind === 'parent' ? 'parent' : 'wisp',
    title: str(u.title, 200),
    status: String(u.status || ''),
    file: String(u.file || ''),
    acs: arr(u.acs).map((a) => ({ id: String(a.id), text: str(a.text, 1500), run: !!a.run })),
    fixed: Array.isArray(u.fixed) ? u.fixed.map((x) => ({ id: String(x.id), kind: x.kind === 'DC' ? 'DC' : 'FS', text: str(x.text, 1500), quote: str(x.quote, 1500) })) : null,
  }));
const RULES = arr(A.rules).map(String);
{
  const missing = [];
  if (!TREE) missing.push('tree');
  if (!CITE && !LOOK) missing.push('cite or look');
  if (!HEAD || !BASE) missing.push('head/base');
  if (!UNITS.length) missing.push('units');
  if (!A.pr_file || !A.diff_file) missing.push('pr_file/diff_file');
  if (MODE === 'recheck' && !(RECHECK && RECHECK.prev_head && RECHECK.incremental_diff)) missing.push('recheck (prev_head, incremental_diff)');
  if (missing.length) throw new Error(`validate: missing args: ${missing.join(', ')} — this engine is driven by /validate-haunt, whose prep script composes its args`);
}
const LIM = {
  max_agents: num(A.max_agents, 12),
  fs_cap: num(A.fs_cap, 10),
  dc_cap: num(A.dc_cap, 7),
  reader_batch: num(A.reader_batch, 10),
};

// ── Models: pinned per role, remappable repo-wide, never inherited from the session ──────────
const CFG_MODEL_REMAP = __CFG_model_remap__;
const MODEL_REMAP = Object.assign(
  {},
  CFG_MODEL_REMAP && typeof CFG_MODEL_REMAP === 'object' ? CFG_MODEL_REMAP : {},
  A.model_overrides && typeof A.model_overrides === 'object' ? A.model_overrides : {},
