// ── Rendered repo config (tokens substituted from .ghost/config.json by ghost-kit's
//    render-workflows.sh — every token lives ONLY inside a string literal) ──────────
const REPO           = '__CFG_repo__'
const PLUGIN_VERSION = '__CFG_plugin_version__'
const KEY_VAR        = '__CFG_key_var__'        // talisman env var name in the env file
const ENV_FILE       = '__CFG_env_file__'       // repo-relative env file holding the talisman
// auth.prod.org_id: binds the key to one Coven. When set (and only then) the talisman falls back to
// the per-user GHOST_HUNTING_API_KEY__<ORG8> line /ghost-onboard writes — same order as PHASE0.md.
const ORG_ID         = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test('__CFG_org_id__') ? '__CFG_org_id__' : ''
const USER_KEY_FALLBACK = ORG_ID ? `; [ -z "$TALISMAN" ] && TALISMAN=$(awk -F= '/^GHOST_HUNTING_API_KEY__${ORG_ID.slice(0, 8).toUpperCase()}=/{sub(/^[^=]*=/, ""); print}' "\${XDG_CONFIG_HOME:-$HOME/.config}/ghost-hunting/.env" | tr -d '"'\\''[:space:]')` : ''
const ISOLATION_MODE = '__CFG_isolation_mode__' // 'none' = repo has no isolation primitives
const DB_SCRIPT      = '__CFG_db_script__'      // repo-relative scratch-DB script (create/url/drop/reap)
const COMMIT_SCRIPT  = '__CFG_commit_script__'  // repo-relative secret-scanned no-push commit primitive
const MIGRATION_GATE = '__CFG_migration_gate__' // repo-relative migration drift gate; empty = none
const DB_PREFIX      = '__CFG_db_prefix__'      // scratch-DB name prefix (e.g. myapp)
const TEST_BACKEND   = '__CFG_test_backend__'   // full backend-suite command, run from the repo root
const TEST_FRONTEND  = '__CFG_test_frontend__'  // full frontend-suite command; empty = none
const TEST_ALL       = '__CFG_test_all__'       // full whole-suite command; empty = none
const BROWSER_TOOL   = '__CFG_browser_tool__'   // 'none'/empty = no browser verification available
const HAS_BROWSER    = !!BROWSER_TOOL && BROWSER_TOOL !== 'none'

// ── Args (normalized — may arrive as object, JSON string, or undefined) ──
let A = args
if (typeof A === 'string') { try { A = JSON.parse(A) } catch (e) { A = {} } }
if (!A || typeof A !== 'object') A = {}
const GHOST_ID = A.ghost_id
if (!GHOST_ID) throw new Error('ghost-lane requires args.ghost_id (got: ' + JSON.stringify(args) + ')')
const BASE = A.base_branch || 'main'
const API = A.api_base || '__CFG_api_base__'
// Product QA séance — where qa-pr drops the verification tree (passed explicitly so qa-pr never
// auto-detects). May render EMPTY — the qa stage guards on it and skips with a log instead of crashing.
const QA_SEANCE = A.qa_seance_id || '__CFG_qa_seance_id__'
const PLAN_CAP = A.plan_review_cap || 5
const CODE_CAP = A.code_review_cap || 5
// Unattended overnight mode (user-authorized 2026-06-14): skip the Binding-Circle
// request at handoff so the orchestrator can exorcise the ghost the moment its PR
// merges (dependents unblock without a human approval gate). /panel review + CI still
// gate every merge; merged PRs + purgatory QA wisps are the review surface.
const NO_BINDING_CIRCLE = A.no_binding_circle === true
// "Escalate to me" — the human Hunter to hand off to. May render EMPTY — every handoff-hunter
// call below guards on it and degrades to EVP + request-approval with a clear note.
const HUMAN_HUNTER = A.human_hunter_id || '__CFG_human_hunter_id__'
const SHORT = String(GHOST_ID).slice(0, 8)
const BRANCH = `ghost/${SHORT}`
const RUN_ARTIFACT = `.claude/state/haunt-cycle/runs/${GHOST_ID}.json`

// ── Phase 2 worktree mode (extermination per-ghost lane) ────────────────
// OWNS_TREE: an orchestrator already created the worktree + branch; this lane must NOT
//   create/switch branches, tolerates a dirty tree, isolates the test DB per ghost,
//   gates migrations, and commits (no push) so commits can be collated.
// NO_SHIP: stop after code-review PASS — skip ship/qa/handoff (the orchestrator ships once).
// Default mode (neither flag) is the unchanged single-ghost PR path.
const OWNS_TREE = !!A.owns_tree
const NO_SHIP   = !!A.no_ship
// MECH_ONLY: smoke/dry-run — auto-PASS the review gates (skip the /panel agents) so a run
// exercises the worktree/DB/commit/guard mechanics without panel cost or nondeterminism.
// Falsy in every real run → the gates behave exactly as before.
const MECH_ONLY = !!A.mech_only
// FRONTEND_OK: this ghost may touch frontend/ — the owns-tree prompts drop the backend-only
// framing and the independent verifier also runs the frontend suite when the committed diff
// touches frontend/. Flag off ⇒ every prompt below is byte-identical to before.
const FRONTEND_OK = !!A.frontend_ok
// BASELINE_RED: test ids already failing on the untouched integration base (extermination's baseline
// stage). The independent verifier treats these as pre-existing — only a test NOT in this list that
// fails counts as a regression this ghost caused. Empty in default (non-set) runs.
const BASELINE_RED = Array.isArray(A.baseline_red) ? A.baseline_red : []
// In owns-tree mode the lane runs IN-SESSION (no claude -p), so the subagent's $CLAUDE_PROJECT_DIR
// and CWD point at MAIN, not the worktree. The orchestrator passes the absolute worktree path here
// and EVERY owns-tree file/git/script ref below uses ${WORKTREE} (never $CLAUDE_PROJECT_DIR).
const WORKTREE  = A.worktree_path || ''
if (OWNS_TREE && !WORKTREE) throw new Error('ghost-lane owns_tree mode requires args.worktree_path (got: ' + JSON.stringify(args) + ')')

// ── Runtime config guards (a token may render empty — degrade loudly, never crash) ──
if (OWNS_TREE && (!DB_SCRIPT || !COMMIT_SCRIPT || !DB_PREFIX)) {
  log(`ABORT: owns_tree mode requires the repo's isolation primitives in .ghost/config.json — db_script="${DB_SCRIPT}", commit_script="${COMMIT_SCRIPT}", db_prefix="${DB_PREFIX}" (isolation.mode="${ISOLATION_MODE}"). Configure isolation or run the default (non-owns-tree) lane.`)
  return { aborted: true, reason: 'missing-isolation-config' }
}
if (OWNS_TREE && !TEST_BACKEND) log('WARN: no tests.backend command configured (.ghost/config.json) — the owns-tree suite run and the independent verifier are SKIPPED; the test dimension rests on targeted checks + review only.')
if (OWNS_TREE && !MIGRATION_GATE) log('note: no isolation.migration_gate configured — migration-gate steps are skipped in this lane.')

// Filled by SETUP from the live worktree in owns-tree mode; stay as-is otherwise.
let GHOST_BRANCH  = BRANCH
let PRE_GHOST_SHA = ''
let DB_SLUG       = ''
let GHOST_SHA     = ''
// owns-tree main-checkout guard: derived in SETUP from the worktree's git-common-dir (tamper-proof).
let MAIN_ROOT     = ''
let MAIN_HEAD_SHA = ''
let MAIN_BRANCH   = ''

// Project root for shell refs: the worktree in owns-tree mode, else the literal $CLAUDE_PROJECT_DIR
// shell var (so default-mode prompts stay byte-identical to today).
const ROOTREF = OWNS_TREE ? WORKTREE : '$(git rev-parse --show-toplevel)'

const CREDS = `## Credentials & context
- Read the talisman: TALISMAN=$(awk -F= '/^${KEY_VAR}=/{print $2}' "${ROOTREF}/${ENV_FILE}" | tr -d '"'\\''[:space:]')${USER_KEY_FALLBACK}; AUTH="Authorization: Bearer $TALISMAN"; API="${API}"
- Client header — set once, then pass -H "$XGC" on EVERY curl to $API alongside -H "$AUTH": XGC="X-Ghost-Client: plugin/${PLUGIN_VERSION} repo/${REPO} wf/$(jq -r '.bundle // empty' "${ROOTREF}/.ghost/sync-state.json" 2>/dev/null)"
- Ghost ID: ${GHOST_ID}  ·  short: ${SHORT}  ·  branch: ${BRANCH}  ·  base: ${BASE}
- You are running INSIDE the haunt-cycle Workflow. The Workflow owns the ghost's pipeline_stage/status transitions — you only do what this stage says.
- EVP field is "content" not "body". The hunters endpoint returns {"items":[...]}. Context PUT REPLACES the whole context_payload — to change agent_notes, GET /context, take .context_payload, merge, PUT the full unwrapped object.
- pipeline_stage and context are DIFFERENT endpoints. To set a stage, PUT /pipeline-stage {"pipeline_stage":"<value>"} — NEVER PUT /context to change a stage. NEVER PUT /context with an empty body or {"context_payload":{}}: that WIPES the ghost's objective/acceptance_criteria/agent_notes. ONLY the plan stage writes /context (via GET-merge-PUT); every other stage treats /context as READ-ONLY.
- Invoke skills via the Skill tool (confirmed available in this subagent). Pass all inputs as args so nothing blocks on a prompt.`

// ── Resilient structured-agent gate ─────────────────────────────────────
// Every gate below is a structured agent() call that THROWS on a transient subagent failure
// (StructuredOutput-not-called "flake", mid-response connection drop, terminal Overloaded) or
// RETURNS null (user-skip / terminal death). Bare, one flake kills a whole lane that was otherwise
// succeeding. tryAgent retries the transient cases a few times, fails fast on a FATAL account error
// (credits/quota/auth — retrying can't help), and on exhaustion returns null so the call site's
// existing null-handling escalates cleanly instead of the lane crashing on an uncaught throw.
const FATAL_ERR = /out of (usage )?credits|usage limit|quota|401|403|invalid (x-)?api[- ]?key|authentication/i
async function tryAgent(prompt, opts, tries = 3) {
  let last = 'no attempt'
  for (let attempt = 1; attempt <= tries; attempt++) {
    try {
      const r = await agent(prompt, opts)
      if (r != null) return r
      last = 'agent() returned null (user-skip or terminal death)'
    } catch (e) {
      last = String((e && e.message) || e)
      if (FATAL_ERR.test(last)) { log(`FATAL ${opts && opts.label}: ${last} — not retrying`); return null }
    }
    if (attempt < tries) log(`retry ${opts && opts.label} (${attempt}/${tries - 1}) after: ${last}`)
  }
  log(`exhausted ${opts && opts.label} after ${tries} attempts: ${last}`)
  return null
}

// ── Schemas ─────────────────────────────────────────────────────────────
const SETUP = { type:'object', additionalProperties:false, required:['ok','tree_clean','ghost_branch','ghost_title','notes'], properties:{
  ok:{type:'boolean'}, tree_clean:{type:'boolean'}, ghost_branch:{type:'string'}, ghost_title:{type:'string'}, notes:{type:'string'},
  pre_ghost_sha:{type:'string',description:'owns-tree only: HEAD before this ghost (the code-review base)'},
  db_slug:{type:'string',description:'owns-tree only: per-ghost DB slug, e.g. g<short><nonce>'},
  main_root:{type:'string',description:'owns-tree only: absolute path to the MAIN checkout (guard target)'},
  main_head_sha:{type:'string',description:'owns-tree only: MAIN HEAD before this ghost (guard baseline)'},
  main_branch:{type:'string',description:'owns-tree only: MAIN current branch (guard baseline)'} } }
// owns-tree main-checkout guard verdict
const GUARD = { type:'object', additionalProperties:false, required:['main_clean','detail'], properties:{
  main_clean:{type:'boolean'}, detail:{type:'string'} } }
const PLAN = { type:'object', additionalProperties:false, required:['planned','files','test_plan','summary'], properties:{
  planned:{type:'boolean'}, files:{type:'array',items:{type:'string'}}, test_plan:{type:'array',items:{type:'string'}}, summary:{type:'string'} } }
// verdict: PASS (advance) · NEEDS_WORK (loop back & fix) · ESCALATE (fundamentally bad → pull in the human now)
const REVIEW = { type:'object', additionalProperties:false, required:['verdict','lenses','blockers','escalate_reason','notes'], properties:{
  verdict:{type:'string',enum:['PASS','NEEDS_WORK','ESCALATE']},
  lenses:{type:'array',items:{type:'string'},description:'the /panel lenses actually run this cycle'},
  blockers:{type:'array',items:{type:'string'}},
  escalate_reason:{type:'string',description:'why a human must decide — non-empty ONLY when verdict=ESCALATE'},
  notes:{type:'string'},
  panel_ran:{type:'boolean',description:'code-review only: whether /panel actually ran this cycle (false = skipped because the non-test source diff was unchanged)'},
  panel_src_id:{type:'string',description:'code-review only: git patch-id of the non-test source diff (the panel-skip fingerprint)'},
  panel_blockers:{type:'array',items:{type:'string'},description:'code-review only: panel-attributable blockers — fresh this cycle, or carried verbatim when panel_ran=false'} } }
const IMPL = { type:'object', additionalProperties:false, required:['tests_passed','files_changed','summary'], properties:{
  tests_passed:{type:'boolean'}, files_changed:{type:'array',items:{type:'string'}}, summary:{type:'string'} } }
const SHIP = { type:'object', additionalProperties:false, required:['pr_url','pr_number','already_existed'], properties:{
  pr_url:{type:'string'}, pr_number:{type:'integer'}, already_existed:{type:'boolean'} } }
const QA = { type:'object', additionalProperties:false, required:['qa_parent_id','auto_passed','human_remaining','already_existed'], properties:{
  qa_parent_id:{type:'string'}, auto_passed:{type:'integer'}, human_remaining:{type:'array',items:{type:'string'}}, already_existed:{type:'boolean'} } }
const HANDOFF = { type:'object', additionalProperties:false, required:['handed_off','summary'], properties:{
  handed_off:{type:'boolean'}, summary:{type:'string'} } }
// owns-tree only: the no-push commit step's result
const COMMIT_S = { type:'object', additionalProperties:false, required:['committed','sha','notes'], properties:{
  committed:{type:'boolean'}, sha:{type:'string'}, notes:{type:'string'} } }
// owns-tree only: independent test verification (the code-review gate consumes this, not the
// implementer's self-report)
const TESTV = { type:'object', additionalProperties:false, required:['tests_passed','detail'], properties:{
  tests_passed:{type:'boolean'}, detail:{type:'string',description:'MUST quote the verbatim test-runner summary line + the migration gate final line (when configured)'} } }

// ── Shared escalation: pull in the human (3rd path) ─────────────────────
// Used by BOTH gates for (a) a fundamental ESCALATE verdict and (b) hitting a cycle cap.
async function escalate(stage, reason) {
  return await tryAgent(`${CREDS}

ESCALATE (${stage}) — the work is fundamentally blocked and looping will not help. Reason:
${reason}

Pull in the human Hunter NOW:
1. Set status to "poltergeist": PUT /api/agent/ghosts/${GHOST_ID}/status {"status":"poltergeist"}.
2. Set pipeline_stage to "human_review": PUT /api/agent/ghosts/${GHOST_ID}/pipeline-stage {"pipeline_stage":"human_review"}.
${HUMAN_HUNTER ? `3. Hand off to the human Hunter: POST /api/agent/ghosts/${GHOST_ID}/handoff-hunter {"target_user_id":"${HUMAN_HUNTER}","handoff_notes":"<the reason + that work-in-progress is on branch ${GHOST_BRANCH}>"}.
4. POST /api/agent/ghosts/${GHOST_ID}/request-approval.` : `3. No human_hunter_id is configured for this repo (.ghost/config.json) — SKIP handoff-hunter (do not invent a user id).
4. POST /api/agent/ghosts/${GHOST_ID}/request-approval so the ghost surfaces in the approval queue.`}
5. Post a durable EVP that clearly explains WHY this was escalated (the fundamental problem) and what a human must decide. Note that any work-in-progress is on branch ${GHOST_BRANCH}.
Do NOT switch git branches — leave the WIP in place for the human. Return handed_off=true with a one-line summary.`,
    { label:`escalate:${stage}`, phase:stage, schema:HANDOFF, model:'sonnet', effort:'high' })
}

// ── owns-tree main-checkout guard (in-session safety net) ───────────────
// A DEDICATED read-only agent (NOT the implement agent self-certifying) asserts MAIN stayed
// pristine. In-session, a stray edit/relative path could leak to the main checkout; this turns
// silent corruption into a loud escalation BEFORE we commit/collate.
async function assertMainUntouched(stage) {
  return await tryAgent(`${CREDS}

You are the MAIN-CHECKOUT GUARD for ghost ${GHOST_ID} (after ${stage}). The MAIN checkout is at ${MAIN_ROOT}; this ghost's work belongs ONLY in the worktree ${WORKTREE}. Run ONLY read-only checks — touch / reset / clean NOTHING. The DELTA is computed vs the porcelain baseline snapshotted at setup (so pre-existing/external untracked files in main don't false-trip; only NEW dirt from this lane does). Run this ONE command and report its output verbatim:
\`BL="${MAIN_ROOT}/.claude/state/haunt-cycle/runs/${GHOST_ID}.baseline"; DELTA="$(comm -13 "$BL" <(git -C "${MAIN_ROOT}" status --porcelain | sort) 2>&1)"; H="$(git -C "${MAIN_ROOT}" rev-parse HEAD)"; B="$(git -C "${MAIN_ROOT}" rev-parse --abbrev-ref HEAD)"; printf 'DELTA=[%s]\\nHEAD=%s\\nBRANCH=%s\\n' "$DELTA" "$H" "$B"\`
Set main_clean=true ONLY if ALL hold: DELTA is empty (no new porcelain lines vs the setup baseline) AND HEAD == ${MAIN_HEAD_SHA} AND BRANCH == ${MAIN_BRANCH}. Otherwise main_clean=false and put DELTA + the changed sha/branch in detail.`,
    { label:`guard:${stage}`, phase:stage, schema:GUARD, model:'sonnet', effort:'high' })
}

// Shared guidance for choosing /panel lenses. Route by the panel skill's own Phase-2
// table — run ONLY the relevant lenses, never all of them — and keep the PER-CYCLE panels
// LEAN so an unchanged diff isn't re-reviewed by five lenses every loop. The heavy
// user-persona / product-manager lenses do NOT fire per-cycle in a set run; they run ONCE
// at the end of the set on the merged collective diff (extermination's UX panel).
const PLAN_PANEL_ROUTING = `Route /panel by the panel skill's Phase-2 table — run ONLY the relevant lenses, never all of them. For an implementation plan that is staff-engineer + product-manager (technical rigor + scope/value); add senior-ux ONLY if the plan introduces a substantial new UI surface. State which lenses you chose and why.`
const CODE_PANEL_ROUTING = OWNS_TREE
  ? `Route /panel by the panel skill's Phase-2 table — run ONLY the relevant lenses, never all of them, and keep this per-cycle panel LEAN: staff-engineer ALWAYS (correctness / security / data-integrity); add senior-ux ONLY when THIS ghost's own diff changes non-trivial UI logic or layout. Do NOT run product-manager or any user-persona lens (this repo's user-* agents in .claude/agents/) per cycle — the extermination set runs ONE end-of-set usability/design panel on the merged collective diff, which is where those lenses belong. State which lenses you chose and why.`
  : `Route /panel by the panel skill's Phase-2 table — run ONLY the relevant lenses, never all of them: staff-engineer ALWAYS; add senior-ux + the fitting user-persona lens(es) from this repo's .claude/agents/ when the frontend / that surface is touched. State which lenses you chose and why.`

// ── Stage 0: setup ──────────────────────────────────────────────────────
phase('setup')
const setupPrompt = OWNS_TREE ? `${CREDS}

You are the SETUP stage of ghost-lane in OWNS-TREE mode for ghost ${GHOST_ID}. An orchestrator already created this git worktree + its branch; do NOT create or switch branches, and a dirty tree is EXPECTED — do NOT abort on it. IMPORTANT: you are running IN-SESSION, so your \$CLAUDE_PROJECT_DIR and CWD point at the MAIN checkout — IGNORE them. The worktree is at the absolute path ${WORKTREE}; use it for every git/file op below.
1. Assert ${WORKTREE} is a LINKED WORKTREE, not the main checkout: \`[ "$(git -C "${WORKTREE}" rev-parse --git-dir)" != "$(git -C "${WORKTREE}" rev-parse --git-common-dir)" ]\`. If it is NOT a linked worktree, set ok=false and STOP (owns-tree must NEVER run in the main tree).
2. Record the integration head BEFORE this ghost: \`git -C "${WORKTREE}" rev-parse HEAD\` → return as pre_ghost_sha. Record the current branch: \`git -C "${WORKTREE}" rev-parse --abbrev-ref HEAD\` → return as ghost_branch. Report tree_clean honestly from \`git -C "${WORKTREE}" status --porcelain\` (true if empty) but do NOT abort when dirty.
3. Derive the MAIN-CHECKOUT GUARD baseline from the worktree (tamper-proof, absolute): \`MAIN_ROOT="$(cd "$(git -C "${WORKTREE}" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)"\` → return as main_root. Then \`git -C "$MAIN_ROOT" rev-parse HEAD\` → main_head_sha and \`git -C "$MAIN_ROOT" rev-parse --abbrev-ref HEAD\` → main_branch. (A later guard asserts MAIN stays at exactly this sha+branch.)
3b. Write the guard's PORCELAIN BASELINE as ONE command (shell vars do not survive across your separate bash calls — re-derive MR inline). Policy: pre-existing UNTRACKED ("??") entries in main are tolerated (they go in the baseline); any TRACKED modification at baseline is REFUSED (a dirty tracked file would mask lane contamination — the guard compares status lines, not content). Run exactly:
\`MR="$(cd "$(git -C "${WORKTREE}" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)" && P="$(git -C "$MR" status --porcelain)" && if printf '%s\\n' "$P" | grep -q '^[^?]'; then echo "TRACKED-DIRTY-AT-BASELINE"; else mkdir -p "$MR/.claude/state/haunt-cycle/runs" && printf '%s\\n' "$P" | sort > "$MR/.claude/state/haunt-cycle/runs/${GHOST_ID}.baseline" && echo "BASELINE-OK"; fi\`
If it prints TRACKED-DIRTY-AT-BASELINE → set ok=false and STOP (notes: main has uncommitted tracked changes; commit or stash them first).
4. Derive a per-ghost DB slug (>=12 chars, unique to avoid collisions across parallel ghosts): \`SLUG="g${SHORT}$RANDOM"\` → return as db_slug.
5. Fetch the ghost title: \`curl -s -H "$AUTH" -H "$XGC" "$API/api/agent/ghosts/${GHOST_ID}" | jq -r .title\`.
6. Set pipeline_stage "planning": PUT .../pipeline-stage {"pipeline_stage":"planning"}.
7. Post a start EVP: "haunt-cycle (owns-tree, in-session) started on the worktree branch at the recorded base. Entering plan stage."
8. Write the run artifact to MAIN (NOT the worktree — it must survive worktree reap for resume/audit; gitignored so it won't dirty the guard). Re-derive MR inline (shell vars don't persist across your bash calls): \`MR="$(cd "$(git -C "${WORKTREE}" rev-parse --path-format=absolute --git-common-dir)/.." && pwd)" && mkdir -p "$MR/.claude/state/haunt-cycle/runs" && B=$(git -C "${WORKTREE}" rev-parse --abbrev-ref HEAD) && printf '%s' "{\\"ghost_id\\":\\"${GHOST_ID}\\",\\"branch\\":\\"$B\\",\\"stage\\":\\"setup\\"}" > "$MR/${RUN_ARTIFACT}"\`.
Return the schema: ok=true, the real tree_clean, ghost_branch, pre_ghost_sha, db_slug, main_root, main_head_sha, main_branch, ghost_title.` : `${CREDS}

You are the SETUP stage of ghost-lane for ghost ${GHOST_ID}.
FAIL-CLOSED PRECONDITION (do this FIRST, before anything else): assert this is NOT a linked worktree — \`[ "$(git -C "$(git rev-parse --show-toplevel)" rev-parse --git-dir)" = "$(git -C "$(git rev-parse --show-toplevel)" rev-parse --git-common-dir)" ]\` MUST hold (git-dir == git-common-dir → the main checkout). If it is a linked worktree, set ok=false and tree_clean=false and STOP immediately: default mode must NEVER run inside a worktree, because SHIP would push and open a real PR. An orchestrator that owns a worktree must invoke this lane with owns_tree=true instead. (This is the inverse of the owns-tree SETUP's linked-worktree assertion, so the two modes are mutually fail-closed.)
Do exactly this, in order, all from the main repo at $(git rev-parse --show-toplevel):
1. Assert the working tree is CLEAN: run \`git -C "$(git rev-parse --show-toplevel)" status --porcelain\`. If it prints ANYTHING, set tree_clean=false, ok=false, STOP. Otherwise tree_clean=true.
2. \`git -C "$(git rev-parse --show-toplevel)" fetch origin --quiet\`. Create the ghost branch off ${BASE}: \`git -C "$(git rev-parse --show-toplevel)" checkout -B ${BRANCH} origin/${BASE}\` (or local ${BASE} if origin/${BASE} is absent). Idempotent — just check it out if it already exists.
3. Fetch the ghost title: \`curl -s -H "$AUTH" -H "$XGC" "$API/api/agent/ghosts/${GHOST_ID}" | jq -r .title\`.
4. Set pipeline_stage "planning": PUT .../pipeline-stage {"pipeline_stage":"planning"}.
5. Post a start EVP: "haunt-cycle started — branch ${BRANCH} off ${BASE}. Entering plan stage."
6. Write the run artifact: \`R="$(git rev-parse --show-toplevel)" && mkdir -p "$R/.claude/state/haunt-cycle/runs" && printf '%s' '{"ghost_id":"${GHOST_ID}","branch":"${BRANCH}","stage":"setup"}' > "$R/${RUN_ARTIFACT}"\`.
Return the schema. If the tree was dirty, ok=false.`
// Model tiers (user-approved 2026-06-11): inherit ONLY for plan + the review gates;
// 'opus' for implement; 'sonnet' for mechanical/scripted stages. Saves the bulk of
