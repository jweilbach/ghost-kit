Map the verdict: PASS (every acceptance criterion Met + panel_blockers empty + the test dimension green per the TEST SIGNALS above) → PASS; fixable blockers (a Not-Met/Partial criterion, a non-empty panel_blockers, a verifier-red/disagreement, or a missing migration the gate flagged) → NEEDS_WORK; fundamentally broken (plan wrong, criteria unachievable, security/data-loss) → ESCALATE (set escalate_reason).
Return the schema (list the lenses that ran; set panel_ran, panel_src_id, and panel_blockers per step 4; fold panel_blockers into the overall blockers array; put the criteria matrix summary in notes).` : `${CREDS}

You are the CODE-REVIEW gate of ghost-lane (cycle ${cycle}, cap ${CODE_CAP}). You are on branch ${BRANCH}; the implementation is in the working tree (uncommitted).
Set pipeline_stage "code_review": PUT /api/agent/ghosts/${GHOST_ID}/pipeline-stage {"pipeline_stage":"code_review"} (the /pipeline-stage endpoint — NOT /context).
Invoke the plugin skill **ghost-hunting-core:review-haunt** with args: \`${GHOST_ID} --base=${BASE} --force-panel\` (Skill tool, skill "ghost-hunting-core:review-haunt"). \`--force-panel\` makes it run /panel on the diff EVERY cycle (never skipped). ${CODE_PANEL_ROUTING}
Map the verdict: PASS (tests green + criteria met) → PASS; "NEEDS WORK"/"FAIL" with fixable issues → NEEDS_WORK; fundamentally broken (the plan was wrong, criteria unachievable, security/data-loss) → ESCALATE (set escalate_reason).
Return the schema (list the lenses that ran).`
  codeReview = MECH_ONLY ? { verdict:'PASS', lenses:['(mech-only)'], blockers:[], escalate_reason:'', notes:'mechanism-only smoke: code-review panel skipped' } : await tryAgent(crPrompt, { label:`code-review#${cycle}`, phase:'code-review', schema:REVIEW, effort:'xhigh' }) // deliberate model inherit: judgment gate

  // A2: remember the fingerprint + panel blockers this cycle's /panel ran on, so a later
  // cycle that only touched tests (unchanged source) can skip re-running the panel.
  if (codeReview && codeReview.panel_src_id !== undefined) {
    lastPanelSrcId = codeReview.panel_src_id || lastPanelSrcId
    lastPanelBlockers = Array.isArray(codeReview.panel_blockers) ? codeReview.panel_blockers : lastPanelBlockers
  }

  log(`code-review cycle ${cycle}: ${codeReview ? codeReview.verdict : 'null'} (lenses: ${codeReview ? (codeReview.lenses||[]).join(',') : '?'})${codeReview && codeReview.panel_ran === false ? ' [panel skipped: source unchanged]' : ''}`)
  if (codeReview && codeReview.verdict === 'PASS') break
  if (codeReview && codeReview.verdict === 'ESCALATE') {
    await escalate('code-review', codeReview.escalate_reason || 'code-review judged the work fundamentally bad')
    return { escalated:'code-review-fundamental', codeReview }
  }
  if (cycle === CODE_CAP - 1) {
    await escalate('code-review', `Code-review reached the cycle cap (${CODE_CAP}) without PASS. Latest blockers: ${JSON.stringify((codeReview && codeReview.blockers) || [])}`)
    return { escalated:'code-review-cap', codeReview }
  }
}

// ── OWNS-TREE + NO_SHIP: stop after code-review PASS; the orchestrator collates + ships. ──
if (NO_SHIP) {
  // Final MAIN guard before declaring integration-ready — code-review could also have leaked.
  if (OWNS_TREE) {
    const gs = await assertMainUntouched('stop')
    if (!gs || !gs.main_clean) {
      await escalate('code-review', `MAIN checkout was modified during the owns-tree lane (caught at STOP) at ${MAIN_ROOT}: ${gs ? gs.detail : 'guard agent failed'}. Not declaring integration-ready.`)
      return { escalated:'main-contaminated-at-stop', guard:gs }
    }
  }
  await tryAgent(`${CREDS}

You are the STOP step of ghost-lane (no-ship) for ghost ${GHOST_ID}. Code-review PASSED; the work is committed at ${GHOST_SHA || '(see worktree)'} on branch ${GHOST_BRANCH} (base ${PRE_GHOST_SHA}); nothing is pushed.
1. Update the run artifact stage to "committed" (it lives in MAIN, not the worktree — survives reap): \`mkdir -p "${MAIN_ROOT}/.claude/state/haunt-cycle/runs" && printf '%s' '{"ghost_id":"${GHOST_ID}","branch":"${GHOST_BRANCH}","stage":"committed","ghost_commit_sha":"${GHOST_SHA}","base_sha":"${PRE_GHOST_SHA}"}' > "${MAIN_ROOT}/${RUN_ARTIFACT}"\`.
2. Leave pipeline_stage as-is (it is "code_review"; the API enum has NO "integration" value — valid stages are planning/plan_review/implementing/code_review/human_review — and the orchestrator tracks collation via the run artifact above, not pipeline_stage). Do NOT attempt a pipeline_stage PUT here.
3. Post an EVP: "owns-tree lane done — committed ${GHOST_SHA} on ${GHOST_BRANCH} (base ${PRE_GHOST_SHA}). Awaiting integration/collation by the orchestrator; not pushed."
Return handed_off=true with a one-line summary.`, { label:'stop', phase:'handoff', schema:HANDOFF, model:'sonnet', effort:'high' })
  log(`STOP (no-ship): ${GHOST_SHA} on ${GHOST_BRANCH}, base ${PRE_GHOST_SHA}`)
  return {
    ghost_id: GHOST_ID,
    ghost_title: setup.ghost_title,
    branch: GHOST_BRANCH,
    ghost_commit_sha: GHOST_SHA,
    base_sha: PRE_GHOST_SHA,
    verdict: 'committed-no-ship',
  }
}

// ── Stage 5: ship (commit + push + open PR) — idempotent ────────────────
phase('ship')
const ship = await tryAgent(`${CREDS}

You are the SHIP stage of ghost-lane. You are on branch ${BRANCH} with passing, code-reviewed changes uncommitted in the tree.
IDEMPOTENCY: first check \`gh pr list --head ${BRANCH} --json number,url --jq '.[0]'\`. If a PR already exists for ${BRANCH}, return it with already_existed=true and do nothing else.
FIRST best-effort format the backend tree so the committed diff is formatted: \`(cd "$(git rev-parse --show-toplevel)/backend" && source venv/bin/activate 2>/dev/null && ruff format . >/dev/null 2>&1 || true)\` (best-effort — a silent no-op in repos without a Python backend; unformatted lane output has shipped red builds — user-approved 2026-06-11).
Then invoke the global skill **wrap-up** with args \`--yes\` (Skill tool): secret-scan, commit with an explicit pathspec, push ${BRANCH}, open a PR against ${BASE}. If wrap-up aborts on an unexcludable secret, do NOT force — set status poltergeist, post an EVP, return pr_url="" pr_number=0.
After the PR opens, post an EVP with the PR url and append it to the ghost's agent_notes (GET/merge/PUT the full context_payload). Return the schema.`, { label:'ship', phase:'ship', schema:SHIP, model:'sonnet', effort:'high' })

if (!ship || !ship.pr_url) {
  log('ship failed (no PR) — stopping')
  return { setup, planReview, impl, codeReview, ship, stopped:'ship-failed' }
}
log(`ship: PR ${ship.pr_url}${ship.already_existed ? ' (existed)' : ''}`)

// ── Stage 6: QA tree (in-cycle, before merge gate) — idempotent ─────────
phase('qa')
let qa = null
if (!QA_SEANCE) {
  log('qa: SKIPPED — no qa_seance_id configured (.ghost/config.json seance.qa_seance_id is empty); the handoff EVP will note that QA must be run manually')
} else {
  qa = await tryAgent(`${CREDS}

You are the QA stage of ghost-lane. PR ${ship.pr_url} (#${ship.pr_number}) is open for branch ${BRANCH}; you are on that branch.
IDEMPOTENCY: search for an existing QA parent for this PR: \`curl -s -H "$AUTH" -H "$XGC" "$API/api/agent/search?q=PR+%23${ship.pr_number}" | jq '.tasks[]? | select(.title|startswith("[QA] PR"))'\`. If one exists, reuse its id (already_existed=true) and skip to verify.
1. Build the tree: invoke global skill **qa-pr** with args \`--yes --seance=${QA_SEANCE}\` (Skill tool).
2. Run checks: invoke global skill **verify-qa-ghost** with args \`<PARENT_ID> --yes\` (Skill tool) — auto-runs shell/http/browser/code_inspection methods, auto-exorcises passing subtasks; never exorcises the parent or requests approval.
Return the parent id, count of auto-passed subtasks, and the human-only remainder.`, { label:'qa', phase:'qa', schema:QA, model:'sonnet', effort:'high' })

  log(`qa: parent ${qa ? qa.qa_parent_id : '?'} — ${qa ? qa.auto_passed : 0} auto-passed, ${qa ? (qa.human_remaining||[]).length : '?'} for human`)
}

// ── Stage 7: human merge gate ───────────────────────────────────────────
phase('handoff')
const handoff = await tryAgent(`${CREDS}

You are the HANDOFF stage of ghost-lane — the human merge gate. Everything passed; PR ${ship.pr_url} is open${qa ? ` with a QA tree (parent ${qa.qa_parent_id})` : ' (QA tree skipped — no QA séance configured; note this so a human runs QA manually)'}.
1. Set pipeline_stage "human_review" and status "purgatory".
2. ${HUMAN_HUNTER ? `Hand off to the human Hunter: POST /api/agent/ghosts/${GHOST_ID}/handoff-hunter {"target_user_id":"${HUMAN_HUNTER}","handoff_notes":"Ready to merge — PR ${ship.pr_url}; QA parent ${qa ? qa.qa_parent_id : 'n/a (skipped)'}"}.` : `No human_hunter_id is configured for this repo (.ghost/config.json) — SKIP handoff-hunter (do not invent a user id); the EVP below is the human surface.`}${NO_BINDING_CIRCLE ? ` Do NOT request approval (unattended mode — the orchestrator exorcises on merge).` : ` Then POST /api/agent/ghosts/${GHOST_ID}/request-approval.`}
3. Post a durable EVP: "Ready for human review + merge. PR: ${ship.pr_url}. QA: ${qa ? `${qa.auto_passed} auto-passed, ${(qa.human_remaining||[]).length} human items` : 'skipped (no QA séance configured) — run /qa-pr manually'}. Merge the PR to complete; exorcise on merge."
4. Restore the main tree: \`git -C "$(git rev-parse --show-toplevel)" checkout ${BASE}\` (the ${BRANCH} branch + PR persist on the remote).
5. Update the run artifact stage to "handoff".
Return handed_off=true and a one-line summary.`, { label:'handoff', phase:'handoff', schema:HANDOFF, model:'sonnet', effort:'high' })

return {
  ghost_id: GHOST_ID,
  ghost_title: setup.ghost_title,
  branch: BRANCH,
  pr_url: ship.pr_url,
  pr_number: ship.pr_number,
  qa_parent_id: qa ? qa.qa_parent_id : null,
  qa_auto_passed: qa ? qa.auto_passed : 0,
  qa_human_remaining: qa ? qa.human_remaining : [],
  verdict: 'handed-to-human',
  handed_off: handoff ? handoff.handed_off : false,
}
