  for (const it of items) {
    if (!it || !it.title) continue;
    const content = String(it.content == null ? '' : it.content).replace(/\s+/g, ' ').trim();
    const cut = content.length > RECALL_CONTENT_MAX ? content.slice(0, RECALL_CONTENT_MAX) + '…' : content;
    const learned = it.source_task_title ? String(it.source_task_title).slice(0, 120) : '—';
    // FULL imprint id: an 8-char prefix is not fetchable, so an implementer that wants the whole
    // record (or to supersede it) cannot act on what it was shown.
    lines.push(`- [${it.memory_type || '?'} · ${it.scope || '?'}] ${String(it.title).slice(0, 200)} — ${cut} (imprint ${String(it.id || '?')}; learned on: ${learned})`);
  }
  if (!lines.length) return '';
  const header = 'RECALLED IMPRINTS (what this Coven already learned — honor these; a gotcha here changes how you build):';
  const kept = [];
  let size = header.length;
  for (const l of lines) {
    if (size + 1 + l.length > RECALL_BLOCK_MAX) break;
    kept.push(l);
    size += 1 + l.length;
  }
  if (!kept.length) return '';
  const dropped = lines.length - kept.length;
  return header + '\n' + kept.join('\n') + (dropped ? `\n(${dropped} further imprint(s) omitted for length — recall again with a narrower query)` : '');
};
// Path classes for the harden verdict. Test files are in range by definition (harden's fixer must
// add a regression test per finding). Doc files identify a DOC finding whose fix must never touch
// runtime code (a real incident: a doc-only finding "fixed" with a production dispatch).
//
// THE EXEMPTION AND THE PATTERN MUST AGREE. harden's fixer is REQUIRED to add a regression test
// per finding and told "a new regression test file is in range by definition" — with no pattern
// given, leaving "test file" to the agent's judgement while the caller judged it by this regex.
// Anything an honest agent calls a test that this missed escalated a backend wave even when the
// fixer reported out_of_range:false correctly. So: conftest.py, __mocks__/, __snapshots__/,
// spec/, e2e/, cypress/ and *.cy.* now count, and TEST_PATH_SOURCE is handed to harden so both
// sides share ONE definition instead of a regex and a guess.
//
// Deliberately still NOT exempt — runner CONFIG and global setup files (vitest.config.ts,
// playwright.config.ts, vitest.setup.ts, setupTests.ts). They are not where a regression test
// goes; they change how EVERY test in the suite runs, and a fix that quietly loosens the global
// setup is exactly the kind of edit that should reach a human instead of riding along.
const TEST_PATH_SOURCE = String.raw`(^|\/)(tests?|__tests__|__mocks__|__snapshots__|spec|e2e|cypress)\/|\.(test|spec)\.[cm]?[jt]sx?$|\.cy\.[cm]?[jt]sx?$|(^|\/)test_[^/]*\.py$|_test\.py$|(^|\/)conftest\.py$`;
const TEST_PATH_RE = new RegExp(TEST_PATH_SOURCE);
const isTestPath = (p) => TEST_PATH_RE.test(String(p || ''));
const isDocPath = (p) => /\.(md|mdx|rst|txt)$|(^|\/)docs?\//.test(String(p || ''));
// The wave's declared ownership set (ghost files ∪ implementer files) — shared by the ownership
// verdict and the harden verdict so both gate against ONE definition of "owned".
const declaredSet = (wave) => {
  const declared = new Set();
  for (const g of (wave && wave.ghosts) || []) for (const f of g.files || []) declared.add(f);
  for (const imp of (wave && wave.implementers) || []) for (const f of imp.files || []) declared.add(f);
  return declared;
};

// ── Pure-JS plan validation (also the ENTIRE dry_run path — spawns no agents) ──
function validatePlan(waves) {
  const issues = [];
  if (!Array.isArray(waves) || !waves.length) {
    issues.push('waves must be a non-empty array (pass the plan inline as args.waves)');
    return issues;
  }
  const hasSpace = (p) => /\s/.test(String(p));
  const names = new Set();
  const ghostToWave = new Map();
  waves.forEach((w, wi) => {
    const wn = (w && w.name) || `#${wi}`;
    if (!w || typeof w !== 'object') {
      issues.push(`wave ${wn}: not an object`);
      return;
    }
    if (!w.name) issues.push(`wave ${wn}: missing name`);
    if (names.has(w.name)) issues.push(`duplicate wave name: ${w.name}`);
    names.add(w.name);
    if (!Array.isArray(w.ghosts) || !w.ghosts.length) issues.push(`wave ${wn}: ghosts must be non-empty`);
    if (!Array.isArray(w.implementers) || !w.implementers.length) issues.push(`wave ${wn}: implementers must be non-empty`);
    if (!Array.isArray(w.gate_cmds) || !w.gate_cmds.length) issues.push(`wave ${wn}: gate_cmds must be non-empty`);
    if (!w.primary_ghost_id) issues.push(`wave ${wn}: primary_ghost_id required`);
    const ghostIds = (w.ghosts || []).map((g) => g && g.id).filter(Boolean);
    if (w.primary_ghost_id && !ghostIds.includes(w.primary_ghost_id)) issues.push(`wave ${wn}: primary_ghost_id not among this wave's ghosts`);
    for (const id of ghostIds) {
      if (ghostToWave.has(id)) issues.push(`ghost ${id} appears in waves ${ghostToWave.get(id)} and ${wn}`);
      else ghostToWave.set(id, wn);
    }
    const declared = [];
    for (const g of w.ghosts || []) for (const f of g.files || []) declared.push(f);
    for (const imp of w.implementers || []) for (const f of imp.files || []) declared.push(f);
    const backendWave = isBackendWave(w);
    for (const p of declared) {
      if (hasSpace(p)) issues.push(`wave ${wn}: declared path contains whitespace: "${p}"`);
      // R2 — migration files are runtime-detected, never declared (env.py/alembic.ini etc.
      // outside versions/ remain declarable backend files).
      if (MIGRATION_DECLARED_RE.test(p))
        issues.push(
          `wave ${wn}: declared migration path "${p}" not allowed — migration files are runtime-detected (revision numbers depend on the live head); ${w.migration ? 'remove the declared path (the runner detects and commits the generated file under the primary ghost)' : 'set migration:true on the wave and remove the declared path'}`,
        );
      // R1 — backend paths demand the backend track (anchored: declared paths are repo-relative).
      else if (BACKEND_RE.test(p) && !backendWave)
        issues.push(`wave ${wn}: declares backend path "${p}" but lacks backend:true (backend work must run on the backend track: scratch DB, drift gate, ownership hard-fail)`);
    }
    // R3 — a migration-producing wave has EXACTLY ONE implementer (concurrent implementers
    // racing the live head is the failure mode this track exists to prevent).
    if (w.migration && (w.implementers || []).length !== 1)
      issues.push(`wave ${wn}: migration:true requires exactly ONE implementer (got ${(w.implementers || []).length})`);
    // R4/R5 — {{db_url}} placeholder discipline.
    const usesDb = (w.gate_cmds || []).some((c) => String(c).includes('{{db_url}}'));
    if (backendWave && !usesDb)
      issues.push(`wave ${wn}: backend wave needs at least one gate_cmd carrying {{db_url}} (the runner-injected scratch-DB URL; without it the tests fall back to the dev DB)`);
    if (!backendWave && usesDb)
      issues.push(`wave ${wn}: {{db_url}} in gate_cmds requires backend:true or migration:true (the placeholder is only injected on the backend track)`);
    const impls = w.implementers || [];
    for (let i = 0; i < impls.length; i++) {
      for (let j = i + 1; j < impls.length; j++) {
        const a = new Set(impls[i].files || []);
        const overlap = (impls[j].files || []).filter((f) => a.has(f));
        if (overlap.length) issues.push(`wave ${wn}: implementers "${impls[i].label}" & "${impls[j].label}" share files: ${overlap.join(', ')}`);
      }
    }
  });
  // R6 — backend plans need a usable DB slug (drives <prefix>_rc<slug>…_test naming).
  if (waves.some(isBackendWave) && !/^rc[A-Za-z0-9_]+$/.test(DB_NS))
    issues.push(`branch "${BRANCH}" yields no usable DB slug for the backend track (need ext/<slug> with [A-Za-z0-9_-] chars)`);
  // R7 — the backend track needs its isolation scripts configured (empty tokens can't provision
  // a scratch DB or run the drift gate). pg_smoke and db_migrate are OPTIONAL (skip-with-log).
  if (waves.some(isBackendWave)) {
    if (!DB_SCRIPT) issues.push('backend/migration wave(s) present but isolation.db_script is not configured (the scratch-Postgres manager: create/url/drop) — required for the backend track');
    if (!MIGRATION_GATE) issues.push('backend/migration wave(s) present but isolation.migration_gate is not configured (the Alembic single-head + drift gate) — required for the backend track');
  }
  if (STOP_BEFORE && !waves.some((w) => w.name === STOP_BEFORE)) issues.push(`stop_before "${STOP_BEFORE}" is not a wave name`);
  if (RESUME_FROM && !waves.some((w) => w.name === RESUME_FROM)) issues.push(`resume_from "${RESUME_FROM}" is not a wave name`);
  return issues;
}

// Capability degradations. Every one of these was previously a LOG LINE ONLY, so a wave that ran
// with no secret scan, no Postgres smoke gate and no reversibility proof returned a result
// byte-identical to one that passed all three. The human reviewing the PR could not tell them
// apart. Recorded per wave in completed[], and run-wide in the final return.
const SKIPPED = [];
const noteSkip = (scope, what) => { SKIPPED.push(`${scope}: ${what}`); };

phase('validate');
if (!COMMIT_SCRIPT) noteSkip('run', 'secret scan (isolation.commit_script unset — commits fall back to plain git add/commit)');
if (!COMMIT_SCRIPT) log('no commit script configured (isolation.commit_script empty) — commits fall back to plain git add/commit with a "Ghost: <id>" trailer; NO secret scan runs');
const issues = validatePlan(WAVES);

if (DRY_RUN) {
  const sequence = WAVES.map((w, i) => {
    const tags = [];
    if (w.migration) tags.push('MIGRATION');
    else if (w.backend) tags.push('backend');
    if (w.name === RESUME_FROM) tags.push('RESUME here');
    if (w.name === STOP_BEFORE) tags.push('STOP before');
    return `${i}: ${w.name} — ${(w.ghosts || []).length} ghost(s), ${(w.implementers || []).length} implementer(s), ${(w.gate_cmds || []).length} gate cmd(s)${tags.length ? '  [' + tags.join(', ') + ']' : ''}`;
  });
  sequence.forEach((s) => log(s));
  // The EXACT strings the recall stage will post, built by the engine's own functions — so a plan
  // author can see what their implementers will be recalled against BEFORE spending a real run,
  // and so verifying a recall fix is a mechanical check instead of a hand-written curl.
  const recall_queries = WAVES.map((w) => {
    const feature = capTerms(recallTerms(w));
    return { wave: w.name, feature: feature.join(' OR '), mechanism: mechanismQuery(w, feature) };
  });
  recall_queries.forEach((r) => log(`recall queries [${r.wave}] feature: ${r.feature || '(none)'} | mechanism: ${r.mechanism || '(none)'}`));
  issues.forEach((s) => log(`ISSUE: ${s}`));
  return { status: issues.length ? 'invalid' : 'validated', issues, sequence, recall_queries, note: 'dry_run: pure-JS plan validation only. Live git/branch/clean/DB checks run at real setup.' };
}

if (issues.length) throw new Error('rite-cadence plan INVALID:\n - ' + issues.join('\n - '));

// ── Shared preamble builders ──
// Talisman only where a stage calls the Ghost Hunting API (claim / exorcise / escalation EVP).
// ROOTREF = WT. The X-Ghost-Client header (GH_CLIENT) rides on every curl.
// COVEN BINDING (auth.prod.org_id). Same lookup order as PHASE0.md and runtime/project.mjs: the
// worktree's env file first, then — ONLY when the config names org_id — the per-user
// GHOST_HUNTING_API_KEY__<ORG8> line that /ghost-onboard writes, so a bound repo's worktrees need
// no per-worktree key copy. A repo without org_id renders exactly the preamble it always had.
const ORG_ID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i.test('__CFG_org_id__') ? '__CFG_org_id__'.toLowerCase() : '';
const USER_KEY_VAR = ORG_ID ? `GHOST_HUNTING_API_KEY__${ORG_ID.slice(0, 8).toUpperCase()}` : '';
const USER_KEY_FILE = '~/.config/ghost-hunting/.env';
const USER_KEY_FALLBACK = ORG_ID
  ? `; [ -z "$TALISMAN" ] && TALISMAN=$(awk -F= '/^${USER_KEY_VAR}=/{sub(/^[^=]*=/, ""); print}' "\${XDG_CONFIG_HOME:-$HOME/.config}/ghost-hunting/.env" | tr -d '"'"'"'[:space:]')`
  : '';
const CREDS = `Ghost Hunting auth: REPO_ROOT="${WT}"; TALISMAN=$(awk -F= '/^__CFG_key_var__=/{print $2}' "$REPO_ROOT/__CFG_env_file__" | tr -d '"'"'"'[:space:]')${USER_KEY_FALLBACK}; AUTH="Authorization: Bearer $TALISMAN"; API="${API}"
Client header (pass -H "$GH_CLIENT" on EVERY curl): GH_CLIENT="X-Ghost-Client: plugin/__CFG_plugin_version__ repo/__CFG_repo__ wf/$(jq -r '.bundle // empty' "$REPO_ROOT/.ghost/sync-state.json" 2>/dev/null)"
GH gotchas: EVP field is "content" (not body); PUT /status is a separate endpoint; list endpoints return {items:[...]}.`;

// The remediation a human (or a recovery agent) reads when the talisman is rejected. It names the
// engine's OWN path and variable — the rendered literals above, not a script — because the fix is
// to put a working key where this engine looks, and any repo's provisioning script may differ.
// IT MUST NAME WHAT NOT TO RUN. An earlier draft said "scripts/ghost-wt.sh writes every declared
// path", and that script's `provision` subcommand is reap-first: it rm -rf's the worktree and
// force-deletes the ext/ branch. A recovery agent following that instruction destroys every
// committed wave and every parked patch on the branch it was sent to rescue.
const CRED_CHAIN = ORG_ID
  ? `The engine reads __CFG_key_var__ from "${WT}/__CFG_env_file__" — auth.prod.env_files[0] of .ghost/config.json, resolved against the WORKTREE — then ${USER_KEY_VAR} from ${USER_KEY_FILE} (this repo is bound to Coven ${ORG_ID} by auth.prod.org_id), with NO fallback to the main checkout or ~/.claude/.env.`
  : `The engine reads __CFG_key_var__ from "${WT}/__CFG_env_file__" — auth.prod.env_files[0] of .ghost/config.json, resolved against the WORKTREE, with NO fallback to the main checkout or ~/.claude/.env.`;
const CRED_FIX = ORG_ID
  ? `FIX WITHOUT DESTROYING ANYTHING: sign this computer in to that Coven (type /ghost-onboard, or run ghost-kit login in a terminal) — it writes ${USER_KEY_VAR} to ${USER_KEY_FILE} — and delete any stale __CFG_key_var__= line in the worktree's __CFG_env_file__ that shadows it.`
  : `FIX WITHOUT DESTROYING ANYTHING: create the parent directory and copy the __CFG_key_var__= line from the MAIN checkout's __CFG_env_file__ to that exact path.`;
const credentialMessage = (wave, code) =>
  `talisman REJECTED (GET /api/agent/me → HTTP ${code}). ${CRED_CHAIN} Either that file is absent in this worktree or its key is not valid for ${API}. ${CRED_FIX} Do NOT re-run the worktree provisioning script's \`provision\` subcommand — it reaps the worktree and force-deletes ${BRANCH}, including every commit and parked patch on it. Then re-invoke with resume_from "${wave.name}". Nothing was claimed, built or committed.`;
// The key authenticates (200) but belongs to another Coven: every tracker call would land in the
// wrong organization, or 404. Only checkable when the config names org_id.
const wrongCovenMessage = (wave, meOrg) =>
  `talisman is for the WRONG COVEN (GET /api/agent/me → 200, org_id ${meOrg}; this repo is bound to ${ORG_ID} by auth.prod.org_id). ${CRED_CHAIN} ${CRED_FIX} Do NOT re-run the worktree provisioning script's \`provision\` subcommand — it reaps the worktree and force-deletes ${BRANCH}, including every commit and parked patch on it. Then re-invoke with resume_from "${wave.name}". Nothing was claimed, built or committed.`;

// Script discipline (backend plans only): the repo's isolation scripts self-locate to the
// checkout they live in — invoke them by absolute worktree path, never a bare/main-tree path.
const SCRIPT_DISCIPLINE = anyBackend
  ? `\nScript discipline: the repo's isolation scripts (scratch-DB manager, migration CLI, migration gate, pg-smoke, test runner) SELF-LOCATE to the checkout they live in — ALWAYS invoke them by absolute worktree path ("${WT}/<script>"), never a bare or main-tree path (a bare path runs MAIN's copy against MAIN's migration head).`
  : '';

const common = (wave, role) => `You are the ${role} stage of the rite-cadence workflow, wave "${wave.name}".
WORKING TREE: ${WT} (branch ${BRANCH}, an ext/* worktree — NEVER touch the main tree).${CONTRACT ? `\nBINDING CONTRACT: ${CONTRACT} — read the sections relevant to this wave first.` : ''}${SCRIPT_DISCIPLINE}
Honor the repo's documented invariants (CLAUDE.md and the docs it points to — write/event discipline, tenancy scoping, determinism rules) where they apply. Do EXACTLY your stage; stay strictly in scope.`;

// Baseline-red context block for gate/harden prompts (empty list → empty string).
// The gate agent must be TOLD which of its gates were already red at the base. Without this the
// prompt's own rule ("a nonzero gate with no test ids is a real blocker and must stop the wave")
// makes an obedient agent return green:false, and the engine's excusal below is never reached —
// the feature would depend on the agent disobeying its instructions.
const inheritedGateBlock = (wave) => {
  const idx = (wave.gate_cmds || []).map((c, i) => (BASELINE_RED_GATES.includes(String(c)) ? i : -1)).filter((i) => i >= 0);
  return idx.length
    ? `\nINHERITED-RED GATE(S) — ${idx.map((i) => `gate[${i}]`).join(', ')} already exited nonzero with NO test ids on the untouched base, BEFORE this wave existed. Run each one anyway and report its literal exit code, but do NOT try to fix it, do NOT edit files to satisfy it, and do NOT count it against \`green\`: the engine excuses it. If one of them starts NAMING failing test ids, that IS new and you must report the ids.`
    : '';
};
const baselineBlock = () =>
  BASELINE_RED.length
    ? `\nBASELINE-RED (pre-existing failures on the untouched base — inherited, NOT caused by this wave): ${JSON.stringify(BASELINE_RED)}. A red test in this list is NOT a blocker and must NOT be "fixed" here; only a test NOT in this list that fails blocks.`
    : '';

// Does a gate's REPORTED failure set consist ENTIRELY of inherited baseline-red tests?
//
// Fix C taught the engine to trust observed exit codes over the agent's `green`. v1.6.1 then
// widened that check from the engine-appended gates alone -- pg-smoke and migration-gate, schema
// and smoke checks that can never hold a test id -- to every gate index, which is where the
// PLAN's own suites and linters live. That is exactly where baseline-red lives too, so the
// engine began refusing the very reds the baseline stage exists to excuse while still logging
// "will NOT block gates". The result was a constructed deadlock: the gate prompt FORBIDS fixing
// a baseline red, and the engine then DEMANDED exit 0 from the gate containing it, so a repo
// with one inherited red could never finish a backend wave.
//
// An exit code cannot name tests, so attribution has to come from the agent -- but as a FACT
// (which ids failed), never as a judgment. This is strictly STRONGER than the boolean it backs
// up: the engine stops taking green:true on faith without starting to take exit 1 on faith
// either. A gate that cannot name baseline ids still blocks unconditionally, and so does an
// agent that omits the field -- the pre-fix behavior is the degraded mode, which is the right
// direction to fail.
//
// ID ROOTING IS NOT KNOWABLE FROM THE PLAN. One consumer's baseline recorded
// "tests/test_x.py::test_y" while the file is "backend/tests/test_x.py" repo-relative. The cause
// was NOT the gate command's cd -- that one starts at the worktree root -- it was the repo's own
// test script doing `cd backend` internally, making pytest's rootdir backend/. The engine cannot
// see that from the gate_cmds it was handed. Hence a path-BOUNDARY suffix match, in BOTH
// directions, since nothing forces the baseline and the gate through the same command; and no
// "::" assumption, since a vitest id is "file > name" and shares no syntax with a pytest nodeid.
const baselineExcuses = (failures, red) => {
  const norm = (s) => String(s == null ? '' : s).trim().replace(/^\.\//, '');
  const reds = (Array.isArray(red) ? red : []).map(norm).filter(Boolean);
  const got = (Array.isArray(failures) ? failures : []).map(norm).filter(Boolean);
  if (!reds.length || !got.length) return false;
  // EVERY reported failure must be inherited. One unrecognised id fails the whole gate: a wave
  // regression sitting beside two known reds must never ride in on their excuse.
  return got.every((f) => reds.some((r) => f === r || f.endsWith('/' + r) || r.endsWith('/' + f)));
};

// ── Schemas ──
const SETUP = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, pre_wave_sha: { type: 'string' }, branch: { type: 'string' }, epoch: { type: 'integer' }, reason: { type: 'string' } }, required: ['ok'] };
const RESUME_GUARD = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, missing_ghosts: { type: 'array', items: { type: 'string' } }, reason: { type: 'string' } }, required: ['ok'] };
// Failure taxonomy (Fix D): a caller MUST be able to branch on WHY provisioning failed without
// regexing English out of a prose field. `reason` stays human-facing (last 2000 chars of stderr);
// `failure_code` is the machine path and rides into the escalation sentinel.
const FAILURE_CODE = { enum: ['create_failed', 'drop_failed', 'url_failed', 'db_url_name_mismatch', 'migrate_failed', 'db_unreachable', 'head_unparseable', 'suite_could_not_run', 'stale_worktree_gate_script', 'engine_internal'] };
const BASELINE = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, red_tests: { type: 'array', items: { type: 'string' } }, notes: { type: 'string' }, failure_code: FAILURE_CODE, failed_step: { type: 'integer' } }, required: ['ok', 'red_tests', 'notes'] };
// The gate probe reports FACTS ONLY — the exit code of each plan gate run on the untouched tree,
// and any test ids it named. Which of those count as "inherited red" is the ENGINE's call (see
// BASELINE_RED_GATES below), exactly as Fix C made gate_exits facts and `green` a mere verdict.
// Asking the agent to classify would hand it the excusal decision the whole gate stage exists to
// keep away from agents.
const GATE_PROBE = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, exits: { type: 'array', items: { type: 'object', additionalProperties: false, properties: { index: { type: 'integer' }, exit_code: { type: 'integer' }, failures: { type: 'array', items: { type: 'string' } } }, required: ['index', 'exit_code'] } }, notes: { type: 'string' }, failure_code: FAILURE_CODE }, required: ['ok', 'exits'] };
const DB_RESOLVE = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, db_url: { type: 'string' }, reason: { type: 'string' }, failure_code: FAILURE_CODE }, required: ['ok'] };
const PROVISION_DB = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, pre_head: { type: 'string' }, reason: { type: 'string' }, failure_code: FAILURE_CODE, failed_step: { type: 'integer' }, pg_smoke_scratch_ok: { type: 'boolean' }, pg_smoke_present: { type: 'boolean' } }, required: ['ok', 'pre_head'].concat(PG_SMOKE ? ['pg_smoke_scratch_ok', 'pg_smoke_present'] : []) };
const BUILD = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, changed_files: { type: 'array', items: { type: 'string' } }, note: { type: 'string' }, learnings: { type: 'array', items: { type: 'string' }, maxItems: 3 } }, required: ['ok'] };
// Recall: source_task_title is nullable server-side; the recall agent's jq maps null → "" so the
// schema stays plain strings (a null against type:string fails the whole structured output).
const RECALL_ITEM = { type: 'object', additionalProperties: false, properties: { id: { type: 'string' }, memory_type: { type: 'string' }, scope: { type: 'string' }, title: { type: 'string' }, content: { type: 'string' }, source_task_title: { type: 'string' } }, required: ['id', 'title'] };
const RECALL_RESULT = { type: 'object', additionalProperties: false, properties: { recall_status: { type: 'string', enum: ['ok', 'empty', 'failed'] }, recall_error: { type: 'string' }, recalled_feature: { type: 'array', items: RECALL_ITEM }, recalled_mechanism: { type: 'array', items: RECALL_ITEM } }, required: ['recall_status'] };
const WRITEBACK = { type: 'object', additionalProperties: false, properties: { status: { type: 'string', enum: ['written', 'replayed', 'skipped', 'failed'] }, memory_ids: { type: 'array', items: { type: 'string' } }, reason: { type: 'string' } }, required: ['status'] };
const REALIZED = { type: 'object', additionalProperties: false, properties: { paths: { type: 'array', items: { type: 'string' } } }, required: ['paths'] };
// Fix C: `green` is the agent's VERDICT; gate_exits are OBSERVED FACTS. The engine trusts the
// facts. A gate that refused to run (nonzero exit) must never read as a gate that passed —
// pg-smoke exited 4 on every backend wave in one consumer repo while this stage kept returning green.
// `failures` is optional by design: required-everywhere would force noise onto every exit-0
// entry, and an agent that omits it on a nonzero gate must fall back to the pre-1.7.3 behavior
// (blocked), never to an excuse. See baselineExcuses().
const GATE_RESULT = { type: 'object', additionalProperties: false, properties: { green: { type: 'boolean' }, notes: { type: 'string' }, changed_files: { type: 'array', items: { type: 'string' } }, gate_exits: { type: 'array', items: { type: 'object', additionalProperties: false, properties: { index: { type: 'integer' }, exit_code: { type: 'integer' }, failures: { type: 'array', items: { type: 'string' } } }, required: ['index', 'exit_code'] } } }, required: ['green', 'gate_exits'] };
const COMMIT_RESULT = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, shas: { type: 'array', items: { type: 'object', additionalProperties: false, properties: { ghost: { type: 'string' }, sha: { type: 'string' } }, required: ['ghost', 'sha'] } }, clean: { type: 'boolean' }, reason: { type: 'string' } }, required: ['ok'] };
const RECONCILE = { type: 'object', additionalProperties: false, properties: { clean: { type: 'boolean' }, swept: { type: 'array', items: { type: 'string' } }, flagged: { type: 'array', items: { type: 'string' } }, reason: { type: 'string' } }, required: ['clean'] };
const REVERSIBILITY = { type: 'object', additionalProperties: false, properties: { ok: { type: 'boolean' }, skipped: { type: 'boolean' }, migrations: { type: 'array', items: { type: 'string' } }, reason: { type: 'string' } }, required: ['ok'] };
const EXORCISE = { type: 'object', additionalProperties: false, properties: { exorcised: { type: 'array', items: { type: 'string' } }, failures: { type: 'array', items: { type: 'object', additionalProperties: false, properties: { ghost: { type: 'string' }, error: { type: 'string' } }, required: ['ghost', 'error'] } } }, required: ['exorcised'] };
const DONE = { type: 'object', additionalProperties: false, properties: { done: { type: 'boolean' }, notes: { type: 'string' } }, required: ['done'] };

// Baseline-red: established once per invocation (or handed back via args.baseline_red on
// resume — re-deriving on a partially-built tree would launder a slipped prior-wave regression
// into the inherited set, and costs a full suite run per resume).
let BASELINE_RED = Array.isArray(A.baseline_red) ? A.baseline_red.map(String) : [];
// Was a baseline ACTUALLY taken? `baseline_red: []` used to mean two opposite things -- "ran,
// found nothing" on a backend invocation and "never ran" on a pure-frontend one -- with the same
// bytes in the result, the ledger and every escalation payload. That ambiguity got dangerous in
// v1.7.3, which made BASELINE_RED decide whether a nonzero gate can be excused: on an unmeasured
// invocation nothing can EVER be excused, and until now nothing said so. A caller handing back
// args.baseline_red is replaying a measurement that really happened, so that counts as measured.
let BASELINE_MEASURED = Array.isArray(A.baseline_red);
// Inherited-red GATES: plan gate commands (RAW, {{db_url}} unsubstituted) that already exited
// nonzero on the untouched base WITHOUT naming a single test id — a repo-wide linter, a script
// that refuses to run. These are deliberately a SEPARATE arg and a SEPARATE measured flag rather
// than a widening of baseline_red: `baseline_red: []` both skips the test baseline and asserts a
// measurement happened (BASELINE_MEASURED above), so folding gates into it would make a caller
// replaying test ids silently claim a gate probe it never ran. A caller handing back
// args.baseline_red_gates is replaying a probe that really happened, so that counts as measured.
let BASELINE_RED_GATES = (Array.isArray(A.baseline_red_gates) ? A.baseline_red_gates.map(String) : []).filter((c) => !isTestSuiteCmd(c));
let BASELINE_GATES_MEASURED = Array.isArray(A.baseline_red_gates);
// Which RAW gate commands actually got an exit code reported at the base. NOT the same as
// BASELINE_RED_GATES: a gate can be probed and green. Without this, an `exits` list that is
// missing an index would let the gate stage tell an operator the gate "was GREEN on the
// untouched base" when it was never run there — a false attribution written into an escalation.
let BASELINE_PROBED_GATES = [];
// The subset that the probe found GREEN. Only these may be described to a human as "green at the
// base": a gate that reported 143 there was reached, but it never ran.
let BASELINE_GREEN_GATES = [];
// A NONZERO EXIT IS NOT AUTOMATICALLY A GATE VERDICT. 127 (command not found), 126 (not
// executable) and 124 (watchdog/timeout kill) mean the gate NEVER RAN. Those are also silent
// about test ids, so the plain "nonzero and named nothing" rule would file a whole test suite as
// inherited-red the moment node_modules was missing or the suite outran its watchdog — and then
// excuse the identical failure after the build, shipping a wave whose tests never executed.
// That is strictly worse than the escalation this stage exists to remove, so these never excuse.
const NEVER_INHERITED_EXITS = [124, 126, 127];
// POSITIVE, not a blacklist: only a code that represents a command which actually RAN and
// reported a verdict can ever be inherited-red.
//   code > 0    — refuses 0 (green) and refuses -1, the value harden's own gate prompt sanctions
//                 for "a gate you did not run"; a budget-capped agent told a gate is excused will
//                 rationally skip it and report -1, which is the common path, not an edge.
//   code < 128  — refuses 128+N signal deaths. A sibling lane's `pkill -f pytest` yields 143, and
//                 this repo has already lost two suite runs to exactly that in one day.
//   not 124/126/127 — watchdog kill, not-executable, command-not-found.
const ranAndReported = (code) =>
  Number.isInteger(code) && code > 0 && code < 128 && !NEVER_INHERITED_EXITS.includes(code);
const couldBeInheritedRed = (code, failures) => ranAndReported(code) && !((failures || []).length);
const createdDbs = [];
// Per-wave results. Declared UP HERE, beside createdDbs, because escalate() carries it in every
// payload and the baseline / resume-guard escalations fire BEFORE the wave loop — a declaration
// next to the loop would be a temporal-dead-zone ReferenceError on exactly those paths.
const completed = [];
// ── Wave-scoped memory state (hoisted so escalate() can reach it) ────────────────────────────
// The current wave's implementer learnings (BUILD.learnings). An escalated wave is the attempt
// with the most to teach, so these must reach the Coven's memory — not merely the return value.
// Until 1.6.1 they rode the payload ONLY: writeback sits at the end of the wave and every one of
// the ~20 escalation sites returns before it, so a human read the payload and hand-wrote the
// Imprints. Twice, on 2026-09-05. escalate() now writes them itself — see writebackImprints().
let WAVE_LEARNINGS = [];
// Non-fatal things a human must still see about THIS wave — today: a gate excused because it was
// already red at the base. They ride completed[].warnings, the run's warnings[], the ledger and
// the completion EVP, because a wave that only passed on an excusal is not the same artefact as
// one that passed outright.
let WAVE_WARNINGS = [];
let WAVE_INHERITED_RED_GATES = [];
const LEARNING_MAX = 1200;
// The Hauntings this wave touches, from the claim stage. Hoisted because RECALL_PROJECTS is
// loop-scoped and escalate() is declared above the loop; the writeback needs it for scope.
let WAVE_PROJECTS = [];
// "The ghost's own build is committed, gate-green, reconciled, and (migration waves) roundtrip
// proven." The gate for writing memory from a FAILED wave, and the reason it is safe: past this
// line only harden's FIX SET is unproven. The implementer learnings are environment facts and the
// confirmed findings are refuter-verified defects in code that is ALREADY COMMITTED — neither
// depends on the fix landing. Before this line we deliberately do NOT write: a build that failed
// its own gate is exactly where a "learning" may be the misconception that failed it.
let WAVE_BUILD_PROVEN = false;
// The current wave's index — the writeback's /tmp filenames need it, and escalate() cannot see
// the loop variable.
let WAVE_INDEX = 0;
// What the wave RECALLED: {status, imprint_ids}. Until 1.6.1 the recall outcome existed only as a
// live log line, so no returned result could answer "was this wave built with the Coven's memory
// or without it?" — the single most important question about a run of a memory-loop engine.
let WAVE_RECALL = { status: 'not-attempted', imprint_ids: [] };
// What this wave has actually COMMITTED, and what harden deferred. Hoisted for the same reason as
// everything above it: escalate() needs them at ~26 call sites, and a rule that every call site
// must remember is a rule that is already broken somewhere. It was — the reconcile escalations
// passed no committed_shas, so the release stage below would have sent ghosts with real commits in
// git back to `ether`, which is exactly what its own comment says must never happen.
let WAVE_CLAIMED = [];
let WAVE_COMMITS = [];
let WAVE_DEFERRED = [];

// Harness-death containment (tryAgent pattern): an agent that dies without structured output —
// or any thrown tool-layer error — must degrade to NULL so the stage's null-check routes to
// escalate (worktree + scratch DBs preserved, resumable payload), never to a workflow-killing
// throw. Every call site below already treats null as failure.
// RUN-LEVEL AGENT ACCOUNTING. Every spawn in this engine goes through tryAgent — it holds the only
// `agent(` call in the template — so counting here is complete and free. It exists because the
// death rate was previously knowable only by reading task notifications by hand: three runs on
// 2026-09-07 lost 1, then 8, then 11 agents and nothing in any result payload said so, which made
// "is the engine getting more or less reliable" an argument from memory rather than a number.
// Child-workflow agents (harden's own fan-out) do NOT pass through here; harden reports its own.
const AGENT_STATS = { spawned: 0, died: [] };
const tryAgent = (prompt, opts) => {
  AGENT_STATS.spawned += 1;
  return agent(prompt, opts).catch((e) => {
    const label = (opts && opts.label) || '?';
    // Keep the thrown message on the record too, not just in a transient log line — a stall names
    // itself ("agent stalled on all N attempts …"), so the ledger's engine_died can say WHY an
    // engine stage died, the same way harden now records its fix/gate death reasons.
    const reason = String((e && e.message) || e || '').slice(0, 200);
    AGENT_STATS.died.push({ label, phase: (opts && opts.phase) || '?', reason });
    log(`agent died (${label}): ${reason.slice(0, 160)}`);
    return null;
  });
};

// ── The run ledger: make convergence a query instead of an anecdote ──────────────────────────
// escalate() already assembles everything a reader needs — phase, failure_code, learnings, recall,
// what committed, what parked — and then throws it into an EVP as prose and a result payload that
// dies with the session. So "is this engine converging or treadmilling?" was argued from a human's
// memory of a session, in a product whose whole thesis is that memory should not live in one.
//
// WHERE: <git-common-dir>/rite-cadence-ledger/<slug>.<epoch>.json — the same place parked patches
// live, chosen for the same reason: a worktree reap removes .haunt-wt/<slug> and the ext/ branch,
// never .git/. One file per run, never appended, so two rites on one machine cannot interleave and
// a human's verdict can never be clobbered by a later run. `jq -s . dir/*.json` gives the JSONL view.
// It must work when the talisman is DEAD — that is the one escalation the tracker cannot record —
// so this is bash and a file, not an Imprint or a Tolling.
//
// NO CLOCK: Date.now()/new Date() are forbidden in this sandbox (CI gate), so every timestamp is
// agent-observed via `date +%s`. NO TOKENS: nothing in the sandbox reliably exposes them; agents
// {spawned, died} is the cost proxy and is honest about being one.
//
//   jq -r 'select(.human_verdict == null) | "\(.recorded_at) \(.outcome) \(.wave // "-") \(.phase // "-") \(.failure_code // "-")"' <dir>/*.json
//   jq -s 'group_by(.phase)[] | {phase: .[0].phase, n: length}' <dir>/*.json
//   jq -s '[.[] | .outcome] | group_by(.) | map({outcome: .[0], n: length})' <dir>/*.json
const LEDGER_DIR = 'rite-cadence-ledger';
let FIRST_SETUP_EPOCH = null;
const ledgerRecord = (outcome, extra) => ({
  ledger_schema: 1,
  // Replaced by the agent with an observed `date +%s`; the engine has no clock.
  recorded_at: '__RECORDED_AT__',
  engine: 'rite-cadence',
  plugin_version: '__CFG_plugin_version__',
  repo: '__CFG_repo__',
  run: { slug: SLUG, branch: BRANCH, worktree: WT, rite_id: RITE_ID || null, resume_from: RESUME_FROM || null, stop_before: STOP_BEFORE || null },
  outcome,
  wave: extra.wave || null,
  phase: extra.phase || null,
  failure_code: extra.failure_code || null,
  reason: String(extra.reason || '').slice(0, 600) || null,
  waves: (extra.completed || []).map((c) => ({
    wave: c.wave,
    ghosts: (c.ghost_shas || []).length,
    hardened_green: !!c.hardened_green,
    exorcise_status: c.exorcise_status || null,
    imprints_status: (c.imprints || {}).status || null,
    imprints_written: Array.isArray((c.imprints || {}).memory_ids) ? (c.imprints || {}).memory_ids.length : null,
    // The read half, per axis. WAVE_RECALL.by_query was built to settle whether the mechanism
    // axis earns its call; until now it reached completed[] and the escalation payload but never
    // the durable record, so the question died with the session. Additive; ledger_schema stays 1.
    // imprints_written counts memory_ids as returned: on a REPLAYED wave those are the earlier
    // attempt's ids (read it beside imprints_status); null when the writeback never ran.
    recall: { status: (c.recall || {}).status || null, feature: Array.isArray(((c.recall || {}).by_query || {}).feature) ? ((c.recall || {}).by_query || {}).feature.length : null, mechanism: Array.isArray(((c.recall || {}).by_query || {}).mechanism) ? ((c.recall || {}).by_query || {}).mechanism.length : null, imprint_ids: (c.recall || {}).imprint_ids || [] },
    harden_verify_stats: c.harden_verify_stats || null,
    // Which plan gates this wave passed only because the probe found them red at the base. The
    // durable record of an excusal — the operator question it answers is "was this wave really
    // gated, or did we wave a dead linter through?"
    inherited_red_gates: c.inherited_red_gates || [],
    warnings: c.warnings || [],
    skipped_capabilities: c.skipped_capabilities || [],
  })),
  agents: { engine_spawned: AGENT_STATS.spawned, engine_died: AGENT_STATS.died.slice() },
  timing: { started_at: FIRST_SETUP_EPOCH },
  skipped_capabilities: SKIPPED.slice(),
  // THE ONE FIELD THE ENGINE MUST NOT FILL. "Was this escalation correct, or an engine defect?"
  // cannot be honestly self-assessed by the run that failed — every escalation believes it is
  // correct. A human fills this in later with an in-place jq edit; the engine never rewrites a
  // file (the epoch is in the name), so a verdict can never be overwritten. null = unreviewed.
  // Vocabulary when filled: correct | engine_defect | environment | unknown.
  human_verdict: null,
  human_note: null,
});
async function recordLedger(outcome, extra) {
  const body = JSON.stringify(ledgerRecord(outcome, extra), null, 2);
  const res = await tryAgent(
    `${common({ name: extra.wave || SLUG }, 'ledger')}
Write this run's ledger entry. It is a FILE and some bash — no API, no git mutation, nothing that
can fail the run. Do it even if the talisman is dead; especially then.
0. LEDGER=$(git -C ${WT} rev-parse --path-format=absolute --git-common-dir)/${LEDGER_DIR}
   If that resolves empty or relative, STOP: return {written:false, reason:"could not resolve the git common dir"}.
   It is inside the MAIN checkout's .git, which no worktree reap and no git clean ever touches.
1. mkdir -p "$LEDGER"
2. Write the body below to /tmp/ledger.${SLUG}.json with a QUOTED heredoc so nothing is expanded:
cat > /tmp/ledger.${SLUG}.json <<'JSON'
${body}
JSON
3. T=$(date +%s) — the engine has no clock, this is the only timestamp.
   sed 's/"__RECORDED_AT__"/'"$T"'/' /tmp/ledger.${SLUG}.json > "$LEDGER/${SLUG}.$T.json"
4. Prove it is valid and non-empty: jq -e . "$LEDGER/${SLUG}.$T.json" >/dev/null; report that exit code.
Return {written, path:"$LEDGER/${SLUG}.$T.json", bytes:$(wc -c < "$LEDGER/${SLUG}.$T.json"), jq_exit, epoch:$T}.`,
    { label: `ledger:${extra.wave || SLUG}`, phase: extra.phase || 'ledger', model: pin('sonnet'), schema: { type: 'object', additionalProperties: false, properties: { written: { type: 'boolean' }, path: { type: 'string' }, bytes: { type: 'integer' }, jq_exit: { type: 'integer' }, epoch: { type: 'integer' }, reason: { type: 'string' } }, required: ['written'] } },
  );
  // FACTS OVER THE VERDICT, the same rule the park and gate stages apply to their own agents: a
  // `written: true` beside 0 bytes or a nonzero jq exit is not a written ledger.
  const ok = !!(res && res.written && res.path && res.bytes > 0 && res.jq_exit === 0);
  if (ok) log(`ledger: ${outcome} recorded at ${res.path}`);
  else log(`ledger NOT written (${outcome}): ${(res && (res.reason || `written=${res.written} bytes=${res.bytes} jq=${res.jq_exit}`)) || 'agent died'} — this run leaves no durable record`);
  return ok ? { written: true, path: res.path } : { written: false, reason: (res && res.reason) || 'agent died or reported an unusable file' };
}

// ── Writeback: distil what this wave taught into Imprints ────────────────────────────────────
// Extracted from the wave loop so BOTH terminal paths can reach it: the green path (as before)
// and escalate() (new in 1.6.1). Candidates are harden's confirmed-and-fixed findings + the
// implementers' learnings. Refuted findings are NEVER passed ("deliberate per contract" is a
// decision, which this product routes to an Augury, never an Imprint). BEST-EFFORT throughout: a
// dead or failed writeback is logged and the caller proceeds.
//
// CANDIDATE CAPS ARE BY ELEMENT, NEVER BY SLICING THE SERIALIZED JSON. The old code did
// `JSON.stringify(...).slice(0, 3000)`, which cuts mid-token: on the 2026-09-05 hierarchy-service
// wave (19 confirmed findings) the writeback agent was handed syntactically broken JSON and the
// tail findings were invisible. Cap the array, then serialize, and say what was dropped.
const WB_MAX_FINDINGS = 12;
const WB_MAX_RESOLUTIONS = 12;
async function writebackImprints(wave, ctx) {
  const confirmed = Array.isArray(ctx.confirmed) ? ctx.confirmed : [];
  const resolutions = Array.isArray(ctx.fix_resolutions) ? ctx.fix_resolutions : [];
  const learnings = Array.isArray(ctx.learnings) ? ctx.learnings : [];
  if (!confirmed.length && !learnings.length) return { status: 'skipped', memory_ids: [], reason: 'nothing to write back: harden confirmed nothing and no implementer reported a learning' };

  const wi = ctx.wi;
  // CONTENT-ADDRESSED, because neither the commit sha nor pre_wave_sha answers the question the
  // key is actually asking. The key exists for ONE reason: a curl retry inside a single writeback
  // must not double-write. Cross-attempt de-duplication is the recall-and-supersede idiom's job.
  //   * commit sha  — a resume whose commit legitimately no-ops ("(none)") fell back to another
  //                   source and minted a second key: duplicate Imprints.
  //   * pre_wave_sha — worse in both directions. On a resume the wave's commits are already in
  //                   HEAD, so setup reports a DIFFERENT pre_wave_sha and it duplicates anyway;
  //                   and on the reset-and-re-run this engine's own EVP recommends, the sha is
  //                   identical, so attempt 2 REPLAYS and its learnings are silently dropped.
  // Hashing the candidates gets both right by construction: identical content is a true retry and
  // replays; different content is a different lesson and records. djb2 over a stable projection —
  // no crypto in this sandbox, and collision risk here is a duplicate write, not corruption.
  const wbFingerprint = JSON.stringify({
    g: wave.primary_ghost_id,
    f: confirmed.map((f) => `${f && f.title}|${f && f.file}`).sort(),
    l: learnings.slice().sort(),
    d: (ctx.deferred || []).map((d) => d && d.finding).sort(),
    // The escalated and green prompts are materially different — one says "the fix set is NOT
    // committed, never describe a fix as shipped". Without this, an escalated write and the later
    // green write of the same wave collide, the server replays, and the corpus keeps ONLY the
    // escalation-flavoured lesson forever (the receipt is permanent).
    e: !!ctx.escalation,
  });
  let wbHash = 5381;
  for (let i = 0; i < wbFingerprint.length; i++) wbHash = ((wbHash * 33) ^ wbFingerprint.charCodeAt(i)) >>> 0;
  const wbKey = `writeback:rite:${String(wave.primary_ghost_id).slice(0, 8)}:${wbHash.toString(16).padStart(8, '0')}`;
  const projects = Array.isArray(ctx.projects) ? ctx.projects : [];
  const scopeRule = projects.length === 1
    ? `every item: "scope": "project", "project_id": "${projects[0]}"`
    : projects.length > 1
      ? `this wave spans ${projects.length} Hauntings (${projects.join(', ')}) — every item: "scope": "org" with NO project_id, so each Haunting's Mediums can recall it`
      : `first GET $API/api/agent/ghosts/${wave.primary_ghost_id} and use "scope": "project" with its .project_id`;
  const dedupeCurls = (projects.length ? projects : ['<the project id from the GET above>'])
    .map((pid) => `   curl -s -X POST -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '{"query":"<2-4 key words OR-ed: a OR b>","project_id":"${pid}","limit":5}' "$API/api/agent/imprints/recall"`)
    .join('\n');

  // SORT BEFORE SLICING. An arrival-order slice drops whichever findings the lenses happened to
  // report last — on a 19-finding wave that silently discarded 7 at random, blockers included,
  // from the input to the Coven's permanent memory. Severity order means the cap costs the least
  // valuable candidates instead of arbitrary ones.
  const SEV_RANK = { blocker: 3, major: 2, minor: 1 };
  const findingsShown = confirmed
    .slice()
    .sort((a, b) => (SEV_RANK[b && b.severity] || 0) - (SEV_RANK[a && a.severity] || 0))
    .slice(0, WB_MAX_FINDINGS);
  const resShown = resolutions.slice(0, WB_MAX_RESOLUTIONS);
  const more = (n, shown, total) => (total > shown ? ` (+${total - shown} more ${n} not shown)` : '');
  // An escalated wave's fix set is NOT committed. Say so, or the writeback records a fix as shipped.
  const escNote = ctx.escalation
    ? `\nTHIS WAVE ESCALATED at phase "${ctx.escalation.phase}": ${String(ctx.escalation.reason || '').slice(0, 400)}\n${ctx.fixesCommitted ? "The ghost's own build AND harden's fix set are both committed; the stop came after that." : "The ghost's own build IS committed and gate-green; harden's FIX SET is NOT committed."} Write only learnings that hold regardless of whether those fixes land, and never describe a fix as shipped. The escalation itself is an ENGINE lesson, not a repo lesson — do not write it as an Imprint.\n`
    : '';

  const wb = await tryAgent(
    `${CREDS}
${common(wave, 'writeback')}
WRITE BACK what this wave taught the Coven, as Imprints — durable, non-obvious learnings a future Medium would otherwise rediscover the hard way. Work ONLY through the API; edit no files; run no git.${escNote}
${(ctx.deferred || []).length ? `NOT FIXED — these findings were DEFERRED (out of range for this wave) and are still open. Do NOT write them as learnings about a fix that happened; if one teaches something durable about the CODE, say plainly that it is unfixed: ${JSON.stringify((ctx.deferred || []).map((d) => d.finding))}\n` : ''}CANDIDATES — confirmed-and-fixed harden findings${more('findings', findingsShown.length, confirmed.length)}: ${JSON.stringify(findingsShown.map((f) => ({ title: f.title, file: f.file, line: f.line, severity: f.severity })))}
Fix resolutions${more('resolutions', resShown.length, resolutions.length)}: ${JSON.stringify(resShown.map((r) => ({ finding: r.finding, files: r.files, note: r.note })))}
Gate notes: ${JSON.stringify({ new_defects: (ctx.gate && ctx.gate.new_defects) || '', totals: (ctx.gate && ctx.gate.totals) || '' })}
Implementer learnings: ${learnings.length ? JSON.stringify(learnings) : '(none reported)'}
RULES:
1. Distil AT MOST 5 learnings that would change how the NEXT wave's implementer writes code — typed gotcha (a trap that cost time; the highest-value type), convention (a house rule a reviewer enforces), fact (an environment truth) or procedure (a multi-step how-to: the gist plus a pointer). NEVER a decision (an architecture fork, a scope call, a tradeoff — that is an Augury, not an Imprint), never progress, never task state. Nothing durable → return status "skipped" with the reason. Fewer, sharper Imprints beat five weak ones. Write the FIX, not the symptom: an Imprint a reader cannot act on is noise that crowds out one they can.
2. Scope — ${scopeRule} — EXCEPT for an item that rule 3 tells you to widen, where rule 3 wins for that item alone.${projects.length === 1 ? ` Use "scope": "org" (no project_id) for a learning about the repo's code, tooling, tests or CI rather than this Haunting's feature domain — scope decides where it ranks first, nothing else; rule 3 says which scope a supersede may take.` : ''}
3. For EACH candidate, recall its key phrase FIRST so you supersede or skip rather than duplicate — run EACH of these (one per Haunting this wave touches; substitute the key words, keep the project_id):
${dedupeCurls}
   An existing vivid Imprint that already covers it → SKIP yours. It covers it but yours is the correction → put its id in "supersedes_id" (ONE supersedes_id per target across the whole batch — a second item naming the same target fails the batch). SCOPE MATCHING: a replacement may keep or WIDEN its target's scope, never narrow it or move it sideways — an org target, or a covering hit whose project_id is not one of this wave's Hauntings (the project_ids in the recall curls above), takes an org replacement ("scope": "org", no project_id); a target in one of this wave's own Hauntings takes your project scope or org. Never argue from visibility: widening is about where the correction ranks, and a correction that crosses a Haunting is by definition not one Haunting's. SKIP is the answer only when the covering Imprint is still right.
4. ONE batch call, all-or-nothing. Write the body to /tmp/imprints.${SLUG}.w${wi}.json then:
   curl -s -X POST -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' --data-binary @/tmp/imprints.${SLUG}.w${wi}.json -o /tmp/imprints.${SLUG}.w${wi}.out -w '%{http_code}' "$API/api/agent/imprints/batch"
   Body shape: {"idempotency_key": "${wbKey}", "items": [ {"memory_type": "gotcha", "title": "<=200 chars, the learning in one line", "content": "<=2000 chars — what, where, why it bit, and what to do instead", "scope": "project" or "org", "project_id": "<project scope only>", "source_task_id": "${wave.primary_ghost_id}", "links": ${JSON.stringify(wave.ghosts.map((g) => ({ kind: 'task', id: g.id })))}, "tags": ["<lowercase area>", "<lowercase subsystem>"]} ] }
   Limits the server enforces (a 422 names the field): 1-20 items; title 1-200; content 1-2000; tags lowercase, <=20 of them, each <=50 chars; links <=20; memory_type one of fact|convention|preference|gotcha|procedure; "scope": "project" REQUIRES project_id and "scope": "org" takes NO project_id (a 422 either way); the key <=128 chars.
5. Outcomes — 2xx with "replayed": false → status "written", memory_ids from the response. 2xx with "replayed": true → status "replayed" (an earlier attempt of THIS wave already wrote under this key — do NOT resend under any other key). 400 IMPRINT_BATCH_ITEM_INVALID → nothing was recorded; failing_indexes names each bad item and field — a field of supersedes_id means re-recall and pick the winner or drop the supersede; a field of "scope" means the target is org-scoped or belongs to another Haunting — make that item "scope": "org" with NO project_id per rule 3 (prefer this; drop its supersedes_id and write it fresh only when the covering hit is still right); fix the items and resend ONCE under the SAME key. 422 (request validation: a cap above was exceeded; nothing recorded, the key is unconsumed) → the body's errors[].loc names items → <index> → <field>; fix that field and resend ONCE under the SAME key. Still failing after the one resend → status "failed" with the reason. 409 SUPERSEDE_CONFLICT → a supersede target lost a race AFTER validation; the whole batch rolled back, so NOTHING was recorded and the key is UNCONSUMED. Re-recall that key phrase, then supersede the winner or drop supersedes_id, and resend ONCE under the SAME key — the same recovery as the 400 above. Do NOT give up: rule 3 makes this race more likely, and giving up discards recoverable learnings. Any other non-2xx (404 / 5xx) → status "failed" with the HTTP code and $(jq -r '(.detail.error_code? // .detail // "no body") | tostring' <the .out file>); never retry without the key, never blind-retry. Print every HTTP code you saw.
Return {status, memory_ids, reason}.`,
    { label: `writeback:${wave.name}`, phase: 'writeback', model: pin('opus'), effort: 'high', schema: WRITEBACK },
  );
  const tag = ctx.escalation ? `writeback (escalated wave) [${wave.name}]` : `writeback [${wave.name}]`;
  if (!wb) { log(`${tag}: agent died — nothing recorded`); return { status: 'failed', memory_ids: [], reason: 'writeback agent died' }; }
  if (wb.status === 'written') log(`${tag}: ${(wb.memory_ids || []).length} imprint(s) recorded under ${wbKey}`);
  else if (wb.status === 'replayed') log(`${tag}: NOT recorded — an earlier attempt of this wave owns the key ${wbKey}`);
  else log(`${tag} ${wb.status || 'failed'}: ${String(wb.reason || '').slice(0, 200)}`);
  return wb;
}

// ── Escalation: fat payload + best-effort escalation EVP on the primary ghost ──
async function escalate(wave, phaseName, reason, extra) {
  const payload = Object.assign(
    { status: 'escalated', wave: wave.name, phase: phaseName, reason, worktree: WT, branch: BRANCH, baseline_red: BASELINE_RED, baseline_measured: BASELINE_MEASURED, ...(BASELINE_GATES_MEASURED ? { baseline_red_gates: BASELINE_RED_GATES } : {}), baseline_gates_measured: BASELINE_GATES_MEASURED, scratch_dbs: createdDbs.slice(), learnings: WAVE_LEARNINGS.slice(), recall: WAVE_RECALL, warnings: WAVE_WARNINGS.slice(), inherited_red_gates: WAVE_INHERITED_RED_GATES.slice(), skipped_capabilities: SKIPPED.slice(), agents: { spawned: AGENT_STATS.spawned, died: AGENT_STATS.died.slice() }, completed: completed.slice() },
    extra || {},
  );
  // WRITE THE MEMORY BEFORE THE NOTICE. Past WAVE_BUILD_PROVEN the ghost's own work is committed
  // and gate-green — only harden's fix set is in doubt — so the learnings and the refuter-verified
  // findings are about code that already exists. Before it, we deliberately write nothing: a build
  // that failed its own gate is exactly where a "learning" may be the misconception that failed it.
  // Ordered first so the EVP can name the Imprint ids it created.
  if (WAVE_BUILD_PROVEN) {
    payload.imprints = await writebackImprints(wave, {
      wi: WAVE_INDEX,
      confirmed: payload.harden_findings || [],
      fix_resolutions: payload.fix_resolutions || [],
      gate: payload.harden_gate || null,
      deferred: payload.deferred_out_of_range || [],
      learnings: WAVE_LEARNINGS,
      projects: WAVE_PROJECTS,
      primarySha: ((payload.committed_shas || []).find((sh) => sh && sh.ghost === wave.primary_ghost_id) || {}).sha,
      preSha: payload.pre_wave_sha,
      fixesCommitted: phaseName === 'harden-commit' || (phaseName === 'reversibility' && WAVE_BUILD_PROVEN && !!payload.harden_changed_files),
      escalation: { phase: phaseName, reason },
    });
  } else {
    payload.imprints = { status: 'skipped', memory_ids: [], reason: `escalated at "${phaseName}" before the build was proven — learnings ride this payload only` };
  }
  // ── Park the working tree ─────────────────────────────────────────────────────────────────
  // THE STRUCTURAL REASON EVERY ESCALATION USED TO COST A HUMAN. Failure paths deliberately leave
  // edits uncommitted ("left UNCOMMITTED for a human"), and BOTH the setup guard and the resume
  // guard require `git status --porcelain` to be EMPTY. So the state the engine produces on
  // failure is precisely the state it refuses to start from: nothing could resume until a person
  // committed or discarded the work, and that person had to make a judgement call first. Group B
  // deliberately raises the escalation rate, which would have made this worse, not better.
  //
  // So: park the delta, then hand back a clean tree. The decision about the fix set is DEFERRED,
  // not eliminated — but it stops blocking every later wave and every retry.
  //
  // SAFETY IS THE WHOLE DESIGN HERE, because the reset step is the only destructive thing this
  // engine does to work it did not commit:
  //   1. write a patch that includes UNTRACKED files (add -N, diff, reset — harden's regression
  //      tests are usually new files, so a tracked-only patch would silently drop them);
  //   2. `git stash create` + `stash store` as a second, independent copy in the reflog;
  //   3. `git apply --check` the patch against the clean tree BEFORE touching anything;
  //   4. only then reset. If ANY of 1-3 fails, DO NOT reset — leave the tree dirty, say so, and
  //      the old behaviour applies. A tree we cannot restore is never a tree we clean.
  // Parking is NOT gated on WAVE_BUILD_PROVEN. Only 6 of ~22 escalation sites are post-proof, so
  // gating it there left the build, ownership, gate and reconcile escalations handing back exactly
  // the dirty tree the setup guard refuses — the problem this stage exists to solve. "Nothing was
  // proven" is the right reason not to write MEMORY; preserving and cleaning asserts nothing about
  // quality. WAVE_BUILD_PROVEN still gates the writeback, above.
  let parked = null;
  {
    parked = await tryAgent(
      `${common(wave, 'park')}
PARK the uncommitted working tree so a resume can run, WITHOUT losing anything. Committed history is untouched; only the uncommitted delta moves. Work in ${WT}.
0. THE PATCH MUST LIVE OUTSIDE THE WORKTREE, because step 6 deletes untracked files and would otherwise destroy the very backup it just wrote:
   PARKDIR=$(git -C ${WT} rev-parse --path-format=absolute --git-common-dir)/rite-cadence-parked
   mkdir -p "$PARKDIR" ; PATCH="$PARKDIR/${SLUG}.w${WAVE_INDEX}.${phaseName}.$(date +%s).patch"
   ($PARKDIR is inside the MAIN checkout's .git, which no git clean ever touches. If PARKDIR comes back empty or relative, STOP: return {parked:false, clean:false, reason:"could not resolve a safe patch directory"} and change nothing.)
1. git -C ${WT} status --porcelain — if EMPTY there is nothing to park: return {parked:false, clean:true} and STOP.
2. Capture EVERYTHING, untracked included — harden's regression tests are usually NEW files, and a tracked-only patch drops them silently:
   git -C ${WT} add -A -N && git -C ${WT} diff HEAD --binary > "$PATCH" ; git -C ${WT} reset -q
3. Second copy in the reflog, which survives deletion of the patch file. NOTE it is a PARTIAL copy — \`git stash create\` does NOT include untracked files, so the patch from step 2 is the authoritative one:
   STASH=$(git -C ${WT} stash create) && [ -n "$STASH" ] && git -C ${WT} stash store -m "rite-cadence parked ${shellSafe(wave.name)}/${phaseName}" $STASH
4. PROVE THE PATCH MATCHES THE TREE before destroying anything — with --reverse, and the direction matters:
   [ -s "$PATCH" ] && git -C ${WT} apply --check --reverse --binary "$PATCH"
   A FORWARD --check here always fails and would make this stage never clean: the working tree already contains everything the patch describes, so applying it again conflicts. --reverse asks the question that is actually meaningful — "does this patch describe exactly the delta sitting in this tree?" — and it is the same property that makes the forward apply work once the tree is clean.
   — empty file, missing file, or nonzero exit → return {parked:false, clean:false, reason:"<why>"} and DO NOT run steps 5-6. A tree that cannot be restored must stay dirty.
5. RE-READ the tree and refuse if it moved: git -C ${WT} status --porcelain -uall must be byte-identical to what step 1 returned. A reverse-check proves the hunks the patch HAS; it cannot prove the patch is COMPLETE, and anything created in this worktree between step 2 and now (a dev server, a test runner, a human) is in no patch and no stash. Differ → return {parked:false, clean:false, reason:"tree changed during park; refusing to clean"}.
6. Only now: git -C ${WT} checkout -- . && git -C ${WT} clean -fd
   (deliberately NOT -x: ignored files — node_modules, venv, build output — are not this stage's to delete, and re-creating them costs far more than they save.)
7. Confirm: git -C ${WT} status --porcelain is EMPTY, and "$PATCH" still exists. If either fails, return parked:false with the reason.
Return {parked, clean, patch_path:"$PATCH", patch_bytes:<the integer from: wc -c < "$PATCH" ; 0 if the file is missing>, apply_check_exit:<the OBSERVED exit code of the step-4 reverse check, as an integer; -1 if you did not run it>, stash:"<the stash sha or empty>", reason}.`,
      { label: `park:${wave.name}`, phase: phaseName, model: pin('sonnet'), schema: { type: 'object', additionalProperties: false, properties: { parked: { type: 'boolean' }, clean: { type: 'boolean' }, patch_path: { type: 'string' }, patch_bytes: { type: 'integer' }, apply_check_exit: { type: 'integer' }, stash: { type: 'string' }, reason: { type: 'string' } }, required: ['parked', 'patch_bytes', 'apply_check_exit'] } },
    );
    // FACTS OVERRULE THE VERDICT — the same rule Group B applied to `green: true`, and it belongs
    // here most of all: this is the only operation in the engine that can permanently lose
    // uncommitted work. A `parked: true` claim with an empty patch or a nonzero reverse-check is
    // not parked, it is a report of parking.
    const pkBytes = parked && Number.isInteger(parked.patch_bytes) ? parked.patch_bytes : 0;
    const pkExit = parked && Number.isInteger(parked.apply_check_exit) ? parked.apply_check_exit : -1;
    const pkProven = !!(parked && parked.parked && pkBytes > 0 && pkExit === 0 && parked.patch_path);
    payload.parked = parked
      ? { parked: pkProven, clean: !!parked.clean && (pkProven || !parked.parked), patch_path: parked.patch_path || '', patch_bytes: pkBytes, apply_check_exit: pkExit, stash: parked.stash || '', reason: parked.reason || (parked.parked && !pkProven ? `park REPORTED success but the facts refuse it: patch_bytes=${pkBytes}, apply_check_exit=${pkExit}` : '') }
      : { parked: false, clean: false, patch_bytes: 0, apply_check_exit: -1, reason: 'park agent died — the tree is still dirty and a resume will refuse it' };
    if (parked && parked.parked && !pkProven) log(`park REFUSED [${wave.name}]: the agent claimed success but patch_bytes=${pkBytes} apply_check_exit=${pkExit} — treating the tree as still dirty`);
    if (payload.parked.parked) log(`parked [${wave.name}]: uncommitted work saved to ${payload.parked.patch_path}${payload.parked.stash ? ` (+ stash ${String(payload.parked.stash).slice(0, 8)})` : ''} — the tree is clean and this rite is resumable`);
    else if (payload.parked.clean) log(`park [${wave.name}]: nothing to park, tree already clean`);
    else log(`park FAILED [${wave.name}]: ${payload.parked.reason} — the tree stays dirty, a resume will refuse it until a human clears it`);
  }

  // ── The inverse of claim ──────────────────────────────────────────────────────────────────
  // claim PUTs every ghost in the wave to active_haunt and assigns it to this Medium. NOTHING in
  // this engine ever reversed that, so an escalation left the whole wave claimed by a Medium that
  // is no longer working — and since later waves are never claimed at all, a rite could sit in
  // three tracker states at once with only a payload to explain it.
  //
  // The split is by what actually exists in git, not by phase:
  //   committed  → LEAVE active_haunt. The work is real and merely unexorcised; releasing it to
  //                ether would tell the next reader nobody has built it, which is false.
  //   uncommitted→ RELEASE to ether, unassigned. Nobody is working it and nothing was built; a
  //                ghost parked in active_haunt against no work is how a backlog starts lying.
  // Prefer what the call site passed, fall back to the hoisted truth. Never an empty set merely
  // because a call site forgot: releasing a committed ghost is the one outcome this must not have.
  if (!(payload.committed_shas || []).length && WAVE_COMMITS.length) payload.committed_shas = WAVE_COMMITS.slice();
  if (!(payload.deferred_out_of_range || []).length && WAVE_DEFERRED.length) payload.deferred_out_of_range = WAVE_DEFERRED.slice();
  const committedGhosts = new Set((payload.committed_shas || []).map((s) => s && s.ghost).filter(Boolean));
  // Only what THIS invocation claimed. Escalations at `setup` and `db-provision` fire BEFORE the
  // claim stage, so releasing "the wave's ghosts" there would regress ghosts the run never touched
  // — including a Hunter's purgatory review or someone else's assignment — on a run that did
  // nothing at all.
  const toRelease = WAVE_CLAIMED.filter((id) => id && !committedGhosts.has(id));
  // A REJECTED TALISMAN CANNOT BE FIXED BY MORE CALLS THAT USE IT. Both the release stage and the
  // escalation EVP below authenticate with the same key the probe just proved dead, so running
  // them spawns two agents whose every request 401s — and the EVP stage's whole product is a
  // tracker write. Skip both, say so on the payload, and let the message carry the remedy.
  const credentialDead = !!extra.credential_dead;
  if (credentialDead) log(`escalate [${wave.name}]: talisman rejected — skipping release and escalation EVP (both would 401 with the same key)`);
  if (toRelease.length && !credentialDead) {
    const rel = await tryAgent(
      `${CREDS}
RELEASE these ghosts — this wave escalated at "${phaseName}" and nothing was committed for them, so they must not stay claimed by a Medium that is no longer working them. This stage's ENTIRE product is a claim about tracker state, so every step below is judged by its HTTP code, never by the absence of an error message: curl -s exits 0 on a 500 and prints the error body to stdout.
0. ME=$(curl -s -H "$AUTH" -H "$GH_CLIENT" "$API/api/agent/me") — parse .id as the medium id.
For EACH id:
1. curl -s -H "$AUTH" -H "$GH_CLIENT" "$API/api/agent/ghosts/<id>" — read .status AND .assigned_agent_id.
   - status already "exorcised" or "poltergeist" → LEAVE IT, record in skipped (never regress a terminal state, never un-block a blocked ghost).
   - status "purgatory" → LEAVE IT, record in skipped: a Hunter has it in review and that state is theirs, not ours.
   - .assigned_user_id is set → LEAVE IT, record in skipped: a HUNTER holds this ghost. POST /ghosts/{id}/handoff-hunter sets assigned_user_id and CLEARS assigned_agent_id, so an agent-id-only check sails straight past this and evicts a person.
   - .assigned_agent_id is set and is NOT your medium id → LEAVE IT, record in skipped: another Medium was handed this ghost mid-run and evicting them would be silent theft.
2. Otherwise set it back to the backlog: curl -s -o /tmp/rel.<id>.json -w '%{http_code}' -X PUT -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '{"status":"ether"}' "$API/api/agent/ghosts/<id>/status"   (the /status endpoint — a PUT to /ghosts/<id> returns 200 and silently IGNORES status)
3. Unassign: curl -s -o /tmp/rel2.<id>.json -w '%{http_code}' -X PUT -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '{"assigned_agent_id":null}' "$API/api/agent/ghosts/<id>"   (an EXPLICIT null unassigns; omitting the field is a no-op)
   (Deliberately NOT POST /ghosts/{id}/release, which does both in one transaction: it 403s on a second call once you are no longer the assignee, and this stage must be safe to re-run after a partial failure. The ownership guard that endpoint gives you for free is step 1's assigned_agent_id check instead — do not skip it.)
4. Record in released ONLY when BOTH step 2 and step 3 returned 2xx. Otherwise record in failures with the code and $(jq -r '(.detail.error_code? // .error_code? // .detail // "no body") | tostring' <the file for whichever step failed: /tmp/rel.<id>.json for step 2, /tmp/rel2.<id>.json for step 3>). Ghost endpoints put the machine-readable code at the TOP level and leave detail as prose, so read both. A 404 means the ghost was deleted; 401/426 is a Talisman or client-version problem and is worth its own words; 000 means the connection itself failed.
IDS: ${toRelease.join(', ')}
Return {released:[ids], skipped:[ids], failures:[{ghost,error}]}.`,
      { label: `release:${wave.name}`, phase: phaseName, model: pin('sonnet'), schema: { type: 'object', additionalProperties: false, properties: { released: { type: 'array', items: { type: 'string' } }, skipped: { type: 'array', items: { type: 'string' } }, failures: { type: 'array', items: { type: 'object', additionalProperties: false, properties: { ghost: { type: 'string' }, error: { type: 'string' } }, required: ['ghost', 'error'] } } }, required: ['released'] } },
    );
    payload.released = rel
      ? { released: rel.released || [], skipped: rel.skipped || [], failures: rel.failures || [] }
      : { released: [], skipped: [], failures: [], error: 'release agent died — these ghosts are STILL active_haunt and assigned' };
    if (!rel) log(`release FAILED [${wave.name}]: agent died — ${toRelease.length} ghost(s) remain active_haunt against no committed work`);
    else log(`release [${wave.name}]: ${(rel.released || []).length} ghost(s) back to ether, ${(rel.skipped || []).length} left alone`);
  }
  if (committedGhosts.size) payload.left_active_haunt = [...committedGhosts];

  // Say plainly that the tracker has no record and WHY, rather than letting the run end with a
  // silent payload. This is the one escalation whose notice provably cannot be delivered — the
  // notice would travel over the credential that is the subject of the notice.
  if (credentialDead)
    payload.escalation_evp = { posted: false, error: 'not attempted — the talisman does not authenticate, so an EVP would 401 too. This escalation exists only in this result payload and the log.' };

  if (wave.primary_ghost_id && !credentialDead) {
    // THE EVP IS THE ONLY DURABLE RECORD OF A FAILURE. The payload dies with the session and the
    // journal is keyed by sha256 with no labels, so whatever is not in here is, in practice, lost.
    // It used to carry the reason truncated to 300 chars and nothing else — not the failure code,
    // not the uncommitted files the human has to decide about, not a single finding.
    //
    // Built in JS and embedded with JSON.stringify rather than hand-written into a JSON literal:
    // shellSafe STRIPS backticks/$/backslashes and swaps " for ', so a finding title containing a
    // path or an env var reached the tracker mangled — and a newline in a title would have broken
    // the literal outright. JSON.stringify handles all of it and needs no sanitising.
    const ev = [];
    ev.push(`**rite-cadence ESCALATED** — wave \`${wave.name}\`, phase \`${phaseName}\`${payload.failure_code ? ` (\`${payload.failure_code}\`)` : ''}.`);
    ev.push('');
    ev.push(String(reason || '').slice(0, 1200));
    if ((payload.committed_shas || []).length) ev.push(`\nCommitted before the stop: ${payload.committed_shas.map((s) => `${String(s.sha || '').slice(0, 7)} (${String(s.ghost || '').slice(0, 8)})`).join(', ')}. Boundary \`pre_wave_sha\` ${String(payload.pre_wave_sha || '?').slice(0, 12)} is preserved for a clean reset.`);
    if ((payload.harden_changed_files || []).length) ev.push(`\n**Left UNCOMMITTED for a human (${payload.harden_changed_files.length} file(s)):**\n${payload.harden_changed_files.map((f) => `- \`${f}\``).join('\n')}`);
    if ((payload.deferred_out_of_range || []).length) ev.push(`\n**Deferred (out of range for this wave, NOT fixed):**\n${payload.deferred_out_of_range.map((d) => `- ${d.finding} — needed: ${String(d.note || '').slice(0, 200)}`).join('\n')}`);
    const conf = payload.harden_findings || [];
    if (conf.length) ev.push(`\n**Harden confirmed ${conf.length} finding(s)**${conf.length > 8 ? ' (first 8)' : ''}:\n${conf.slice(0, 8).map((f) => `- [${f.severity || '?'}] ${String(f.title || '?').slice(0, 140)}`).join('\n')}`);
    const bc = (payload.fix_resolutions || []).filter((r) => r && r.behavior_change);
    if (bc.length) ev.push(`\n**Behaviour changed beyond the finding** — review these first:\n${bc.map((r) => `- ${String(r.finding || '?').slice(0, 120)} (${String(r.files || '').slice(0, 160)})`).join('\n')}`);
    if ((payload.harden_unverified || []).length) ev.push(`\n**Never adjudicated** (refuters died; kept by fail-loud policy): ${payload.harden_unverified.map((u) => String(u.title || '?').slice(0, 90)).join(' | ')}`);
    const pvs = payload.harden_verify_stats;
    if (pvs && pvs.lost) ev.push(`\n**Adversarial coverage:** ${pvs.lost} of ${pvs.refuters} refuter(s) lost after retry (${pvs.recovered} recovered). Findings below were reviewed by fewer votes than the quorum intends.`);
    if ((payload.learnings || []).length) ev.push(`\n**What this wave learned:**\n${payload.learnings.map((l) => `- ${l}`).join('\n')}`);
    const im = payload.imprints || {};
    if (im.status === 'written') ev.push(`\nImprints written back: ${(im.memory_ids || []).join(', ')}`);
    else if (im.status && im.status !== 'skipped') ev.push(`\nWriteback ${im.status}: ${String(im.reason || '').slice(0, 200)}`);
    if ((payload.scratch_dbs || []).length) ev.push(`\nScratch DB(s) left for debugging: ${payload.scratch_dbs.join(', ')}`);
    const pk = payload.parked || {};
    if (pk.parked) {
      ev.push(`\n**The uncommitted work is PARKED, not lost.** Patch: \`${pk.patch_path}\`${pk.stash ? ` (a partial stash copy also exists — \`${String(pk.stash).slice(0, 12)}\` — but 'git stash create' omits UNTRACKED files, so the patch above is the authoritative one)` : ''}`);
      ev.push(`Restore it with \`git -C ${WT} apply --binary ${pk.patch_path}\`. The tree is CLEAN, so this rite is resumable now — reviewing that patch is a decision you can take after the run, not before it.`);
    } else if (pk.reason) {
      ev.push(`\n**The tree is still dirty** and a resume will refuse it: ${pk.reason}. Commit or discard the delta in \`${WT}\` before resuming.`);
    }
    ev.push(`\nWorktree \`${WT}\` (branch \`${BRANCH}\`).`);
    const evpBody = ev.join('\n').slice(0, 4000);

    const posted = await tryAgent(
      `${CREDS}
Post ONE escalation EVP (do not change status) to ghost ${wave.primary_ghost_id}. Write the body to a file first so no shell quoting can touch it:
cat > /tmp/escalate.${SLUG}.w${WAVE_INDEX}.json <<'JSON'
${JSON.stringify({ content: evpBody })}
JSON
curl -s -X POST -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' --data-binary @/tmp/escalate.${SLUG}.w${WAVE_INDEX}.json -w '%{http_code}' "$API/api/agent/ghosts/${wave.primary_ghost_id}/evps"
Report posted=true only on a 2xx; on anything else posted=false with the HTTP code in error.`,
      { label: `escalate-evp:${wave.name}`, phase: phaseName, model: pin('sonnet'), schema: { type: 'object', additionalProperties: false, properties: { posted: { type: 'boolean' }, error: { type: 'string' } }, required: ['posted'] } },
    );
    // Whether the notice actually landed is itself part of the record. Discarding this result
    // meant a dead EVP agent left the tracker silent AND the payload silent about the silence.
    payload.escalation_evp = posted && posted.posted
      ? { posted: true }
      : { posted: false, error: (posted && posted.error) || 'EVP agent died — the tracker has NO record of this escalation' };
    if (!payload.escalation_evp.posted) log(`escalate EVP NOT posted [${wave.name}]: ${payload.escalation_evp.error}`);
  }
  // LAST, deliberately: the ledger is the durable record of this escalation, so it must be written
  // after writeback, park, release and the EVP have each reported — otherwise it records a run
  // state that is not the one the human will find. It is also the only record that survives a dead
  // talisman, which is why it is bash and a file rather than a tracker write.
  payload.ledger = await recordLedger('escalated', {
    wave: wave.name, phase: phaseName, reason, failure_code: payload.failure_code,
    completed: completed.slice(),
  });
  return payload;
}

// ── Resume integrity guard (Blocker C) ──
if (RESUME_FROM) {
  const resumeIdx = WAVES.findIndex((w) => w.name === RESUME_FROM);
  const skipped = WAVES.slice(0, resumeIdx);
  const skippedGhostIds = skipped.flatMap((w) => (w.ghosts || []).map((g) => g.id));
  const guard = await tryAgent(
    `${common({ name: RESUME_FROM }, 'resume-guard')}
RESUME INTEGRITY CHECK before skipping ${skipped.length} completed wave(s). In ${WT}:
1. git -C ${WT} rev-parse --abbrev-ref HEAD MUST equal "${BRANCH}" and start with "ext/".
2. git -C ${WT} status --porcelain MUST be empty (clean tree).
3. EACH of these ghost ids MUST already be committed (appear in git log): ${skippedGhostIds.join(', ') || '(none)'}
   Check with: git -C ${WT} log --grep="Ghost: <id>" --oneline  (per id).
Return ok=true only if ALL hold; else ok=false, missing_ghosts, reason.`,
    { label: 'resume-guard', phase: 'setup', model: pin('sonnet'), schema: RESUME_GUARD },
  );
  if (!guard || !guard.ok) {
    // Through escalate(), not a raw return: these paths produced no EVP and no learnings, so a
    // resume that failed its integrity check left NOTHING in the tracker to say why.
    return await escalate({ name: `(resume-guard: ${RESUME_FROM})`, ghosts: [] }, 'resume-guard', (guard && guard.reason) || 'resume integrity check failed', { missing_ghosts: (guard && guard.missing_ghosts) || [] });
  }
  if (anyBackend && !BASELINE_RED.length && !Array.isArray(A.baseline_red))
    log('resume without args.baseline_red — the baseline will be RE-DERIVED on the partially-built tree (prior waves were gated green, but pass the payload\'s baseline_red back to avoid laundering + the suite tax)');
}

// ── Scratch-DB provisioning: ENGINE-OWNED end to end ──────────────────────────────────────
// HISTORY: the contract "db_script create must leave the DB migrated to head" lived ONLY in this
// workflow's prompt prose. Three consumer repos implemented db_script against the PUBLISHED
// schema ("per-session scratch DB"); two inferred the unwritten requirement, one did not, and a
// 4.8h run died at its final wave on an empty pre_head. Earlier waves in that same run had only
// passed because their agents improvised the missing `upgrade`.
//
// So the engine no longer ASKS the script to migrate. The published db_script contract is now the
// minimum every implementer already built — create / drop / url, pure DDL, idempotent — and the
// engine emits every migration command itself, fully substituted, with zero agent discretion.
// This is also why it works against a NON-compliant (DDL-only) db_script: step "create <base>" is
// the engine's, not the script's recursion.
//
// The base-vs-_test split is DETECTED, never assumed: `url <slug>` returns the base sibling in
// some repos (gate_cmds + pg-smoke consume it verbatim while a pytest conftest appends _test) and
// the _test DB itself in others. Both conventions are blessed by commence-haunt; a URL matching
// NEITHER escalates at wave 0 instead of failing obscurely hours later.
async function provisionScratchDb(slug, waveLike, phaseName) {
  const base = dbBase(slug);
  const full = dbFull(slug);
  const fail = (failure_code, reason) => ({ ok: false, failure_code, reason: String(reason || '').slice(-2000) });

  // 1. Resolve — ONE command, so the engine learns the repo's convention before emitting anything.
  const res = await tryAgent(
    `${common(waveLike, phaseName)}
Run EXACTLY ONE command and report its output. Do NOT create, drop, migrate, or seed anything.
  "${WT}/${DB_SCRIPT}" url ${slug}
Return {ok:true, db_url:"<the single URL line it printed, verbatim>"}. Nonzero exit or no URL → {ok:false, failure_code:"url_failed", reason:"<last 2000 chars of stderr>"}.`,
    { label: `db-resolve:${waveLike.name}`, phase: phaseName, model: pin('sonnet'), schema: DB_RESOLVE },
  );
  if (!res || !res.ok || !res.db_url) return fail((res && res.failure_code) || 'url_failed', (res && res.reason) || `"${DB_SCRIPT} url ${slug}" did not return a URL`);

  // 2. Classify in PURE JS — no agent judgment about which database is which.
  let observed;
  // parseDsn throws for a genuinely unparseable DSN -- but an ENGINE bug inside it (v1.3.4/1.3.5
  // shipped `new URL()`, which the Workflow sandbox does not have) throws the same way. An
  // unqualified catch reported that ReferenceError as "db_script url returned an unparseable
  // DSN" with failure_code db_url_name_mismatch, sending the operator to debug their blameless
  // ghost-db.sh. Separate the two: only a DSN the parser rejects is the operator's problem.
  const baseUrl = res.db_url.trim();
  try { observed = urlDbName(baseUrl); }
  catch (e) {
    const msg = String((e && e.message) || e);
    if (!(e instanceof Error) || e.name !== 'Error' || !msg.startsWith('not a parseable database URL')) {
      return fail('engine_internal', `ENGINE BUG while parsing the DSN (${e && e.name ? e.name : 'Error'}: ${msg}). This is NOT a fault in ${DB_SCRIPT} -- do not change it. Report this with the rite-cadence version from the workflow header.`);
    }
    return fail('db_url_name_mismatch', `db_script url returned an unparseable DSN (${msg}): ${baseUrl.slice(0, 200)}`);
  }
  let dbNames;
  let testUrl = '';
  // withDbName() calls parseDsn again; it sat OUTSIDE any try/catch, so a throw here escaped
  // as an uncaught exception with no failure_code at all.
  try {
    if (observed === base) { dbNames = [base, full]; testUrl = withDbName(baseUrl, full); }    // dual-DB
    else if (observed === full) { dbNames = [full]; }                                          // single-DB
    else return fail('db_url_name_mismatch', `"${DB_SCRIPT} url ${slug}" resolved to database "${observed}", which is neither the expected base "${base}" nor "${full}". The engine cannot tell which database its gates would run against. Fix db_script's url subcommand or isolation.db_prefix (currently "${DB_PREFIX || '<unset>'}").`);
  } catch (e) {
    return fail('engine_internal', `ENGINE BUG while rewriting the DSN (${e && e.name ? e.name : 'Error'}: ${String((e && e.message) || e)}). This is NOT a fault in ${DB_SCRIPT}.`);
  }
  log(`scratch DB [${waveLike.name}]: ${dbNames.length > 1 ? 'dual-DB' : 'single-DB'} convention — ${dbNames.join(' + ')}`);

  // 3. Provision — every command LITERAL and fully substituted. No shell variable is carried
  // between steps: each agent Bash call is a separate shell, so a `URL=$(...)` captured in one
  // step expands to EMPTY in the next, and an empty DATABASE_URL makes most migration CLIs fall
  // back to alembic.ini / .env — i.e. silently migrating the developer's real database.
  const steps = [];
  dbNames.slice().reverse().forEach((d) => steps.push(`"${WT}/${DB_SCRIPT}" drop ${d}   (idempotent reset — a leftover DB from a dead run is rebuilt, never trusted)`));
  dbNames.forEach((d) => steps.push(`"${WT}/${DB_SCRIPT}" create ${d}   (plain CREATE DATABASE is all this needs to do)`));
  if (DB_MIGRATE) {
    steps.push(`DATABASE_URL="${baseUrl}" "${WT}/${DB_MIGRATE}" upgrade`);
    if (testUrl) steps.push(`DATABASE_URL="${testUrl}" "${WT}/${DB_MIGRATE}" upgrade`);
    steps.push(`DATABASE_URL="${baseUrl}" "${WT}/${DB_MIGRATE}" current   → report the bare revision token as pre_head (e.g. "031_seed_medicine_drug_types"); strip decoration like "(head)". Empty output means the database is NOT migrated: ok=false, failure_code "head_unparseable".`);
  }
  // GATE-SCRIPT STALENESS PROBE. The engine is pinned to the MAIN checkout, but gate commands run
  // the WORKTREE's scripts ("${WT}/${PG_SMOKE}"). A worktree branched off an older main therefore
  // carries an older pg-smoke that has never heard of PG_SMOKE_SCRATCH — it would apply the legacy
  // `_test$` rule to the base URL and exit 4 on every wave. Detect that HERE, at wave 0, instead
  // of after a 20-minute gate run.
  if (PG_SMOKE) steps.push(`test -f "${WT}/${PG_SMOKE}" && grep -c PG_SMOKE_SCRATCH "${WT}/${PG_SMOKE}" || echo MISSING   → set pg_smoke_present false if it printed MISSING, else true; set pg_smoke_scratch_ok true only if it printed a count of 1 or more. This is a capability probe: neither a count of 0 nor MISSING is a command failure, so do NOT set ok:false for it.`);
  const prov = await tryAgent(
    `${common(waveLike, phaseName)}
PROVISION this ${phaseName === 'baseline' ? 'baseline' : "wave's"} scratch Postgres. Run these commands EXACTLY as written, in order, one foreground Bash call each. Copy each command VERBATIM — do not re-derive a URL, do not substitute a shell variable for one, do not add a step, and do not "fix" a failure by improvising a different command.
${steps.map((c, i) => `${i + 1}. ${c}`).join('\n')}
Any nonzero exit → STOP and return ok:false with failed_step = that step's number, reason = the LAST 2000 characters of its stderr, and failure_code: "create_failed" / "drop_failed" for a db_script step, "migrate_failed" for a migration step, or "db_unreachable" if the server refused the connection.
Return {ok, pre_head${DB_MIGRATE ? '' : ' (always "" — no migration CLI configured)'}, reason, failure_code, failed_step${PG_SMOKE ? ', pg_smoke_scratch_ok, pg_smoke_present' : ''}}.`,
    { label: `db:${waveLike.name}`, phase: phaseName, model: pin('sonnet'), schema: PROVISION_DB },
  );
  dbNames.forEach((d) => { if (!createdDbs.includes(d)) createdDbs.push(d); });   // register BEFORE the ok-check: a half-provisioned run still owes cleanup
  if (!prov || !prov.ok) return Object.assign(fail((prov && prov.failure_code) || 'create_failed', (prov && prov.reason) || 'scratch DB provisioning failed'), { dbNames, failed_step: prov && prov.failed_step });

  // 4. pre_head by SHAPE, not truthiness. The old `!prov.pre_head` check passed on "none",
  // "(none)", "None" and " " — every one of which is what an agent actually returns for an
  // unmigrated database, so the sole hard backstop had a hole the size of the bug.
  let preHead = String(prov.pre_head || '').trim().replace(/\s*\(head\)\s*$/i, '').trim();
  if (DB_MIGRATE) {
    if (!/^[A-Za-z0-9_.-]{3,}$/.test(preHead) || /^(none|null|empty|n\/?a|head|nil|undefined)$/i.test(preHead))
      return Object.assign(fail('head_unparseable', `pre_head is not a usable revision id (got ${JSON.stringify(prov.pre_head || '')}) — the scratch DB is not migrated, so reversibility would have nothing to anchor to`), { dbNames });
  } else preHead = '';

  return { ok: true, dbUrl: baseUrl, testUrl, smokeUrl: baseUrl, smokeDbName: observed, dbNames, preHead, pgSmokeScratchOk: !!prov.pg_smoke_scratch_ok, pgSmokePresent: prov.pg_smoke_present !== false };
}

// ── Baseline (once per invocation, on the untouched tree) ──
// CLASSIFY, never block: pre-existing reds are recorded so wave gates / harden are never blamed
// for inherited failures; abort ONLY when the suite cannot RUN at all.
// TWO measurements live here, and they have different scopes on purpose:
//   * the TEST baseline (backend plans only, needs tests.backend) → BASELINE_RED, a list of ids;
//   * the GATE probe (ANY plan that declares gate_cmds, frontend-only rites included) →
//     BASELINE_RED_GATES, the commands already red on the untouched tree with no ids to name.
// The probe exists because the suite baseline could never speak for a linter: `npm run lint` has
// no test ids, so baselineExcuses() can never excuse it, and a repo whose lint is inherited-red
// escalated the wave AFTER a full build (rite 1a wave cb-ui, 2026-09-17). Probing at the base is
// the only place the engine can tell "this gate was never going to pass" from "this wave broke it".
const remapped = Object.keys(MODEL_REMAP).filter((k) => typeof MODEL_REMAP[k] === 'string' && MODEL_REMAP[k]);
if (remapped.length) log(`model remap active: ${remapped.map((k) => `${k}→${MODEL_REMAP[k]}`).join(', ')} (from .ghost/config.json models.remap and/or args.model_overrides; stage defaults otherwise)`);

const wantTestBaseline = anyBackend && !BASELINE_MEASURED;
const wantGateProbe = anyPlanGate && !BASELINE_GATES_MEASURED;
if (wantTestBaseline && !TEST_BACKEND) {
  noteSkip('run', 'baseline (tests.backend unset — every inherited red will read as wave-caused)');
  log('baseline SKIP: no backend test command (tests.backend) configured — wave gates will have no inherited-red context');
}
const runTestBaseline = wantTestBaseline && !!TEST_BACKEND;

if (runTestBaseline || wantGateProbe) {
  phase('baseline');
  // One scratch DB serves both measurements. The probe only needs it when some plan gate carries
  // {{db_url}} (validatePlan already forces such a plan to have a backend wave, so on that path
  // the test baseline is provisioning one anyway).
  let blProv = null;
  if (runTestBaseline || (wantGateProbe && probeNeedsDb)) {
    blProv = await provisionScratchDb(DB_NS + 'bl', { name: '(pre-wave)' }, 'baseline');
    if (!blProv.ok) {
      // A TEST baseline that cannot provision is fatal, exactly as before. A probe-only run is
      // not: the probe classifies, and degrading to "nothing is known to be inherited" is the
      // old, safe behaviour — never a reason to kill a rite before a single wave has run.
      if (runTestBaseline) return await escalate({ name: '(baseline)', ghosts: [] }, 'baseline', blProv.reason, { failure_code: blProv.failure_code });
      log(`gate probe DEGRADED: no scratch DB (${(blProv && blProv.failure_code) || 'unknown'}) — gates needing {{db_url}} go unprobed and can never be excused`);
      blProv = null;
    }
  }
  const dropStep = blProv
    ? `ALWAYS (even on failure), drop this baseline's scratch databases:\n${blProv.dbNames.map((d) => `     "${WT}/${DB_SCRIPT}" drop ${d}`).join('\n')}`
    : '';
  // De-register only on success: the agent's last step drops these, but an agent that DIED never
  // got there — leaving them registered means cleanup (and the escalation payload's scratch_dbs)
  // still accounts for them instead of leaking them silently.
  const deregisterDbs = () => { if (blProv) blProv.dbNames.forEach((d) => { const i = createdDbs.indexOf(d); if (i >= 0) createdDbs.splice(i, 1); }); };

  // ── The gate probe ──
  // Runs FIRST: it is the cheap half, and on a rite whose only inherited red is a linter it is the
  // half that decides whether the wave gate could ever pass. It reports FACTS (exit codes, any ids
  // named); the engine — not the agent — decides which of those are inherited-red gates.
  let probedCmds = [];
  if (wantGateProbe) {
    probedCmds = PLAN_GATE_CMDS.filter((c) => (!c.includes('{{db_url}}') || !!blProv) && !isTestSuiteCmd(c));
    const suites = PLAN_GATE_CMDS.filter(isTestSuiteCmd);
    if (suites.length) log(`gate probe: skipping ${suites.length} test-suite gate(s) — a suite is the baseline's business and can never be excused as inherited-red: ${suites.map((c) => c.slice(0, 60)).join(' | ')}`);
    const unprobed = PLAN_GATE_CMDS.filter((c) => c.includes('{{db_url}}') && !blProv && !isTestSuiteCmd(c));
    if (unprobed.length) log(`gate probe: ${unprobed.length} gate(s) need {{db_url}} and no scratch DB was available — left unprobed`);
    if (!probedCmds.length) {
      log('gate probe: nothing probeable this invocation — no gate will be excused as inherited-red');
    } else {
      const probeSteps = probedCmds.map((raw, i) => `  gate[${i}]: cd "${WT}" && ${raw.split('{{db_url}}').join(blProv ? blProv.dbUrl : '')}`);
      const probe = await tryAgent(
        `${common({ name: '(pre-wave)' }, 'baseline')}
GATE PROBE. Run each of this plan's gate commands on the UNTOUCHED tree, BEFORE any wave lands, and report what each one does. Work ONLY in ${WT}. ${blProv ? 'Any scratch database is ALREADY provisioned and migrated by the engine — do NOT create, migrate or seed anything yourself.' : ''}
READ-ONLY STAGE: do NOT edit, format, --fix, install, symlink, stash, checkout, delete or commit anything IN THE WORKING TREE — it must be byte-identical when you return, or the next stage refuses a dirty tree and blames this one. (The scratch-database drop below is not part of the tree and IS required.) A nonzero exit here is the POINT of this stage, not a problem to solve.
Run EVERY command below, in order, even after one fails:
${probeSteps.join('\n')}
${dropStep && !runTestBaseline ? `  then: ${dropStep}\n` : ''}
EXECUTION DISCIPLINE (hard rules — long-running agents get killed by the harness): run each command as ONE foreground Bash call with an EXPLICIT tool-call timeout of 600000 ms (the harness default of 2 min is shorter than many gates). Run each command EXACTLY ONCE — no re-runs, no retries, no "let me check that again". NEVER background-and-poll.
Return ok=true whenever you were able to RUN the commands (a nonzero exit is a RESULT, not a failure), and exits = one entry per gate[i] above: {index (the NUMBER IN THE gate[i] LABEL, not the position you ran it in), exit_code (the process's literal $? — never inferred from the output text), failures}.
Set \`failures\` to EVERY failing test id the command printed, in the exact form the suite prints it (pytest "path/to/test_x.py::test_y", the frontend runner "file > test name"). A command with no test ids at all — a linter, a type-checker — reports its nonzero exit with \`failures\` left out or empty; the engine reads "named no test id", not whether the key is present, so NEVER invent an id to fill it and never summarize ids into notes. A file path, a lint rule name, and a compiler diagnostic code are NOT test ids.
If the tool call itself is KILLED, report exit_code 124 for that gate and say "timeout" in notes. If the shell says "command not found" or "No such file or directory", report the literal code you saw (usually 127) — do NOT install it, symlink it, or work around it; the engine refuses to excuse a gate that never ran.
An index you leave out of \`exits\` entirely is treated as UNPROBED (nothing is excused for it), never as green — so report every one.
ok=false ONLY if you could not run the commands at all (the worktree is unusable); put the reason in notes, set failure_code "suite_could_not_run", and still send exits: [] — the schema requires the key.`,
        // MECHANICAL tier, not the baseline's opus: this stage runs a fixed list of shell commands
        // and writes down their exit codes. It makes no judgement — the engine classifies the
        // result — so it is the same kind of work as claim/commit/exorcise. Pinned opus/high by
        // copying the baseline stage beside it, which is a real per-invocation cost for nothing.
        { label: 'gate-probe', phase: 'baseline', model: pin('sonnet'), schema: GATE_PROBE },
      );
      if (!runTestBaseline && probe && probe.ok) deregisterDbs();
      if (!probe || !probe.ok) {
        // NEVER fatal. A dead probe means nothing is known to be inherited — the pre-1.7.5
        // behaviour, where every nonzero gate blocks. Degrading loudly beats killing the rite.
        log(`gate probe FAILED (${(probe && probe.notes) || 'agent died'}) — no gate will be excused as inherited-red; a gate red at the base will still escalate this run`);
      } else {
        // THE ENGINE CLASSIFIES, NOT THE AGENT. Inherited-red == nonzero AND named no test id.
        // A gate that named ids at the base is the TEST baseline's business (BASELINE_RED), and
        // routing it here would let a wave regression ride in on an id-less excuse.
        BASELINE_PROBED_GATES = (probe.exits || []).map((e) => e && probedCmds[e.index]).filter(Boolean);
        BASELINE_GREEN_GATES = (probe.exits || []).filter((e) => e && e.exit_code === 0).map((e) => probedCmds[e.index]).filter(Boolean);
        BASELINE_RED_GATES = (probe.exits || [])
          .filter((e) => e && couldBeInheritedRed(e.exit_code, e.failures))
          .map((e) => probedCmds[e.index])
          .filter(Boolean);
        BASELINE_GATES_MEASURED = true;
        const neverRan = (probe.exits || []).filter((e) => e && e.exit_code !== 0 && !ranAndReported(e.exit_code));
        if (neverRan.length) log(`gate probe: ${neverRan.length} gate(s) exited ${neverRan.map((e) => e.exit_code).join('/')} at the base — missing, not executable, killed, or not attempted. That is a BROKEN gate, never an inherited red: ${neverRan.map((e) => String(probedCmds[e.index] || '?').slice(0, 60)).join(' | ')}`);
        const unreported = probedCmds.filter((c) => !BASELINE_PROBED_GATES.includes(c));
        if (unreported.length) log(`gate probe: no exit reported for ${unreported.length} gate(s) — treated as UNPROBED, not as green: ${unreported.map((c) => c.slice(0, 60)).join(' | ')}`);
        const idNamers = (probe.exits || []).filter((e) => e && e.exit_code !== 0 && (e.failures || []).length).length;
        log(BASELINE_RED_GATES.length
          ? `gate probe: ${BASELINE_RED_GATES.length} of ${probedCmds.length} plan gate(s) are ALREADY red on the untouched base with no test ids — a wave gate matching one will be excused with a warning, not escalated: ${BASELINE_RED_GATES.map((c) => c.slice(0, 60)).join(' | ')}`
          : `gate probe: ${BASELINE_GREEN_GATES.length} of ${probedCmds.length} probed gate(s) are green on the untouched base${neverRan.length ? `, ${neverRan.length} could not run there` : ''}${idNamers ? ` (${idNamers} nonzero but naming test ids — not excusable here; ${runTestBaseline ? 'the test baseline owns those ids' : 'and NO test baseline runs on this invocation, so they will block'})` : ''}`);
      }
    }
  }

  // ── The test baseline (backend plans only) ──
  if (runTestBaseline) {
    const blSteps = [
      `cd "${WT}" && DATABASE_URL="${blProv.dbUrl}" TIMEOUT_SECS=1500 ${TEST_BACKEND} — record EVERY "FAILED path::..." / "ERROR path::..." pytest node-id into red_tests. (rc 124 = watchdog timeout → the suite could not complete: ok=false, failure_code "suite_could_not_run".)`,
    ];
    if (anyFrontendGate) blSteps.push(`cd "${WT}" && ${TEST_FRONTEND} — add each failing test ("file > name") to red_tests.`);
    if (dropStep) blSteps.push(dropStep);
    const bl = await tryAgent(
      `${common({ name: '(pre-wave)' }, 'baseline')}
BASELINE. Establish the PRE-EXISTING test failures on this tree BEFORE any wave of this invocation lands, so later gates are never blamed for inherited red. Work ONLY in ${WT}.
The scratch database is ALREADY provisioned and migrated to this tree's head by the engine — do NOT create, migrate, or seed anything yourself. Run these steps EXACTLY, in order:
${blSteps.map((c, i) => `${i + 1}. ${c}`).join('\n')}
Return ok=true even when tests FAILED (those failures ARE the baseline), red_tests = the exact failing ids (possibly empty), notes = one-line failure counts. ok=false ONLY if a suite could not RUN at all (pytest collection/import error, watchdog timeout — NOT individual test failures); on ok=false set failure_code "suite_could_not_run" and put the LAST 2000 characters of stderr in notes.`,
      { label: 'baseline', phase: 'baseline', model: pin('opus'), effort: 'high', schema: BASELINE },
    );
    if (bl && bl.ok) deregisterDbs();
    if (!bl || !bl.ok) {
      // scratch_dbs was MISSING from this one: a dead baseline agent never ran its own cleanup
      // step, so it leaked live Postgres databases whose names appeared in no payload at all.
      // escalate() always carries createdDbs, which is the whole point of routing through it.
      return await escalate({ name: '(baseline)', ghosts: [] }, 'baseline', (bl && bl.notes) || 'baseline suite could not run on the untouched base', { failure_code: (bl && bl.failure_code) || 'suite_could_not_run' });
    }
    BASELINE_RED = Array.isArray(bl.red_tests) ? bl.red_tests : [];
    BASELINE_MEASURED = true;
    // "will NOT block gates" was FALSE for the engine itself between v1.6.1 and v1.7.3: the
    // post-gate check consulted no baseline at all. It is conditional now, so say the condition.
    log(BASELINE_RED.length ? `baseline-red (${BASELINE_RED.length} pre-existing failure(s) — will not block a gate that NAMES them in gate_exits[].failures): ${BASELINE_RED.slice(0, 6).join(' | ')}${BASELINE_RED.length > 6 ? ' …' : ''}` : 'baseline clean — no pre-existing failures');
  }
}

// Say it out loud when no baseline was taken. A pure-frontend invocation never enters the block
// above, so it reported baseline_red: [] while never having looked -- indistinguishable in the
// logs and the payload from a backend wave that measured and found nothing. Since v1.7.3 the
// difference is load-bearing (an unmeasured invocation can excuse NO nonzero gate), so the
// limitation is stated rather than inferred. anyBackend is per-INVOCATION: a rite whose waves are
// split across several script_workflow nodes gets a baseline only on its backend invocations.
if (!BASELINE_MEASURED)
  log(`no baseline taken this invocation (${anyBackend ? 'no backend test command configured' : 'no backend wave in this invocation'}) — no TEST id is known to be inherited, so a nonzero gate naming ids will block`);
if (anyPlanGate && !BASELINE_GATES_MEASURED)
  log('no gate probe this invocation — no gate is known to be red at the base, so ANY nonzero gate with no test ids will block, including a pre-existing one');

// Does an alembic revision id belong to one of this wave's realized migration FILES? Revision ids
// and file names diverge across repos (031_foo.py may declare revision "031_foo" or a hash), so
// this matches conservatively on the file's basename stem containing the revision token.
function revisionOwnedBy(rev, migPaths) {
  const r = String(rev || '').trim().toLowerCase();
  if (!r) return false;
  return (migPaths || []).some((m) => {
    const stem = String(m).split('/').pop().replace(/\.[^.]+$/, '').toLowerCase();
    return stem === r || stem.startsWith(r + '_') || stem.includes(r);
  });
}

// ── Pure-JS ownership check (the realized-overlap verdict) ──
// Ground truth for the union is porcelain (-uall, quote-stripped); per-implementer attribution
// is SELF-REPORTED changed_files — an implementer that edits a sibling's declared file and
// omits it from its report is invisible here (unfixable in a shared tree; stated, not oversold).
function ownershipVerdict(wave, realized, builds, realizedMig) {
  const hard = [];
  const warns = [];
  const declared = declaredSet(wave);
  const migSet = new Set(realizedMig);
  if (realizedMig.length && !wave.migration) hard.push(`undeclared-migration: ${realizedMig.join(', ')} realized in a non-migration wave`);
  if (!isBackendWave(wave)) {
    const backendRealized = realized.filter((p) => BACKEND_RE.test(p));
    if (backendRealized.length) hard.push(`backend-path-in-non-backend-wave: ${backendRealized.join(', ')} (would ship with zero backend gates)`);
  }
  const unowned = realized.filter((p) => !declared.has(p) && !(wave.migration && migSet.has(p)));
  if (unowned.length) {
    if (isBackendWave(wave)) hard.push(`unowned-files: ${unowned.join(', ')} (realized outside every declared set — backend waves hard-fail; the no-owner sweep is not enough here)`);
    else warns.push(`unowned (left to the reconcile sweep): ${unowned.join(', ')}`);
  }
  const reported = (wave.implementers || []).map((imp, i) => ({ imp, files: new Set(imp.files || []), changed: ((builds[i] && builds[i].changed_files) || []).slice() }));
  for (const r of reported) {
    const outside = r.changed.filter((p) => !r.files.has(p) && !(wave.migration && MIGRATION_RUNTIME_RE.test(p)));
    if (outside.length) {
      if (isBackendWave(wave)) hard.push(`implementer "${r.imp.label}" reported changes outside its declared files: ${outside.join(', ')}`);
      else warns.push(`implementer "${r.imp.label}" self-reported outside its files: ${outside.join(', ')}`);
    }
  }
  for (let i = 0; i < reported.length; i++) {
    for (let j = i + 1; j < reported.length; j++) {
      const a = new Set(reported[i].changed);
      const overlap = reported[j].changed.filter((p) => a.has(p));
      if (overlap.length) {
        const msg = `implementers "${reported[i].imp.label}" & "${reported[j].imp.label}" both report changing: ${overlap.join(', ')}`;
        if (isBackendWave(wave)) hard.push(msg);
        else warns.push(msg);
      }
    }
  }
  return { hard, warns };
}

// Post-stage migration re-scan (the gate agent and harden fixer write files AFTER the ownership
// snapshot — a minted migration must never ride a sweep or a harden-commit past the track's
// whole reason to exist).
function newMigrations(paths, allowedSet) {
  // relPaths() so an absolute agent-reported path is compared like-for-like against the
  // porcelain-derived allowedSet. Returns the NORMALIZED path so escalation messages read
  // as repo-relative too.
  return relPaths(paths).filter((p) => MIGRATION_RUNTIME_RE.test(p) && !allowedSet.has(p));
}

// ── Harden verdict (pure JS) — what rite-cadence decides about harden's fixes BEFORE committing ──
// Inputs are guarded: harden's clean-range / all-refuted returns carry fix_resolutions: [] and a
// null gate, and an older harden may omit them entirely — a TypeError here would kill the run on
// the MOST common path (no findings), after the ghost commits and before exorcise.
//   out_of_range     — MECHANICAL: porcelain truth minus declared ∪ this wave's migration ∪
//                      reconcile-swept ∪ test paths. Backend waves escalate on it; frontend waves
//                      commit-and-flag (the house hard/warn split of ownershipVerdict).
//   doc_runtime      — MECHANICAL: a resolution whose finding lives in a doc file but whose fix
//                      touched a runtime (non-doc, non-test) path THAT IS IN THE PORCELAIN DELTA.
//                      Anchoring on the delta is what keeps a prose mention ("aligned with
//                      backend/app/x.py") from escalating a doc-only fix. Escalates on every track.
//   backend_in_frontend — MECHANICAL: a backend/ path realized by harden on a NON-backend wave —
//                      it would ship with zero backend gates (no scratch DB, no drift gate, no
//                      pg-smoke), the same rule ownershipVerdict hard-fails on every track.
//   behavior_changes — fixer OR gate said the fix changed runtime behaviour BEYOND the finding.
//   flags            — every self-reported flag, ADVISORY: surfaced, never gated on alone (the
//                      fixer's notion of "the range" is not the engine's).
// pathsIn() reads paths out of a free-text `files` field ("backend/app/x.py:12-40, tests/…");
// it needs at least one directory separator and an extension, so a bare root-level file is not
// recognised — stated, not oversold. A finder's `file` may carry ":line"; it is stripped before
// the doc classification.
function hardenVerdict(hard, truthPaths, declared, migAllowed, swept, backendWave) {
  const resolutions = hard && Array.isArray(hard.fix_resolutions) ? hard.fix_resolutions : [];
  const declaredS = declared instanceof Set ? declared : new Set(declared || []);
  const migS = migAllowed instanceof Set ? migAllowed : new Set(migAllowed || []);
  const sweptS = swept instanceof Set ? swept : new Set(swept || []);
  const truth = relPaths(truthPaths);
  const truthS = new Set(truth);
  const out_of_range = truth.filter((p) => !declaredS.has(p) && !migS.has(p) && !sweptS.has(p) && !isTestPath(p));
  const backend_in_frontend = backendWave ? [] : out_of_range.filter((p) => BACKEND_RE.test(p));
  const pathsIn = (s) => String(s || '').match(/[A-Za-z0-9_.@+-]+(?:\/[A-Za-z0-9_.@+-]+)+\.[A-Za-z0-9]+/g) || [];
  const stripLine = (p) => String(p || '').replace(/:\d+(-\d+)?$/, '');
  const doc_runtime = [];
  const behavior_changes = [];
  const flags = [];
  for (const r of resolutions) {
    if (!r) continue;
    const finding = String(r.finding || '');
    const files = String(r.files || '');
    const touchedRuntime = pathsIn(files).map(relPath).filter((f) => truthS.has(f)).some((f) => !isDocPath(f) && !isTestPath(f));
    if (isDocPath(stripLine(r.finding_file)) && touchedRuntime) doc_runtime.push({ finding, files });
    if (r.behavior_change) behavior_changes.push({ finding, files });
    if (r.out_of_range || r.behavior_change) flags.push({ finding, out_of_range: !!r.out_of_range, behavior_change: !!r.behavior_change });
  }
  return { out_of_range, backend_in_frontend, doc_runtime, behavior_changes, flags };
}

// ── Wave loop (whole-rite, gate-stops) ──
const startIdx = RESUME_FROM ? WAVES.findIndex((w) => w.name === RESUME_FROM) : 0;

for (let wi = startIdx; wi < WAVES.length; wi++) {
  const wave = WAVES[wi];
  const backendWave = isBackendWave(wave);
  // Reset every piece of wave-scoped memory state together — escalate() reads all of it, and a
  // value carried over from the previous wave would attribute one wave's learnings to another.
  WAVE_LEARNINGS = [];
  WAVE_WARNINGS = [];
  WAVE_INHERITED_RED_GATES = [];
  WAVE_PROJECTS = [];
  WAVE_BUILD_PROVEN = false;
  WAVE_INDEX = wi;
  WAVE_RECALL = { status: 'not-attempted', imprint_ids: [] };
  WAVE_CLAIMED = [];
  WAVE_COMMITS = [];
  WAVE_DEFERRED = [];

  if (STOP_BEFORE && wave.name === STOP_BEFORE) {
    log(`gate stop: pausing before wave "${wave.name}"`);
    return { status: 'paused', ledger: await recordLedger('paused', { wave: wave.name, phase: 'gate-stop', completed: completed.slice() }), completed, agents: { spawned: AGENT_STATS.spawned, died: AGENT_STATS.died.slice() }, paused_before: wave.name, worktree: WT, branch: BRANCH, baseline_red: BASELINE_RED, baseline_measured: BASELINE_MEASURED, ...(BASELINE_GATES_MEASURED ? { baseline_red_gates: BASELINE_RED_GATES } : {}), baseline_gates_measured: BASELINE_GATES_MEASURED, resume_hint: `review, then re-invoke rite-cadence with resume_from: "${wave.name}" (and clear or advance stop_before; pass baseline_red AND baseline_red_gates back to skip re-deriving the baseline and re-probing the gates)` };
  }

  // 1. setup
  phase('setup');
  const setup = await tryAgent(
    `${common(wave, 'setup')}
SETUP. In ${WT}:
1. git -C ${WT} rev-parse --abbrev-ref HEAD — MUST equal "${BRANCH}" and start with "ext/". Else ok:false.
2. git -C ${WT} status --porcelain — MUST be EMPTY (clean). Else ok:false, reason listing the dirty paths — and check whether a previous escalation parked a delta ($(git -C ${WT} rev-parse --path-format=absolute --git-common-dir)/rite-cadence-parked): if patches exist there, say so, because it means the tree was cleaned once already and something has re-dirtied it since.
3. pre_wave_sha = git -C ${WT} rev-parse HEAD.
4. epoch = $(date +%s) — the engine has no clock of its own (Date.now is unavailable in its sandbox), so the run's start time can only come from an agent that observed it.
Return {ok, pre_wave_sha, branch, epoch, reason}.`,
    { label: `setup:${wave.name}`, phase: 'setup', model: pin('sonnet'), schema: SETUP },
  );
  if (!setup || !setup.ok || !setup.pre_wave_sha) return await escalate(wave, 'setup', (setup && setup.reason) || 'setup failed / tree not clean', {});
  const preSha = setup.pre_wave_sha;
  // First wave to report wins: on a resume the later waves' setups are not the run's start.
  if (FIRST_SETUP_EPOCH === null && Number.isInteger(setup.epoch)) FIRST_SETUP_EPOCH = setup.epoch;

  // 1a. claim + plan EVP — tracker truth: a wave's ghosts show active_haunt (assigned, with
  // the plan on record) the moment their build starts, never ether→exorcised in one hop.
  // BEST-EFFORT: a Ghost Hunting hiccup logs a warning and never blocks the build.
  phase('claim');
  const claimSpec = wave.ghosts
    .map((g) => `- ${g.id} — "${(g.title || '').slice(0, 80)}"; plan: files [${(g.files || []).join(', ')}]; commit: ${JSON.stringify((g.commit_message || '').slice(0, 120))}`)
    .join('\n');
  const claim = await tryAgent(
    `${CREDS}
${common(wave, 'claim')}
CLAIM this wave's ghosts in Ghost Hunting so the tracker reflects work-in-progress (idempotent; a re-run must not error):
0. CREDENTIAL PROBE — do this FIRST and report what you observe, not what you expect:
   ME_HTTP=$(curl -s -o /tmp/me.${SLUG}.w${wi}.json -w '%{http_code}' -H "$AUTH" -H "$GH_CLIENT" "$API/api/agent/me")
   Report it as me_http (an integer; a curl failure prints 000 → report 0).
   If it is NOT 200, STOP HERE: claim nothing and return {claimed:[], skipped:[], failures:[], project_ids:[], me_http}.
   Do NOT look for the key in another file, another env var, or the main checkout, and do NOT edit
   the auth line — this run must use exactly what the preamble above resolves. A credential this
   run cannot use is the finding; making it work by hand hides it and every later stage silently
   401s while the log reads healthy.
   If it IS 200, parse .id from /tmp/me.${SLUG}.w${wi}.json as the medium id${ORG_ID ? ` and .org_id as me_org_id (report it verbatim). If me_org_id is NOT ${ORG_ID}, STOP HERE: claim nothing and return {claimed:[], skipped:[], failures:[], project_ids:[], me_http, me_org_id} — the key belongs to another Coven` : ''} and continue.
For EACH ghost below:
1. curl -s -H "$AUTH" -H "$GH_CLIENT" "$API/api/agent/ghosts/<id>" — read .status and .project_id. If status is already "exorcised" → record it in skipped (never regress it). Else:
2. PUT status: curl -s -X PUT -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '{"status":"active_haunt"}' "$API/api/agent/ghosts/<id>/status"
3. Assign: curl -s -X PUT -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '{"assigned_agent_id":"<medium id>"}' "$API/api/agent/ghosts/<id>"
4. POST ONE plan EVP (compact, <900 chars): "rite-cadence claimed (wave ${wave.name}, branch ${BRANCH}): PLAN — <the ghost's files + commit message from below, plus a 1-2 sentence digest of what the wave's implementer builds>. Gates: plan gate_cmds${backendWave ? ' + engine-appended migration-gate (+ pg-smoke) on the wave scratch DB' : ''}; then per-wave harden."
Ghosts:
${claimSpec}
Return {claimed:[ids], skipped:[ids], failures:[{ghost, error}], me_http,${ORG_ID ? ' me_org_id,' : ''} project_ids:[the DISTINCT .project_id values seen across ALL the ghosts above, the primary ghost's (${wave.primary_ghost_id}) first]}.`,
    { label: `claim:${wave.name}`, phase: 'claim', model: pin('sonnet'), schema: { type: 'object', additionalProperties: false, properties: { claimed: { type: 'array', items: { type: 'string' } }, skipped: { type: 'array', items: { type: 'string' } }, failures: { type: 'array', items: { type: 'object', additionalProperties: false, properties: { ghost: { type: 'string' }, error: { type: 'string' } }, required: ['ghost', 'error'] } }, me_http: { type: 'integer' }, me_org_id: { type: 'string' }, project_ids: { type: 'array', items: { type: 'string' } } }, required: ['claimed'] } },
  );
  if (!claim) log(`claim warn [${wave.name}]: claim agent died — build continues (tracker catch-up owed)`);
  else if ((claim.failures || []).length) log(`claim warn [${wave.name}]: ${claim.failures.map((f) => `${f.ghost}: ${f.error}`).join(' | ').slice(0, 200)}`);

  // 1a-i. THE CREDENTIAL IS A PRECONDITION, NOT A WARNING. Claimed ghosts are recorded BEFORE any
  // of the checks below so escalate()'s release step can undo whatever this agent managed to do.
  WAVE_CLAIMED = (claim && Array.isArray(claim.claimed) ? claim.claimed : []).map(String).filter(Boolean);
  // WHY HERE AND NOT AT SETUP: the engine has no shell of its own, so every check is an agent's
  // report. Asking setup "does the key file exist" asks for a self-reported fact about a path, and
  // the setup prompt has no auth line to run anyway. The claim stage already holds CREDS and
  // already calls GET /api/agent/me, so the honest observable is the HTTP CODE THAT CALL RETURNS:
  // it proves the key WORKS, not merely that a file was non-empty. A revoked key, a wrong-coven
  // key, and a value truncated by `awk -F=` at a base64 '=' all surface here as 401 — none of them
  // would move a byte-length check.
  const meHttp = claim && Number.isInteger(claim.me_http) ? claim.me_http : null;
  if (meHttp === 401 || meHttp === 403)
    return await escalate(wave, 'claim', credentialMessage(wave, meHttp), { pre_wave_sha: preSha, failure_code: 'talisman_unauthorized', credential_dead: true });
  // THE COVEN IS PART OF THE CREDENTIAL. With auth.prod.org_id set, a key that authenticates for a
  // different Coven is as dead as a revoked one: every claim, recall and exorcise would act on the
  // wrong organization. The engine compares the org the probe OBSERVED; a probe that reported none
  // is a recorded gap, never a pass.
  const meOrg = claim && typeof claim.me_org_id === 'string' ? claim.me_org_id.trim().toLowerCase() : '';
  if (ORG_ID && meHttp === 200 && meOrg && meOrg !== ORG_ID)
    return await escalate(wave, 'claim', wrongCovenMessage(wave, meOrg), { pre_wave_sha: preSha, failure_code: 'talisman_wrong_coven', credential_dead: true });
  if (ORG_ID && claim && meHttp === 200 && !meOrg) {
    noteSkip(wave.name, `coven check (claim agent reported no me_org_id) — the key was never proven to belong to Coven ${ORG_ID}`);
    log(`claim warn [${wave.name}]: no me_org_id reported — the key's Coven was never verified for this wave`);
  }
  // An agent that skipped the probe is NOT the same as one that ran it and got 200. Record the gap
  // on a channel a human reads (completed[].skipped_capabilities and the escalation payload)
  // rather than a log line, which is where this whole class of defect lived for three releases.
  if (claim && meHttp === null) {
    noteSkip(wave.name, 'credential probe (claim agent reported no me_http) — a later 401 will look like an API fault, not a config one');
    log(`claim warn [${wave.name}]: no me_http reported — the talisman was never verified for this wave`);
  } else if (claim && meHttp !== 200) {
    log(`claim warn [${wave.name}]: GET /api/agent/me returned ${meHttp} — not a credential rejection, continuing`);
  }
  // THE CONSEQUENCE THE ENGINE ALREADY COLLECTS. A key that authenticates can still be the wrong
  // coven or the wrong environment, and that reads as every single claim failing while the probe
  // says 200. Previously this was log-only, so such a wave built, committed and exorcised against
  // a tracker that had never heard of its ghosts. A PARTIAL failure stays a warning.
  if (claim && meHttp === 200 && !(claim.claimed || []).length && (claim.failures || []).length &&
      (claim.failures || []).length + ((claim.skipped || []).length) >= wave.ghosts.length)
    return await escalate(wave, 'claim', `the talisman authenticates (GET /api/agent/me → 200) but EVERY ghost claim failed: ${(claim.failures || []).map((f) => `${f.ghost}: ${f.error}`).join(' | ').slice(0, 300)} — a key for the wrong Coven or the wrong environment, or ghosts this Medium cannot see. Nothing was built.`, { pre_wave_sha: preSha, failure_code: 'claim_all_failed' });

  // 1a-bis. recall Imprints — the Coven's memory, OR-ed title words, once per distinct Haunting.
  // Its OWN best-effort agent: a recall-shape miss must never take the tracker claim down with it.
  // Every outcome is logged LOUDLY; an empty or failed recall never blocks the build.
  // TWO AXES, TWO CALLS. See mechanismQuery: ts_rank has no IDF, so merging the vocabularies into
  // one query lets generic title words outrank the one rare mechanism term at ANY limit. Each axis
  // gets its own top-N quota instead.
  const RECALL_TERMS = capTerms(recallTerms(wave));
  const RECALL_Q = RECALL_TERMS.join(' OR ');
  const RECALL_Q_MECH = mechanismQuery(wave, RECALL_TERMS);
  // An EMPTY query is not a narrow query: the server maps "" to None (schemas/memory.py) and returns
  // the NEWEST Imprints at match 1.0, which would render as hits. A wave that declares no files has
  // no mechanism axis, so that call is simply not emitted.
  const RECALL_AXES = [['feature', RECALL_Q], ['mechanism', RECALL_Q_MECH]].filter((a) => !!a[1]);
  const RECALL_QUERIES = { feature: RECALL_Q, mechanism: RECALL_Q_MECH };
  const RECALL_PROJECTS = (claim && Array.isArray(claim.project_ids) ? claim.project_ids : []).map(String).filter(Boolean);
  WAVE_PROJECTS = RECALL_PROJECTS; // hoisted copy: escalate()'s writeback needs the scope rule
  let recallBlock = '';
  if (!RECALL_AXES.length) { WAVE_RECALL = { status: 'skipped-no-query', queries: RECALL_QUERIES, by_query: { feature: [], mechanism: [] }, imprint_ids: [] }; log(`recall SKIPPED [${wave.name}]: neither axis produced a query (no title words, no declared files) — an empty query returns the newest Imprints, not a match`); }
  else {
    const rec0 = await tryAgent(
      `${CREDS}
${common(wave, 'recall')}
RECALL this Coven's Imprints (memory records) for the wave's ghosts. Read-only; safe to repeat; do NOT write anything.
${RECALL_PROJECTS.length ? `Project ids (distinct, primary first): ${RECALL_PROJECTS.join(', ')}` : `First: curl -s -H "$AUTH" -H "$GH_CLIENT" "$API/api/agent/ghosts/${wave.primary_ghost_id}" — read .project_id (the claim stage reported none).`}
There are ${RECALL_AXES.length} SEPARATE recall call(s) per project — they use DIFFERENT queries on purpose and must NEVER be merged into one call. For EACH project id run EACH of these EXACTLY (substitute the id in BOTH places; every query string is fixed — copy it verbatim):
${RECALL_AXES.map(([axis, q]) => `  ${axis}: curl -s -X POST -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '${JSON.stringify({ query: q, project_id: '<project id>', limit: 5 })}' -o /tmp/recall.${SLUG}.w${wi}.${axis}.<project id>.json -w '%{http_code}' "$API/api/agent/imprints/recall"`).join('\n')}
Then shape EACH response with jq (this bounds what you paste and keeps it byte-faithful):
  jq -c '[.items[]? | {id, memory_type, scope, title, content: ((.content // "")[0:${RECALL_CONTENT_MAX}]), source_task_title: (.source_task_title // "")}]' <that axis's file for that project>
Return ONE array PER AXIS, each the union across projects of that axis's arrays (dedupe by id WITHIN an axis; do NOT dedupe across axes and do NOT concatenate the axes — the engine merges them):
${RECALL_AXES.map(([axis]) => `  recalled_${axis} = the union of the ${axis} calls`).join('\n')}${RECALL_AXES.length < 2 ? `\n  (the other axis has no query this wave — return it as [] or omit it)` : ''}
Paste items as-is, with ONLY these six fields per item (never relevance or anything else — the schema rejects extra keys).
recall_status, in this precedence: "ok" when at least one call returned items (even if another call failed — then ALSO set recall_error naming the failed project and axis); "empty" when every call returned 2xx with items: []; "failed" only when NO call returned items and at least one call returned a non-2xx or a body with no .items array. recall_error = "HTTP <code> <axis> <project id> " + the output of: [ -s <that file> ] && jq -r '(.detail.error_code? // .detail // "no body") | tostring' <that file> || echo "empty body" — an HTTP code of 000 means the connection itself failed. Never a 401/426 silently: those are Talisman / client-version problems worth their own words.`,
      { label: `recall:${wave.name}`, phase: 'claim', model: pin('sonnet'), schema: RECALL_RESULT },
    );
    if (!rec0) { WAVE_RECALL = { status: 'agent-died', queries: RECALL_QUERIES, by_query: { feature: [], mechanism: [] }, imprint_ids: [] }; log(`recall SKIPPED [${wave.name}]: recall agent died — building WITHOUT the Coven's memory`); }
    else {
      // Use whatever came back regardless of status: a partial failure (one Haunting 5xx'd) must
      // not throw away the other Haunting's hits.
      const featItems = Array.isArray(rec0.recalled_feature) ? rec0.recalled_feature : [];
      const mechItems = Array.isArray(rec0.recalled_mechanism) ? rec0.recalled_mechanism : [];
      const merged = interleaveRecalled(featItems, mechItems);
      recallBlock = formatRecall(merged);
      const ids = (a) => a.map((r) => r && r.id).filter(Boolean);
      // Per-axis attribution, not just a count: without it nobody can answer afterwards whether the
      // mechanism axis earned its call, which is the whole question this change was made to settle.
      WAVE_RECALL = { status: rec0.recall_status || 'unknown', queries: RECALL_QUERIES, by_query: { feature: ids(featItems), mechanism: ids(mechItems) }, imprint_ids: ids(merged) };
      if (rec0.recall_status === 'failed' || rec0.recall_error) log(`recall ${recallBlock ? 'PARTIAL' : 'SKIPPED'} [${wave.name}]: ${String(rec0.recall_error || 'recall failed').slice(0, 200)}${recallBlock ? '' : ' — building WITHOUT the Coven\'s memory'}`);
      if (recallBlock) log(`recall [${wave.name}]: ${merged.length} imprint(s) from ${RECALL_PROJECTS.length || 1} project(s) → build + harden prompts | feature[${ids(featItems).map((x) => String(x).slice(0, 8)).join(' ')}] mechanism[${ids(mechItems).map((x) => String(x).slice(0, 8)).join(' ')}]`);
      else if (rec0.recall_status !== 'failed') log(`recall empty [${wave.name}]: nothing recorded for these terms`);
    }
  }

  // 1b. scratch DB (backend waves): the engine provisions AND migrates it — see
  // provisionScratchDb. drop→create = fresh AND idempotent on resume/crash; pre_head anchors
  // reversibility and is validated by shape before this wave is allowed to proceed.
  let dbUrl = '';
  let dbName = '';
  let smokeUrl = '';
  let smokeDbName = '';
  let preHead = '';
  let waveDbNames = [];
  if (backendWave) {
    const dbSlug = `${DB_NS}w${wi}`;
    const prov = await provisionScratchDb(dbSlug, wave, 'db-provision');
    if (!prov.ok) return await escalate(wave, 'db-provision', prov.reason, { pre_wave_sha: preSha, failure_code: prov.failure_code, failed_step: prov.failed_step, db_names: prov.dbNames });
    dbUrl = prov.dbUrl;
    smokeUrl = prov.smokeUrl;
    smokeDbName = prov.smokeDbName;
    waveDbNames = prov.dbNames;
    dbName = dbFull(dbSlug);   // engine-computed, never an agent-supplied string: this name reaches DROP DATABASE at cleanup
    preHead = prov.preHead;
    // Refuse early and actionably rather than letting the gate stage discover it — but ONLY when
    // the old script would genuinely refuse. A pre-PG_SMOKE_SCRATCH copy simply IGNORES the env
    // var and falls back to its `_test$` rule, which PASSES for a single-DB repo whose `url`
    // already returns the _test database. Escalating there would be a confident wrong diagnosis
    // ("your gate script is stale") for a wave that would have run perfectly — the same
    // false-positive class this release exists to eliminate. Silently SKIPPING pg-smoke is never
    // an option either: that re-creates the dead gate.
    if (PG_SMOKE && !prov.pgSmokePresent)
      return await escalate(wave, 'db-provision', `the gate script ${WT}/${PG_SMOKE} does not exist in this worktree, so the genuine-Postgres smoke gate cannot run. isolation.pg_smoke is configured, so skipping it is not an option. Fix: /ghost-sync on the main checkout, commit, then copy scripts/pg-smoke.sh into this worktree (or recreate the worktree from the refreshed main).`, { pre_wave_sha: preSha, failure_code: 'stale_worktree_gate_script' });
    if (PG_SMOKE && !prov.pgSmokeScratchOk) {
      if (!/_test$/.test(prov.smokeDbName))
        return await escalate(wave, 'db-provision', `the worktree's gate script ${WT}/${PG_SMOKE} predates PG_SMOKE_SCRATCH, so it will apply its legacy "*_test only" rule to this wave's scratch DB ("${prov.smokeDbName}") and exit 4 on every gate run. The engine is pinned to the MAIN checkout but gate commands run the WORKTREE's scripts, so a worktree branched from an older main carries the stale copy. Fix: /ghost-sync on the main checkout, commit, then copy scripts/pg-smoke.sh into this worktree (or recreate the worktree from the refreshed main).`, { pre_wave_sha: preSha, failure_code: 'stale_worktree_gate_script' });
      noteSkip(wave.name, `pg-smoke ran from a STALE worktree copy of ${PG_SMOKE} (accepted only because this wave's DB ends in _test)`);
      log(`pg-smoke note [${wave.name}]: the worktree's ${PG_SMOKE} predates PG_SMOKE_SCRATCH, but this wave's smoke DB ("${prov.smokeDbName}") ends in _test, so its legacy guard accepts it and the gate still runs. Re-sync when convenient.`);
    }
  }

  // Effective gate list: {{db_url}} injected; backend waves ALWAYS get the engine-owned
  // migration drift gate (+ pg-smoke when configured) appended (a misclassified model edit must
  // go red, not silent). This exact list is also what harden re-runs after its fixes.
  const effectiveGates = (wave.gate_cmds || []).map((c) => String(c).split('{{db_url}}').join(dbUrl));
  // Index of the FIRST engine-appended gate: everything from here on is the engine's own, and its
  // exit code is checked in JS (Fix C) rather than trusted to the gate agent's `green` verdict.
  const engineGateFrom = effectiveGates.length;
  if (backendWave) {
    // pg-smoke runs against the BASE url — the alembic-migrated database. NOT the _test sibling:
    // a pytest conftest typically rebuilds that one with DROP SCHEMA + Base.metadata.create_all,
    // which would make this gate compare the ORM against a schema built from that same ORM — a
    // tautology that can never fail. PG_SMOKE_SCRATCH tells the gate this is an engine-owned
    // scratch DB BY NAME (an assertion the gate re-checks), since the base name carries no _test suffix.
    if (PG_SMOKE) effectiveGates.push(`PG_SMOKE_SCRATCH=${smokeDbName} DATABASE_URL="${smokeUrl}" "${WT}/${PG_SMOKE}"`);
    else { noteSkip(wave.name, 'pg-smoke (isolation.pg_smoke unset — no genuine-Postgres ORM smoke gate)'); log(`pg-smoke SKIP [${wave.name}]: isolation.pg_smoke not configured — the genuine-Postgres ORM smoke gate is not appended`); }
    effectiveGates.push(`DATABASE_URL="${dbUrl}" "${WT}/${MIGRATION_GATE}"`);
  }

  // 2. build (parallel implementers, disjoint owned files, edit-only)
  phase('build');
  const migrationNote = wave.migration
    ? `\nMIGRATION WAVE: you are this wave's ONLY implementer and will produce Alembic migration file(s) under the repo's migrations versions/ directory (e.g. backend/migrations/versions/ or backend/alembic/versions/) — these are deliberately NOT in your declared list. Number them off the LIVE head of THIS worktree (list the versions/ dir; read the head's revision id) — NEVER a number from the plan or ghost payload (those go stale). Set down_revision to the live head. Do NOT run the migration CLI's create/revision against any dev database — hand-write the migration (clone the template the ghost names) or generate against the scratch DB only.`
    : '';
  const dbNote = backendWave
    ? `\nScratch DB for this wave (yours alone): DATABASE_URL="${dbUrl}"${TEST_BACKEND ? ` — run backend tests with: cd "${WT}" && DATABASE_URL="${dbUrl}" TIMEOUT_SECS=1500 ${TEST_BACKEND}` : ''} (NOTE the pytest suite may itself be hermetic sqlite; the scratch DB is already migrated to head for you).`
    : '';
  const builds = await parallel(
    wave.implementers.map((imp) => () =>
      tryAgent(
        `${common(wave, 'build')}
${recallBlock ? recallBlock + '\n' : ''}BUILD — implementer "${imp.label}". You OWN exactly these files (create if new): ${(imp.files || []).join(', ')}${migrationNote}${dbNote}
Rules: edit ONLY your owned files; do NOT run git; do NOT run repo-wide auto-fixers (eslint --fix / prettier / ruff format); do NOT commit; do NOT touch any file outside your set (another implementer owns it).
TASK: ${imp.prompt}
Return {ok:true only if you completed AND touched only owned files, changed_files (EVERY file you created or modified, as REPO-RELATIVE paths — honesty here is the ownership check's input), note, learnings: up to 3 DURABLE, NON-OBVIOUS facts about this repo you learned the hard way while building (a trap, a house convention, an environment truth) — 1-3 sentences each, up to ~1000 chars, and SAY THE FIX, not just the symptom: "X is stale after Y — call Z first, and capture the ids before you do" is worth writing down, "watch out for X" is not. Or [] when nothing durable; never progress notes, never decisions}.`,
        { label: `build:${wave.name}:${imp.label}`, phase: 'build', model: pin('fable'), schema: BUILD, effort: 'xhigh' },
      ),
    ),
  );
  // Implementer learnings are captured BEFORE the ok-check: a failed build's learnings ride the
  // escalation payload (escalate() reads WAVE_LEARNINGS) — the attempts that fail teach the most.
  // LEARNING_MAX is 1200, not 300. Measured on the 2026-09-05 Wiki Structure waves: the six
  // learnings were 219/300/300/300/300/300 chars — five of six cut MID-WORD, and the tails held
  // the actionable half ("...call expire_all(), and capture any ids you still need BEFORE
  // expiring"). A human had to reopen the build transcripts to write the Imprints. The server's
  // Imprint content cap is 2000, so 300 was never a downstream constraint — just a stray slice.
  // A dead implementer contributes a MARKER, not silence: "(no learnings — implementer died)" is
  // a different fact from "this build learned nothing", and the writeback must be able to tell.
  WAVE_LEARNINGS = builds.flatMap((b, i) =>
    b
      ? (Array.isArray(b.learnings) ? b.learnings : []).slice(0, 3).map((l) => `[${wave.implementers[i].label}] ${String(l).slice(0, LEARNING_MAX)}`)
      : [`[${wave.implementers[i].label}] (no learnings — implementer died before returning)`],
  );
  const learnings = WAVE_LEARNINGS;
  if (builds.some((b) => !b || !b.ok)) {
    const bad = wave.implementers.filter((_, i) => !builds[i] || !builds[i].ok).map((imp) => imp.label);
    return await escalate(wave, 'build', `implementer(s) failed or returned null: ${bad.join(', ')}`, { pre_wave_sha: preSha, db_name: dbName });
  }

  // 2b. ownership: porcelain ground truth + pure-JS verdict (hard-fail on backend waves).
  phase('ownership');
  const truth = await tryAgent(
    `${common(wave, 'ownership-truth')}
Report the REALIZED working-tree delta. Run EXACTLY: git -C ${WT} status --porcelain=v1 -uall
(-uall is load-bearing: bare porcelain hides files inside new directories as "dir/").
Return paths = one entry per line: strip the two status chars + space; for renames ("R  old -> new") return the NEW path; strip any surrounding double-quotes git adds for special chars; include deleted files' paths. No commentary, no filtering.`,
    { label: `ownership:${wave.name}`, phase: 'ownership', model: pin('sonnet'), schema: REALIZED },
  );
  if (!truth || !Array.isArray(truth.paths)) return await escalate(wave, 'ownership', 'ownership truth agent failed to report porcelain paths', { pre_wave_sha: preSha, db_name: dbName });
  const realized = relPaths(truth.paths); // porcelain is already repo-relative; normalize for one path form
  const realizedMig = realized.filter((p) => MIGRATION_RUNTIME_RE.test(p));
  const verdict = ownershipVerdict(wave, realized, builds, realizedMig);
  verdict.warns.forEach((w) => log(`ownership warn [${wave.name}]: ${w}`));
  if (verdict.hard.length) return await escalate(wave, 'ownership', verdict.hard.join(' | '), { pre_wave_sha: preSha, db_name: dbName, realized });
  const migAllowed = new Set(realizedMig);
  if (wave.migration && !realizedMig.length) log(`ownership warn [${wave.name}]: migration wave realized NO migration file — the drift gate will judge whether one was actually needed`);

  // 3. integration gate
  phase('gate');
  const gate = await tryAgent(
    `${common(wave, 'gate')}
INTEGRATION GATE. All implementers' edits are in the working tree, UNCOMMITTED. Do NOT commit.${baselineBlock()}${inheritedGateBlock(wave)}
${backendWave && DB_MIGRATE ? `Step 0 (backend wave): bring the scratch DB to this tree's head first: DATABASE_URL="${dbUrl}" "${WT}/${DB_MIGRATE}" upgrade (idempotent; applies any migration this wave just wrote).\n` : ''}${wave.integration_gate_prompt ? wave.integration_gate_prompt + '\n' : 'Re-bake/compile any generated artifacts the contract requires, then:'}
Run these gates and make them GREEN (fix ONLY in-scope reds):
${effectiveGates.map((c, i) => `  gate[${i}]: ${c}`).join('\n')}
EXECUTION DISCIPLINE (hard rules — long-running gate agents get killed by the harness): run each gate command as ONE foreground Bash call with an EXPLICIT tool-call timeout of 600000 ms (10 min — the default 2 min is shorter than the suite; the test runner also carries its own TIMEOUT_SECS watchdog). NEVER background-and-poll, no monitors, no sleep loops, no process-tree inspection. Budget yourself ~15 tool calls total: step 0 (if any) → gate[0] → gate[1] → … → appended gates → return. The moment all gates are green, return your structured result IMMEDIATELY — no extra investigation, re-verification, or summarizing beyond the required fields.
Also run any byte-gate / determinism checks the contract names (frozen artifacts stay byte-identical).
${backendWave ? `MIGRATION DISCIPLINE: you may NEVER create a new database migration (the migration CLI create/revision and hand-writing under the migrations versions/ directory are both FORBIDDEN in this stage). ${wave.migration ? 'You may minimally FIX the migration file this wave already produced.' : 'If migration-gate reports schema drift in this NON-migration wave, that is a wave-classification failure: return green:false with notes "schema-drift-misclassified-wave" — do not paper over it.'}\n` : ''}Return {green, notes (suite totals + any fix you made), changed_files (EVERY file you touched), gate_exits}.
gate_exits is MANDATORY and is a record of FACT, not judgment: one {index, exit_code} entry for EVERY gate above, reporting the process exit status of its FINAL run verbatim. Report a nonzero exit even when you believe the gate is irrelevant, misconfigured, or refused to run — the engine decides what a nonzero means, and a gate you omit is treated as failed.
ON ANY NONZERO GATE you MUST also set that entry's \`failures\`: EVERY failing test id from that gate's final run, in the exact form the suite prints it (pytest "path/to/test_x.py::test_y", the frontend runner "file > test name"). This is the same kind of fact as the exit code, not a judgment — list what failed, and let the engine decide whether it is inherited. Do NOT summarize, do NOT abbreviate a second id to "::name" continuation form, and do NOT put the ids only in notes: the engine reads \`failures\`, never prose. A nonzero gate whose entire failures list is BASELINE-RED is excused by the engine; a nonzero gate with NO failures list BLOCKS the wave even when you believe it is inherited, and so does one naming a single id outside BASELINE-RED. If a gate is nonzero for a reason with no test ids at all (a linter, a refused-to-run script, a compile error), report the nonzero exit and leave \`failures\` off — that is a real blocker and must stop the wave, UNLESS it is listed above as an INHERITED-RED GATE.`,
    { label: `gate:${wave.name}`, phase: 'gate', model: pin('opus'), schema: GATE_RESULT, effort: 'xhigh' },
  );
  if (!gate) return await escalate(wave, 'gate', 'integration gate agent died', { pre_wave_sha: preSha, db_name: dbName });
  // Fix C — gates are verified by observed exit code, never by the agent's `green`. pg-smoke
  // exited 4 (guard refusal) on every backend wave in one consumer repo while this stage kept
  // returning green:true, so the schema gate that repo relies on had been dead for months. A gate
  // that refused to run must never read as a gate that passed.
  //
  // EVERY gate index, on EVERY track. This used to start at engineGateFrom, so the exit codes of
  // the PLAN's own gate_cmds — the wave's actual test suite and linters — were collected by the
  // schema and then never looked at, and a FRONTEND wave had no exit code checked at all: its
  // entire verdict was the agent's boolean. The doctrine in the comment above never had a reason
  // to stop at the engine's own gates; only the loop bound did.
  {
    const exits = new Map((gate.gate_exits || []).map((e) => [e.index, e]));
    const bad = [];
    for (let gi = 0; gi < effectiveGates.length; gi++) {
      const entry = exits.get(gi);
      const code = entry ? entry.exit_code : undefined;
      const who = gi >= engineGateFrom ? 'engine-appended ' : '';
      if (code === undefined) bad.push(`${who}gate[${gi}] (${effectiveGates[gi].slice(0, 80)}) — NO exit code reported`);
      else if (code !== 0) {
        // A nonzero gate whose ENTIRE reported failure set is inherited baseline-red is excused
        // -- and never silently: an excusal is a decision the operator must be able to audit in
        // the journal, so it is logged with the ids that bought it.
        //
        // ENGINE-APPENDED GATES ARE NEVER EXCUSABLE. pg-smoke and migration-gate are schema and
        // smoke checks; they cannot legitimately fail on a test id, so a failures[] list attached
        // to one is either a mistake or a laundering attempt. Excusing them would resurrect the
        // exact defect Fix C was written for -- pg-smoke exited 4 on every backend wave in one
        // consumer repo while this stage kept returning green, and the schema gate that repo
        // relied on had been dead for months. Only the PLAN's own gates can hold test ids.
        // The RAW gate text is the comparable one: effectiveGates[gi] has this wave's own scratch
        // DB substituted into {{db_url}}, so two waves running the identical command hold
        // different strings. wave.gate_cmds[gi] and BASELINE_RED_GATES are both pre-substitution.
        const rawGate = gi < engineGateFrom ? String((wave.gate_cmds || [])[gi]) : null;
        // INHERITED-RED GATE: this exact command was already nonzero on the untouched base and
        // named no test id there. A gate that could never pass is not evidence about this wave.
        // It is excused ONLY while it still names no ids — the moment it reports a failing test,
        // that is new information the probe never saw, and the baseline-red path below owns it.
        if (rawGate !== null && BASELINE_RED_GATES.includes(rawGate) && couldBeInheritedRed(code, entry.failures)) {
          const line = `inherited-red gate [${wave.name}]: gate[${gi}] exited ${code} at the base too (no test ids) — not blocking`;
          log(line);
          WAVE_WARNINGS.push(line);
          if (!WAVE_INHERITED_RED_GATES.includes(rawGate)) WAVE_INHERITED_RED_GATES.push(rawGate);
        }
        else if (gi < engineGateFrom && baselineExcuses(entry.failures, BASELINE_RED))
          log(`baseline-red excusal [${wave.name}]: ${who}gate[${gi}] exited ${code}, and every failure it named is inherited: ${entry.failures.join(' | ')}`);
        else {
          const named = (entry.failures || []).length;
          const why = gi >= engineGateFrom && named
            ? ' (an engine-appended gate is NEVER excused as baseline-red — it cannot fail on a test id)'
            : named
              ? ` (reported failures are not all baseline-red: ${entry.failures.join(' | ')})`
              : rawGate !== null && !ranAndReported(code)
                ? ` (exit ${code} means the gate never RAN — missing, not executable, killed, or not attempted; a gate that did not run is never excused as inherited-red)`
              : BASELINE_GATES_MEASURED && rawGate !== null && BASELINE_GREEN_GATES.includes(rawGate)
                ? ' (this gate was GREEN on the untouched base, so its red is this wave\'s)'
                : BASELINE_RED.length
                  ? ' (no failures[] reported — a nonzero gate must NAME its failing tests to be excused as baseline-red)'
                  : '';
          bad.push(`${who}gate[${gi}] (${effectiveGates[gi].slice(0, 80)}) — exit ${code}${why}`);
        }
      }
    }
    if (bad.length) return await escalate(wave, 'gate', `gate(s) did not pass${gate.green ? ' despite green:true' : ''} — ${bad.join(' | ')}`, { pre_wave_sha: preSha, db_name: dbName, failure_code: 'engine_gate_nonzero' });
    // The agent's verdict is NOT overridden here, deliberately. It is told above that an
    // inherited-red gate does not count against `green`, so an obedient agent returns green:true
    // and the excusal above handles the exit code. A green:false that arrives anyway may be about
    // something no gate covers — the re-bake/determinism checks this prompt also asks for have no
    // gate_exits entry at all — and an excused linter is red on EVERY wave in some repos, so
    // "there was an excusal" can never be evidence that the verdict was ABOUT that excusal.
    // Escalating a disobedient green:false is a false escalation: the safe failure.
    if (!gate.green) return await escalate(wave, 'gate', gate.notes || 'integration gate not green', { pre_wave_sha: preSha, db_name: dbName });
  }
  const gateFiles = relPaths(gate.changed_files);
  const gateMinted = newMigrations(gateFiles, migAllowed);
  if (gateMinted.length) return await escalate(wave, 'gate', `gate stage minted new migration file(s): ${gateMinted.join(', ')} (forbidden — misclassified wave or runaway fix)`, { pre_wave_sha: preSha, db_name: dbName });

  // 4. per-ghost commit (rc-aware atomic loop, Blocker D). Runtime-detected migration files are
  // committed under the PRIMARY ghost (declared migration paths are banned, so this is their
  // ONLY route into a commit — never the reconcile sweep).
  phase('commit');
  const commitSpec = wave.ghosts
    .map((g) => {
      const files = (g.files || []).slice();
      if (wave.migration && g.id === wave.primary_ghost_id) for (const m of realizedMig) if (!files.includes(m)) files.push(m);
      return `- ghost ${g.id}: --files "${files.join(' ')}" --message ${JSON.stringify(g.commit_message || g.title || g.id)}${g.commit_body ? ' --body ' + JSON.stringify(g.commit_body) : ''}`;
    })
    .join('\n');
  const commit = await tryAgent(
    `${common(wave, 'commit')}
COMMIT each ghost SEPARATELY, in this exact order (stage ONLY that ghost's --files):
${commitSpec}
${commitHowto}
Return {ok, shas:[{ghost, sha}], reason}.`,
    { label: `commit:${wave.name}`, phase: 'commit', model: pin('sonnet'), schema: COMMIT_RESULT },
  );
  if (!commit || !commit.ok) return await escalate(wave, 'commit', (commit && commit.reason) || 'a per-ghost commit failed', { pre_wave_sha: preSha, db_name: dbName, committed_shas: (commit && commit.shas) || [] });
  WAVE_COMMITS = commit.shas || [];

  // 5. reconcile to a clean tree (Blocker B)
  phase('reconcile');
  const rec = await tryAgent(
    `${common(wave, 'reconcile')}
RECONCILE — nothing may be left uncommitted (a stray file would gate-lie in harden).
1. leftover = git -C ${WT} status --porcelain=v1 -uall (modified/untracked, NOT yet committed).
2. If ANY leftover path is a migration file (under an alembic/ or migrations/ versions/ directory) — STOP: commit NOTHING, return clean:false, reason "unexpected-migration-leftover: <paths>" (a migration outside the commit stage's control must reach a human, never a sweep).
3. Otherwise, if leftover is non-empty, these are build/gate-touched files not in any ghost's --files (e.g. generated art / compiled JSON). Commit them ALL under the primary ghost:
   ${commitCmd(wave.primary_ghost_id, '<all leftover paths>', wave.name + ': sweep generated/undeclared artifacts')}
   FLAG (in "flagged") any leftover path that looks like hand-written SOURCE rather than a generated artifact — that means an implementer edited outside its declared files; the human should know.
4. HARD ASSERT: git -C ${WT} status --porcelain is now EMPTY → clean:true. Else clean:false, reason.
Return {clean, swept, flagged, reason}.`,
    // opus: the hand-written-source-vs-generated-artifact judgment feeds the human `flagged`
    // channel — worth the tier above the other mechanical stages.
    { label: `reconcile:${wave.name}`, phase: 'reconcile', model: pin('opus'), schema: RECONCILE },
  );
  if (!rec || !rec.clean) return await escalate(wave, 'reconcile', (rec && rec.reason) || 'tree not clean after reconcile', { pre_wave_sha: preSha, db_name: dbName, flagged: relPaths(rec && rec.flagged) });
  const sweptMinted = newMigrations(relPaths(rec.swept).concat(relPaths(rec.flagged)), migAllowed);
  if (sweptMinted.length) return await escalate(wave, 'reconcile', `migration file(s) rode the reconcile sweep: ${sweptMinted.join(', ')} (must never happen — the prompt-level refusal was bypassed)`, { pre_wave_sha: preSha, db_name: dbName });

  // 5b. migration reversibility — POST-COMMIT (new alembic files are untracked pre-commit,
  // invisible to `git diff --diff-filter=A`). Downgrade to the recorded pre-wave head — NEVER a
  // bare step count ("downgrade 1" reads as revision id "1" and fails deterministically).
  // Fires only for migration waves AND only when the migration CLI is configured.
  async function runReversibility(tag) {
    // tryAgent, not agent: this was the ONE agent call in the file without harness-death
    // containment, and it sits at the worst possible point — the ghosts are already committed and
    // active_haunt. A throw here escaped the workflow entirely: no escalate(), no EVP, no payload,
    // no scratch_dbs, no pre_wave_sha. Pure hand-reconstruction from git archaeology. The caller
    // already treats null as failure ("!rev || !rev.ok"), so this only changes a crash into the
    // escalation the crash should always have been.
    return tryAgent(
      `${common(wave, 'reversibility')}
MIGRATION REVERSIBILITY (post-commit roundtrip against this wave's scratch DB). This wave's migration file(s): ${realizedMig.join(', ') || '(none detected)'}. Steps, in order:
1. If NO migration file was realized: return {ok:true, skipped:true, migrations:[]} (nothing to roundtrip; the drift gate already vouched).
2. DATABASE_URL="${dbUrl}" "${WT}/${DB_MIGRATE}" upgrade   (ensure at head)
3. DATABASE_URL="${dbUrl}" "${WT}/${DB_MIGRATE}" downgrade ${preHead}   (down to the recorded pre-wave head revision)
4. DATABASE_URL="${dbUrl}" "${WT}/${DB_MIGRATE}" upgrade   (back to head)
5. DATABASE_URL="${dbUrl}" "${WT}/${MIGRATION_GATE}"   (post-roundtrip single-head + drift check)
ALL rc 0 → ok:true with migrations = this wave's migration file(s). Any red → ok:false, reason = the failing step + stderr tail. Do NOT edit any file; report only.`,
      { label: `reversibility:${wave.name}${tag}`, phase: 'reversibility', model: pin('sonnet'), schema: REVERSIBILITY },
    );
  }
  if (wave.migration) {
    if (!DB_MIGRATE) {
      noteSkip(wave.name, 'migration reversibility (isolation.db_migrate unset — the downgrade/upgrade roundtrip was NOT proven)');
      log(`reversibility SKIP [${wave.name}]: isolation.db_migrate not configured — the migration is committed and drift-gated, but the downgrade/upgrade roundtrip was NOT proven`);
    } else {
      // RESUME TRAP: the engine now migrates the scratch DB to the TREE's head during provisioning.
      // On a resume_from of a wave whose migration already landed in the tree, that head IS this
      // wave's own migration — so pre_head anchors to it and "downgrade <pre_head>" is a no-op that
      // proves nothing while reporting green. Refuse rather than launder it.
      if (preHead && revisionOwnedBy(preHead, realizedMig))
        return await escalate(wave, 'reversibility', `pre_head "${preHead}" is this wave's OWN migration (${realizedMig.join(', ')}) — the scratch DB was provisioned from a tree that already contains it (resume?), so the downgrade roundtrip would be a no-op. Re-run this wave from a pre-migration tree, or drop the scratch DBs and resume from the previous wave.`, { pre_wave_sha: preSha, db_name: dbName, committed_shas: commit.shas, pre_head: preHead, failure_code: 'pre_head_is_own_migration' });
      phase('reversibility');
      const rev = await runReversibility('');
      if (!rev || !rev.ok) return await escalate(wave, 'reversibility', (rev && rev.reason) || 'migration reversibility roundtrip failed', { pre_wave_sha: preSha, db_name: dbName, committed_shas: commit.shas, pre_head: preHead });
    }
  }

  // THE MEMORY LINE. Everything above is proven: the ghosts are committed, the integration gate
  // was green, reconcile left the tree clean, and a migration wave's downgrade/upgrade roundtrip
  // held. From here on, an escalation means harden's FIX SET is in doubt — not the wave's own
  // work — so escalate() may safely distil this wave's learnings into the Coven's memory.
  WAVE_BUILD_PROVEN = true;

  // 6. harden (child workflow — the adversarial review→fix gem). Receives the EFFECTIVE gate
  // list (db_url injected + engine-appended smoke/drift gates) so its fixer/gate re-run the
  // same bar, plus the baseline and the no-new-migrations discipline.
  phase('harden');
  // .catch → null: a child-workflow throw (script error, harness death inside harden) must
  // degrade to the escalate path below, never kill this run.
  const hard = await workflow(
    HARDEN_REF,
    Object.assign(
      // Forward the remap to the child: harden resolves its OWN pins from
      // args.finder_model/fixer_model/gate_model, so without this an operator who sets
      // models.remap still silently gets the old tier on the adversarial review — the last
      // place you want an unnoticed downgrade. wave.harden still wins over both.
      // context_notes: the wave's RECALLED IMPRINTS block ('' when the recall was empty/skipped).
      // allowed_files: the engine's ownership allow-set, so harden's fixer/gate flag out_of_range
      // against the SAME set hardenVerdict gates on (declared ∪ this wave's migration ∪ swept).
      // strict_range: on a backend wave an out-of-range fix is a HARD escalate here, so telling
      // the fixer to make it and flag it guarantees a stop we then blame it for. Under
      // strict_range it DEFERS instead — records the exact edit needed and moves on — so the wave
      // lands and the deferred item reaches the commit body, the EVP and completed[]. Frontend
      // waves keep commit-and-flag (the house hard/warn split), so they pass false.
      // test_path_re: ONE definition of "test file", shared, instead of this engine's regex and
      // the fixer's guess.
      // engine_gate_from: harden re-runs this SAME list, so it needs the same boundary — below it
      // are the plan's own suites (which can hold an inherited red), at and above it the engine's
      // pg-smoke/migration-gate (which never can, and must never be excused by a failures list).
      { worktree_path: WT, range: `${preSha}..HEAD`, contract_path: CONTRACT, gate_cmds: effectiveGates, engine_gate_from: engineGateFrom, baseline_red: BASELINE_RED, baseline_red_gates: (wave.gate_cmds || []).map((c, i) => (WAVE_INHERITED_RED_GATES.includes(String(c)) ? i : -1)).filter((i) => i >= 0), no_new_migrations: true, context_notes: recallBlock, strict_range: backendWave, test_path_re: TEST_PATH_SOURCE, allowed_files: Array.from(declaredSet(wave)).concat(Array.from(migAllowed), relPaths(rec.swept), relPaths(rec.flagged)) },
      pin('fable') !== 'fable' ? { finder_model: pin('fable'), fixer_model: pin('fable'), gate_model: pin('fable') } : {},
      pin('opus') !== 'opus' ? { verifier_model: pin('opus') } : {},
      // wave.harden is PLAN-authored — an agent wrote it — and is merged LAST so it still wins for
      // everything a plan legitimately tunes (model pins, min_finders, stall_ms). The SAFETY args
      // are engine-owned and stripped here: gate_cmds/engine_gate_from/baseline_red_gates are a
      // matched set (the latter two are INDICES into the former, so overriding any one of them
      // points the others at the wrong command), and allowed_files/strict_range/range are the
      // ownership boundary harden's verdict is gated on. A plan that could set baseline_red_gates
      // could excuse every gate in harden — precisely the laundering the rest of this file exists
      // to refuse. Stripping is LOUD: a plan asking for one is told it was ignored.
      (() => {
        const h = { ...(wave.harden || {}) };
        const ENGINE_OWNED = ['worktree_path', 'range', 'contract_path', 'gate_cmds', 'engine_gate_from', 'baseline_red', 'baseline_red_gates', 'no_new_migrations', 'allowed_files', 'strict_range', 'test_path_re', 'context_notes'];
        const taken = ENGINE_OWNED.filter((k) => k in h);
        taken.forEach((k) => delete h[k]);
        if (taken.length) log(`harden warn [${wave.name}]: ignoring engine-owned wave.harden key(s) ${taken.join(', ')} — these are the gate list, its indices and the ownership boundary, and a plan cannot set them`);
        return h;
      })(),
    ),
  ).catch((e) => {
    log(`harden child died: ${String((e && e.message) || e).slice(0, 160)}`);
    return null;
  });

  if (!hard || !hard.green) {
    // hard.aborted === true means harden never completed its review (finders died) — the wave is
    // UNREVIEWED, not merely red. Surface that distinction in the escalation instead of letting it
    // read like an ordinary failed fix.
    const why = !hard
      // A null child is a CRASH, not a review that found problems. Previously it fell into the
      // generic branch and read as "harden did not return green", while harden_aborted:false in
      // the payload actively claimed harden had completed a review it never started.
      ? 'harden CHILD WORKFLOW CRASHED — no review happened at all; the range is UNREVIEWED and any tree edits are unattributed'
      : hard.aborted
        ? `harden ABORTED without reviewing this wave: ${hard.reason || 'finder stage did not complete'} — the range is UNREVIEWED (no fix was attempted)`
        : hard.fixer_died
          // Death reason FIRST — this string is sliced at 600 (ledger) / 1200 (EVP), and harden now
          // names WHY the fixer died (a stall names itself). harden's tree_delta counts the
          // unattributed edits a killed fixer left, so this no longer implies an empty tree.
          ? `${hard.fixer_death_reason ? hard.fixer_death_reason + ' — ' : ''}harden FIXER returned no structured report${(hard.tree_delta || []).length ? ` (${hard.tree_delta.length} unattributed edit(s) in the tree)` : ''} — any fix in the tree is UNATTRIBUTED (the gate may have made it); left UNCOMMITTED for inspection`
          // ONE NEUTRAL HEADING, because the engine cannot know which of these it is looking at and
          // both of the sentences that used to live here asserted something it had not checked.
          // "broken fixer edits" was an ACCUSATION: it fired whenever green_refusals was empty, and
          // it named three fix sets that had every gate exit 0 and 25 of 29 findings closed — all
          // three later re-applied cleanly and were committed by hand. "reported green but the
          // facts refuse it" was the opposite error: it asserts the gate CLAIMED green, which is
          // false on the two paths that now dominate (a gate that refused green itself, and a gate
          // that never returned). harden now guarantees a reason for every refusal, so relay it and
          // assert nothing beyond it.
          : `harden refused green: ${(hard.green_refusals || []).length ? hard.green_refusals.join(' ; ') : 'no reason was returned — the fix set is UNVERIFIED, not known to be bad'} — fix set left UNCOMMITTED (parked) for inspection`;
    return await escalate(wave, 'harden', `${why} (boundary pre_wave_sha ${preSha} preserved for a clean reset)`, {
      pre_wave_sha: preSha,
      db_name: dbName,
      committed_shas: commit.shas,
      harden_aborted: !!(hard && hard.aborted),
      harden_crashed: !hard,
      harden_green_refusals: (hard && hard.green_refusals) || [],
      // Death reasons + the unattributed-edit list, so the ledger and the escalation EVP carry the
      // cause structurally, not only inside the sliced `reason` string above.
      harden_fixer_death_reason: (hard && hard.fixer_death_reason) || null,
      harden_gate_death_reason: (hard && hard.gate_death_reason) || null,
      harden_tree_delta: relPaths(hard && hard.tree_delta),
      harden_findings: (hard && hard.confirmed) || [],
      harden_gate: (hard && hard.gate) || null,
      harden_unverified: (hard && hard.unverified) || [],
      harden_verify_stats: (hard && hard.verify_stats) || null,
      harden_refuted: (hard && hard.refuted) || [],
      harden_changed_files: relPaths(hard && hard.changed_files),
    });
  }
  // Porcelain truth for what harden actually left in the tree. hard.changed_files is agent-reported
  // (the gate's list, else the fixer's): an over-report is a false escalation, an under-report only
  // surfaces at harden-commit's HARD ASSERT with a worse message. Fall back to the report if this dies.
  const hardTruth = await tryAgent(
    `${common(wave, 'harden-truth')}
Report the REALIZED working-tree delta left by the harden stage (its fixes are UNCOMMITTED). Run EXACTLY: git -C ${WT} status --porcelain=v1 -uall
(-uall is load-bearing: bare porcelain hides files inside new directories as "dir/".)
Return paths = one entry per line: strip the two status chars + space; for renames ("R  old -> new") return the NEW path; strip any surrounding double-quotes git adds for special chars; include deleted files' paths. No commentary, no filtering.`,
    { label: `harden-truth:${wave.name}`, phase: 'harden', model: pin('sonnet'), schema: REALIZED },
  );
  if (!hardTruth || !Array.isArray(hardTruth.paths)) log(`harden-truth warn [${wave.name}]: porcelain read failed — using harden's self-reported changed_files`);
  const hardFiles = hardTruth && Array.isArray(hardTruth.paths) ? relPaths(hardTruth.paths) : relPaths(hard.changed_files);
  const hardMinted = newMigrations(hardFiles, migAllowed);
  if (hardMinted.length) return await escalate(wave, 'harden', `harden minted new migration file(s): ${hardMinted.join(', ')} (forbidden)`, { pre_wave_sha: preSha, db_name: dbName, committed_shas: commit.shas });
  const hardTouchedMig = touchesAny(hardFiles, migAllowed);

  // Harden safety verdict — see hardenVerdict. Escalations leave the fixes UNCOMMITTED in the tree
  // (pre_wave_sha preserved), with everything a human needs to finish by hand in the payload.
  const sweptSet = new Set(relPaths(rec.swept).concat(relPaths(rec.flagged)));
  const hv = hardenVerdict(hard, hardFiles, declaredSet(wave), migAllowed, sweptSet, backendWave);
  // harden_gate / harden_unverified / harden_refuted ride the payload so the escalation writeback
  // gets the same inputs the green path does, and so a human reading the payload can see what the
  // adversarial review actually concluded — including its NEGATIVE results, which previously
  // existed only in a live log line cut at 300 chars.
  const hardenExtra = () => ({ pre_wave_sha: preSha, db_name: dbName, committed_shas: commit.shas, harden_findings: hard.confirmed || [], fix_resolutions: hard.fix_resolutions || [], harden_changed_files: hardFiles, harden_gate: (hard && hard.gate) || null, harden_unverified: (hard && hard.unverified) || [], harden_refuted: (hard && hard.refuted) || [], harden_verify_stats: (hard && hard.verify_stats) || null });
  // Edits with no per-finding attribution (confirmed findings, files in the tree, but an empty
  // resolution list — a fixer that died and a gate that patched anyway) cannot be judged by the
  // doc rule or the flags. They are never committed by default.
  if ((hard.confirmed || []).length && !(hard.fix_resolutions || []).length && hardFiles.length)
    return await escalate(wave, 'harden', `harden left ${hardFiles.length} edited file(s) with NO per-finding attribution — cannot apply the safety verdict; left UNCOMMITTED: ${hardFiles.join(', ').slice(0, 300)}`, Object.assign(hardenExtra(), { failure_code: 'harden_unattributed_edits' }));
  if (hv.doc_runtime.length)
    return await escalate(wave, 'harden', `harden fixed a DOC finding by editing runtime code — left UNCOMMITTED for a human: ${hv.doc_runtime.map((d) => `${d.finding} → ${d.files}`).join(' | ').slice(0, 400)}`, Object.assign(hardenExtra(), { failure_code: 'harden_doc_runtime', doc_runtime: hv.doc_runtime }));
  // out_of_range follows the house hard/warn split (ownershipVerdict): harden's fixer is not gated
  // harder than the implementers were. Backend waves escalate; frontend waves commit-and-FLAG (commit
  // body, completion EVP, completed[]), exactly like reconcile's `flagged` channel.
  // A backend/ path realized on a NON-backend wave would ship with zero backend gates — the rule
  // ownershipVerdict hard-fails on every track applies to harden's fixer too.
  if (hv.backend_in_frontend.length)
    return await escalate(wave, 'harden', `harden touched backend path(s) on a non-backend wave — would ship with zero backend gates; left UNCOMMITTED: ${hv.backend_in_frontend.join(', ')}`, Object.assign(hardenExtra(), { failure_code: 'harden_backend_path_in_frontend_wave', backend_paths: hv.backend_in_frontend }));
  let outOfRangeFlag = [];
  if (hv.out_of_range.length) {
    if (backendWave)
      return await escalate(wave, 'harden', `harden fix OUT OF RANGE on a backend wave — left UNCOMMITTED: ${hv.out_of_range.join(', ')}`, Object.assign(hardenExtra(), { failure_code: 'harden_out_of_range', out_of_range: hv.out_of_range }));
    outOfRangeFlag = hv.out_of_range;
    log(`harden OUT-OF-RANGE flag [${wave.name}] (frontend wave — committed, flagged): ${hv.out_of_range.join(', ')}`);
  }
  hv.behavior_changes.forEach((b) => log(`harden BEHAVIOR CHANGE [${wave.name}]: ${b.finding} (${b.files})`));
  const outOfScopeHunks = String((hard.gate && hard.gate.out_of_scope_hunks) || '').trim();
  if (outOfScopeHunks) log(`harden out-of-scope hunks [${wave.name}]: ${outOfScopeHunks.slice(0, 200)}`);
  if ((hard.refuted || []).length) log(`harden refuted (NOT written back) [${wave.name}]: ${hard.refuted.map((r) => r && r.title).join(' | ').slice(0, 300)}`);
  // shellSafe: these strings reach a bash double-quoted commit body and a JSON EVP; agent-authored
  // finding titles routinely carry backticks and $.
  // A DEFERRED fix is work this wave deliberately did not do — the one flag that names something
  // still owed rather than something already committed. It leads, because a reader skimming the
  // commit body needs to see the open item before the disclosures about closed ones.
  // A gate excused inside HARDEN (its fixer re-ran the gates) was previously visible only in
  // harden's own log: if the wave gate saw the linter green and harden saw it red, nothing in the
  // wave's warnings, ledger or EVP said a gate had been waved through at all.
  for (const gi of ((hard && hard.inherited_red_gates) || [])) {
    const raw = String((wave.gate_cmds || [])[gi] ?? `gate[${gi}]`);
    const line = `inherited-red gate [${wave.name}]: harden's gate[${gi}] (${raw.slice(0, 60)}) exited nonzero and was already red with no test ids at the base — not blocking`;
    log(line);
    WAVE_WARNINGS.push(line);
    if (!WAVE_INHERITED_RED_GATES.includes(raw)) WAVE_INHERITED_RED_GATES.push(raw);
  }
  const deferredOOR = (hard && hard.deferred_out_of_range) || [];
  WAVE_DEFERRED = deferredOOR;
  const hardenFlagsText = [
    ...deferredOOR.map((d) => `DEFERRED (out of range for this wave, NOT fixed): ${shellSafe(d.finding)} — needed: ${shellSafe(d.note).slice(0, 300)}`),
    outOfRangeFlag.length ? `OUT OF RANGE (committed, flagged): ${outOfRangeFlag.join(', ')}` : '',
    ...hv.behavior_changes.map((b) => `BEHAVIOR CHANGE beyond the finding: ${shellSafe(b.finding)} (${shellSafe(b.files)})`),
    outOfScopeHunks ? `OUT-OF-SCOPE HUNKS (gate): ${shellSafe(outOfScopeHunks).slice(0, 500)}` : '',
    // A gate waved through because it was already red at the base belongs in the durable record
    // of the wave, next to every other caveat — a human reading only the EVP must not believe
    // this wave was gated by a command that never ran green in the first place.
    WAVE_INHERITED_RED_GATES.length
      ? `INHERITED-RED GATE(S) EXCUSED (already nonzero with no test ids on the untouched base): ${WAVE_INHERITED_RED_GATES.map((c) => shellSafe(String(c)).slice(0, 80)).join(' | ').slice(0, 400)}`
      : '',
    // The completion EVP is the durable record of a GREEN wave, and it listed every other caveat
    // except this one: findings the fixer acted on without an adversarial vote, because the
    // refuters that would have cast it died.
    (hard && (hard.unverified || []).length)
      ? `UNADJUDICATED (refuters died; kept by fail-loud policy, fixed anyway): ${hard.unverified.map((u) => shellSafe(String(u.title || '?')).slice(0, 80)).join(' | ').slice(0, 400)}`
      : '',
  ].filter(Boolean).join(' | ');
  if (deferredOOR.length) log(`harden DEFERRED [${wave.name}] ${deferredOOR.length} out-of-range fix(es) — the wave lands, the edit is owed: ${deferredOOR.map((d) => d.finding).join(' | ').slice(0, 300)}`);

  // 7. commit harden fixes (attributed to the primary ghost; body lists all affected ghosts)
  phase('harden-commit');
  if (hardFiles.length) {
    const hc = await tryAgent(
      `${common(wave, 'harden-commit')}
COMMIT the harden fixes (uncommitted in the tree) under the primary ghost:
${commitCmd(wave.primary_ghost_id, hardFiles.join(' '), wave.name + ' harden fixes', 'Adversarial review->fix. Affects ghosts: ' + wave.ghosts.map((g) => g.id).join(', ') + (hardenFlagsText ? ' | HARDEN FLAGS: ' + hardenFlagsText : ''))}
${RC_NOTE}
Then HARD ASSERT git -C ${WT} status --porcelain is EMPTY.
Return {ok, shas, clean, reason}.`,
      { label: `harden-commit:${wave.name}`, phase: 'harden-commit', model: pin('sonnet'), schema: COMMIT_RESULT },
    );
    if (!hc || !hc.ok || hc.clean === false) return await escalate(wave, 'harden-commit', (hc && hc.reason) || 'failed to commit harden fixes / tree not clean', hardenExtra());
    // Harden edited this wave's migration file(s) → the roundtrip proof is stale; re-prove it.
    if (wave.migration && hardTouchedMig && DB_MIGRATE) {
      phase('reversibility');
      const rev2 = await runReversibility(':post-harden');
      if (!rev2 || !rev2.ok) return await escalate(wave, 'reversibility', (rev2 && rev2.reason) || 'post-harden migration reversibility failed', Object.assign(hardenExtra(), { pre_head: preHead }));
    }
  }

  // 7b. write back Imprints — the Coven's memory. Same call the escalation path makes; see
  // writebackImprints(). BEST-EFFORT: a dead or failed writeback is logged and exorcise proceeds.
  phase('writeback');
  const wb = await writebackImprints(wave, {
    wi,
    confirmed: hard.confirmed,
    fix_resolutions: hard.fix_resolutions,
    gate: hard.gate,
    deferred: deferredOOR,
    learnings,
    projects: RECALL_PROJECTS,
    primarySha: ((commit.shas || []).find((sh) => sh && sh.ghost === wave.primary_ghost_id) || {}).sha,
    preSha,
    escalation: null,
  });

  // 8. exorcise (green + clean only)
  phase('exorcise');
  const exo = await tryAgent(
    `${CREDS}
${common(wave, 'exorcise')}
EXORCISE — this wave is committed, hardened, green, and the tree is clean. For EACH ghost, post a short completion EVP then set status exorcised:
${wave.ghosts.map((g) => `- ${g.id} — ${g.title || ''}`).join('\n')}
${hardenFlagsText ? `HARDEN FLAGS — include these VERBATIM in the primary ghost's (${wave.primary_ghost_id}) completion EVP so a human sees them before merge: ${hardenFlagsText}\n` : ''}${wb && wb.status === 'written' ? `Imprints written back: ${(wb.memory_ids || []).join(', ')} — mention the count in the primary ghost's EVP.\n` : ''}For each ghost <id>:
  curl -s -X POST -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' --data-binary @- "$API/api/agent/ghosts/<id>/evps" <<'JSON'
  {"content": "<1-2 sentence completion EVP: what shipped + gates green (frontend/backend/migration-gate/reversibility as applicable) + hardened>"}
  JSON
  curl -s -X PUT -H "$AUTH" -H "$GH_CLIENT" -H 'Content-Type: application/json' -d '{"status":"exorcised"}' "$API/api/agent/ghosts/<id>/status"
${RITE_ID ? 'Rite for reference: ' + RITE_ID + '.' : ''}
Return {exorcised:[ids that reached exorcised], failures:[{ghost, error}]}.`,
    { label: `exorcise:${wave.name}`, phase: 'exorcise', model: pin('sonnet'), schema: EXORCISE },
  );

  completed.push({
    wave: wave.name,
    ghost_shas: commit.shas,
    swept: relPaths(rec.swept),
    // The memory loop, both directions, on the SUCCESS path — where it used to be invisible.
    // `learnings` matters because the writeback distils AT MOST 5: everything it declined to
    // write was previously gone with no record, so a successful wave lost more than a failed one
    // (an escalation at least carried them in its payload). `recall` answers whether this wave
    // was built with the Coven's memory or without it.
    learnings: WAVE_LEARNINGS.slice(),
    recall: WAVE_RECALL,
    // A wave that only reached green because a gate was already red at the base must SAY so on
    // the success path. Silent excusal is how a dead gate stays dead for months.
    warnings: WAVE_WARNINGS.slice(),
    inherited_red_gates: WAVE_INHERITED_RED_GATES.slice(),
    hardened_green: true,
    // How many adversarial draws this wave actually got. A green wave that lost a third of its
    // refuters is not the same artefact as one that lost none, and before this the difference was
    // invisible on the success path — `unverified` only lists findings whose VERDICT changed.
    harden_verify_stats: (hard && hard.verify_stats) || null,
    harden_unverified: (hard && hard.unverified) || [],
    harden_changed_files: hardFiles,
    harden_flags: hv.flags,
    behavior_changes: hv.behavior_changes,
    out_of_range_flagged: outOfRangeFlag,
    deferred_out_of_range: deferredOOR,
    out_of_scope_hunks: outOfScopeHunks,
    // writebackImprints() always returns a shaped verdict — skipped / written / replayed /
    // failed — so there is no null case to interpret here any more.
    imprints: { status: wb.status, memory_ids: wb.memory_ids || [], reason: wb.reason || '' },
    migrations: realizedMig,
    db_name: dbName || null,
    exorcised: (exo && exo.exorcised) || [],
    exorcise_failures: (exo && exo.failures) || [],
    // A dead exorcise agent used to be indistinguishable from a wave with nothing to exorcise:
    // `|| []` erased the null, completed[] still said hardened_green, and the run returned
    // status:'complete' with every ghost still active_haunt and no completion EVP posted — which
    // invoke-ritual then journals as `fulfilled`. Git, the ritual and the tracker all disagree and
    // only a human notices. The verdict is recorded here and rolled up into the final return.
    // Previously log-only or dropped entirely. `warns` is cross-implementer ownership trouble on
    // a frontend wave; `flagged` is the reconcile channel whose own prompt says "the human should
    // know" and which reached the payload only when reconcile itself FAILED; refuted/unverified are
    // the adversarial review's negative results, which lived in a 300-char log line.
    skipped_capabilities: SKIPPED.filter((x) => x.startsWith(`${wave.name}: `)).map((x) => x.slice(wave.name.length + 2)),
    ownership_warns: verdict.warns,
    flagged: relPaths(rec.flagged),
    harden_refuted: (hard.refuted || []).map((r) => ({ title: r && r.title, file: r && r.file, why: r && r.why })),
    harden_unverified: hard.unverified || [],
    exorcise_status: !exo
      ? 'agent-died'
      : ((exo.failures || []).length ? 'partial' : ((exo.exorcised || []).length === (wave.ghosts || []).length ? 'ok' : 'partial')),
  });
  if (!exo) log(`exorcise FAILED [${wave.name}]: agent died — ${(wave.ghosts || []).length} ghost(s) are still active_haunt with no completion EVP; the tracker does NOT reflect this committed wave`);
  else if ((exo.failures || []).length) log(`exorcise PARTIAL [${wave.name}]: ${(exo.failures || []).map((f) => `${f.ghost}: ${f.error}`).join(' | ').slice(0, 300)}`);
  log(`wave "${wave.name}" complete: ${(commit.shas || []).length} ghost commit(s), harden green${realizedMig.length ? `, migration ${realizedMig.join(', ')}${DB_MIGRATE ? ' roundtrip-proven' : ' (reversibility skipped)'}` : ''}, ${((exo && exo.exorcised) || []).length} exorcised`);
}

// ── Cleanup: drop this run's scratch DBs by EXACT name (prefix reap would eat a concurrent
// run whose slug extends ours). Escalated runs never reach here — their DBs are left, named in
// the payload, for debugging; the next invocation's drop→create resets them.
if (createdDbs.length) {
  phase('cleanup');
  await tryAgent(
    `${common({ name: '(post-run)' }, 'cleanup')}
Drop EACH of this run's scratch databases by exact name (idempotent):
${createdDbs.map((d) => `  "${WT}/${DB_SCRIPT}" drop ${d}`).join('\n')}
Do NOT use "reap" (a prefix sweep could hit a concurrent run). Return done=true with a note listing what dropped.`,
    { label: 'cleanup', phase: 'cleanup', model: pin('sonnet'), schema: DONE },
  );
}

// A 'complete' run that left the tracker inconsistent with git must SAY SO in its return value,
// not only in a live log line the caller may never see: invoke-ritual reads this return to decide
// whether to journal the ritual step fulfilled.
const runWarnings = completed.flatMap((c) => {
  // Per-wave warnings first — an excused inherited-red gate is the operator's business, and
  // warnings[] is what invoke-ritual lifts verbatim to the top of its summary.
  const w = (c.warnings || []).slice();
  if (c.exorcise_status && c.exorcise_status !== 'ok') w.push(`wave "${c.wave}": exorcise ${c.exorcise_status} — ghost(s) committed but NOT closed in the tracker`);
  // "memory silently did not get written" is the exact complaint this release exists to kill; it
  // must not return as a clean `complete`. `replayed` is a warning too: on a reset-and-rerun it
  // means THIS attempt's learnings were dropped in favour of an earlier receipt.
  // A GREEN WAVE THAT LOST REFUTERS IS NOT THE SAME ARTEFACT AS ONE THAT DID NOT. This is a
  // warning, deliberately never a refusal: harden's keep-on-tie bias means a lost draw costs a
  // wasted fix, not a missed defect, and refusing green over an API-side event would recreate the
  // false-escalation class 1.6.x spent three releases removing. But it must be a NUMBER a human
  // sees — `warnings[]` is what invoke-ritual lifts verbatim to the top of its summary.
  const vs = c.harden_verify_stats;
