// ── Args (normalized — object | JSON string | undefined; house pattern) ──
let A = args;
if (typeof A === 'string') {
  try {
    A = JSON.parse(A);
  } catch (e) {
    A = {};
  }
}
if (!A || typeof A !== 'object') A = {};

const WT = A.worktree_path;
if (!WT) throw new Error('rite-cadence requires args.worktree_path');
const BRANCH = A.branch;
if (!BRANCH) throw new Error('rite-cadence requires args.branch (the expected ext/<rite> branch)');
const CONTRACT = A.contract_path || '';
const API = A.api_base || '__CFG_api_base__';
const RITE_ID = A.rite_id || '';
const STOP_BEFORE = A.stop_before || '';
const RESUME_FROM = A.resume_from || '';
const DRY_RUN = !!A.dry_run;
const WAVES = Array.isArray(A.waves) ? A.waves : [];
// Child-workflow ref: the name registry only lists tracked workflows, so callers may pass an
// explicit script path for harden (args.harden_script); name lookup remains the default.
const HARDEN_REF = A.harden_script ? { scriptPath: A.harden_script } : 'harden';

// ── Operator model remap ──────────────────────────────────────────────────────────────────
// Every stage below is model-pinned. Those pins are DEFAULTS, not law: an operator out of quota
// on a tier needs to move stages off it. Before this existed the only way was to EDIT THE ENGINE
// — and two independent operators did exactly that on the same day, one by running a patched copy
// from a scratchpad. Executing a derived engine file is the precise hazard Fix E exists to prevent
// (the obvious shortcut is to copy whatever engine is nearest, which in a worktree is the stale
// one). So make it supported input instead of a reason to fork the file:
//     .ghost/config.json  { "models": { "remap": { "fable": "opus" } } }   ← repo default, set once
//     args.model_overrides: { fable: 'opus' }                                 ← per-invocation, wins
// Mirrors harden's existing per-stage override surface. Unknown tiers are ignored, not an error.
// Repo default from .ghost/config.json `models.remap`, overridden per-invocation by
// args.model_overrides. The config layer is the one that matters in practice: a per-invocation
// arg has to be remembered EVERY time, and forgetting it means the run burns on a tier the
// operator has no quota for — which is what sends people back to editing the engine.
const CFG_MODEL_REMAP = __CFG_model_remap__;
const MODEL_REMAP = Object.assign({}, CFG_MODEL_REMAP && typeof CFG_MODEL_REMAP === 'object' ? CFG_MODEL_REMAP : {}, A.model_overrides && typeof A.model_overrides === 'object' ? A.model_overrides : {});
const pin = (m) => (typeof MODEL_REMAP[m] === 'string' && MODEL_REMAP[m] ? MODEL_REMAP[m] : m);

// ── Repo-parameterized scripts / commands (rendered from .ghost/config.json) ──
// Each may render EMPTY; the code below guards every one (skip-with-log or a validate issue).
const COMMIT_SCRIPT = '__CFG_commit_script__'; // isolation.commit_script (secret-scanned commit)
const DB_SCRIPT = '__CFG_db_script__'; // isolation.db_script (scratch-Postgres manager: create/url/drop)
const DB_MIGRATE = '__CFG_db_migrate__'; // isolation.db_migrate (migration CLI: current/upgrade/downgrade)
const MIGRATION_GATE = '__CFG_migration_gate__'; // isolation.migration_gate (Alembic single-head + drift gate)
const PG_SMOKE = '__CFG_pg_smoke__'; // isolation.pg_smoke (genuine-Postgres ORM smoke gate)
const DB_PREFIX = '__CFG_db_prefix__'; // isolation.db_prefix (scratch-DB name prefix)
const TEST_BACKEND = '__CFG_test_backend__'; // tests.backend
const TEST_FRONTEND = '__CFG_test_frontend__'; // tests.frontend
const TEST_ALL = '__CFG_test_all__'; // tests.all — never probed, never excusable (same reason)

// ── Commit path (rendered from .ghost/config.json isolation.commit_script) ──
// May render EMPTY (repo without a secret-scanning per-ghost commit script) — every commit
// stage then falls back to plain git add/commit with an explicit "Ghost: <id>" trailer (the
// trailer is what resume-guard greps for). The fallback runs NO secret scan — surfaced via
// log() at validate.
const commitCmd = (ghost, filesText, message, body) =>
  COMMIT_SCRIPT
    ? `cd "${WT}" && ${COMMIT_SCRIPT} --ghost ${ghost} --files "${filesText}" --message ${JSON.stringify(message)}${body ? ' --body ' + JSON.stringify(body) : ''}`
    : `cd "${WT}" && git add -- ${filesText} && git commit -m ${JSON.stringify(message)}${body ? ' -m ' + JSON.stringify(body) : ''} -m "Ghost: ${ghost}"`;
const RC_NOTE = COMMIT_SCRIPT
  ? 'Parse rc like the commit stage (exit 3 secret → STOP; exit 0+sha → committed; exit 0 no-sha → nothing to commit).'
  : 'Handle outcomes like the commit stage (git failure → STOP; committed → record sha; "nothing to commit" → no-op).';
const commitHowto = COMMIT_SCRIPT
  ? `For each: cd "${WT}" && ${COMMIT_SCRIPT} --ghost <id> --files "<files>" --message <msg> [--body <body>]  (the commit script stages ONLY the --files you pass)
Parse the exit code STRICTLY and STOP on the first problem:
- exit 3 (secret scan) → ok:false, reason "secret: <filename: pattern_name>" (filename:pattern ONLY — NEVER the secret value); STOP.
- exit 1 → ok:false, reason; STOP.
- exit 0 with a trailing 40-hex sha → committed; record {ghost, sha}.
- exit 0 with "nothing to commit" and NO sha → idempotent no-op (already committed, e.g. on resume); record {ghost, sha:"(none)"}; CONTINUE.`
  : `For each (plain-git fallback — this repo has no commit script; map --files/--message/--body from the ghost lines): cd "${WT}" && git add -- <files> && git commit -m <msg> [-m <body>] -m "Ghost: <id>"
The "Ghost: <id>" trailer is REQUIRED as its own -m (resume-guard greps for it). Handle outcomes STRICTLY and STOP on the first problem:
- git add/commit failure → ok:false, reason; STOP.
- committed → record {ghost, sha} (sha = git -C ${WT} rev-parse HEAD).
- "nothing to commit" → idempotent no-op (already committed, e.g. on resume); record {ghost, sha:"(none)"}; CONTINUE.`;

// ── Backend-track constants ──
// DB namespace: rc<slug>. The "rc" marker keeps rite-cadence scratch DBs in their own family,
// distinct from any lane / merge-gate DB families a repo also runs, so a crash-reap of one
// family never eats another. Cleanup in THIS run always drops EXACT names (a prefix reap would
// eat a concurrent run whose slug merely extends ours, e.g. "party" vs "party2").
const SLUG = BRANCH.replace(/^ext\//, '').replace(/[^A-Za-z0-9_]/g, '');
const DB_NS = 'rc' + SLUG;
const dbFull = (slug) => (DB_PREFIX ? DB_PREFIX + '_' : '') + slug + '_test';
const dbBase = (slug) => (DB_PREFIX ? DB_PREFIX + '_' : '') + slug;
// DSN surgery. NOT `new URL()`: the Workflow script sandbox exposes plain ECMAScript built-ins
// only — no WHATWG URL, no Node globals — so `new URL(...)` throws ReferenceError "URL is not
// defined" on EVERY dsn. That shipped in v1.3.4/v1.3.5 and made the entire backend track
// unstartable (db_resolve runs in `baseline`, before any implementer spawns).
// NOT a loose regex either, which is what the URL approach was avoiding: a naive one silently
// NO-OPS on a trailing slash, leaving the wrong database name in place undetected, and rewrites
// the USERINFO when a password contains ? or #. This pattern handles the trailing slash, and on
// an unencoded ? or # in the password it THROWS rather than mangling — safe, but note that is a
// REFUSAL, not a parse: `new URL()` accepted those and this does not. Percent-encode such a
// password. So: one strict ANCHORED pattern that must match
// the whole DSN, and THROWS when it does not — preserving the fail-loud property (a scratch-DB
// URL we cannot parse must escalate, never be guessed at). Uses only RegExp + String.
const DSN_RE = /^([A-Za-z][A-Za-z0-9+.-]*):\/\/([^/?#]*)\/([^/?#]+)\/?([?#][\s\S]*)?$/;
function parseDsn(raw) {
  const m = DSN_RE.exec(String(raw == null ? '' : raw).trim());
  if (!m) throw new Error('not a parseable database URL (expected scheme://authority/dbname): ' + String(raw == null ? '' : raw).trim().slice(0, 120));
  return { scheme: m[1], authority: m[2], db: m[3], rest: m[4] || '' };
}
const urlDbName = (raw) => parseDsn(raw).db;
const withDbName = (raw, name) => { const p = parseDsn(raw); return p.scheme + '://' + p.authority + '/' + name + p.rest; };
const BACKEND_RE = /^backend\//;
// Migration paths — BROADENED UNION across ghost-kit repos: an alembic/ or migrations/ tree,
// optionally nested under backend/. env.py / alembic.ini (outside versions/) stay declarable.
const MIGRATION_DECLARED_RE = /(^|\/)(backend\/)?(alembic|migrations)\/versions\//;
// Runtime detector for REALIZED paths — migration files are never declared (the revision
// number depends on the live head at build time), so this pattern is the only authority.
const MIGRATION_RUNTIME_RE = /(^|\/)(backend\/)?(alembic|migrations)\/versions\/[^/]+\.py$/;

// Path-form normalization. TWO kinds of file list meet in this engine and they do NOT agree:
//   - TRUTH lists come from `git status --porcelain`, so they are repo-relative.
//   - FOREIGN lists (gate/harden changed_files, reconcile swept/flagged) are whatever the
//     agent chose to report, and every stage prompt hands the agent an ABSOLUTE `${WT}`.
// Comparing them raw broke both ways: MIGRATION_RUNTIME_RE is anchored `(^|\/)` so it MATCHES
// an absolute path, while exclusion used exact Set.has() which never does. That made
// newMigrations() fire on a wave's own committed migration (a false escalation), and made
// hardTouchedMig permanently FALSE — silently skipping the post-harden reversibility re-proof,
// so a harden-edited migration shipped with a proof taken against a different version of the
// file. Normalize where a foreign list ARRIVES, never at the individual comparisons.
// No `new RegExp` here: a constructed pattern would need WT escaped, and the sandbox-globals
// gate plus plain string ops make prefix-stripping the simpler, safer form.
const WT_PREFIX = String(WT || '').replace(/\/+$/, '') + '/';
const relPath = (p) => {
  let s = String(p == null ? '' : p).trim().replace(/^"|"$/g, '');
  if (s.startsWith(WT_PREFIX)) s = s.slice(WT_PREFIX.length);
  while (s.startsWith('./')) s = s.slice(2);
  // Deliberately NOT stripping a leading '/' generally: an absolute path OUTSIDE this
  // worktree (a sibling worktree, the main checkout) must stay absolute. Rewriting it to
  // look repo-relative would let it match migAllowed and be treated as this wave's own file.
  return s;
};
const relPaths = (a) => (Array.isArray(a) ? a : []).map(relPath).filter(Boolean);
// Does any path in `list` name a file in `allowedSet`? Named (not inlined) so the silent half
// of the bug above is directly testable.
const touchesAny = (list, allowedSet) => relPaths(list).some((p) => allowedSet.has(p));
const isBackendWave = (w) => !!(w && (w.backend || w.migration));
const anyBackend = WAVES.some(isBackendWave);
const anyFrontendGate = !!TEST_FRONTEND && WAVES.some((w) => (w.gate_cmds || []).some((c) => String(c).includes(TEST_FRONTEND)));
// Every DISTINCT plan-authored gate command across the whole invocation, in RAW form — {{db_url}}
// still unsubstituted. Raw is the only comparable form: at gate time each wave substitutes its
// OWN scratch-DB url, so two waves running the identical command produce different strings. The
// probe below records inherited-red gates by this raw text, and the gate stage looks them up by
// wave.gate_cmds[i] (also raw) rather than by the substituted effectiveGates[i].
const PLAN_GATE_CMDS = Array.from(new Set(WAVES.flatMap((w) => (w.gate_cmds || []).map((c) => String(c)))));
const anyPlanGate = PLAN_GATE_CMDS.length > 0;
const probeNeedsDb = PLAN_GATE_CMDS.some((c) => c.includes('{{db_url}}'));
// Is this gate command one of the repo's TEST SUITES? Such a gate is the baseline's business, not
// the probe's, on both counts: re-running it here costs a second full suite per invocation, and a
// suite that exits nonzero while naming NO ids is a BROKEN suite (import/collection error, missing
// deps) — the one thing that must never be excused, since excusing it ships a wave untested.
const normCmd = (x) => String(x == null ? '' : x).trim().replace(/^\.\//, '');
// Token-BOUNDED, not a bare substring: with tests.frontend = `npm run test`, a plain includes()
// also claims `npm run test:types`, and a gate wrongly called a suite is never probed and never
// excusable — the very post-build escalation this release removes. The suite string must be
// followed by end-of-string or a shell boundary.
const isTestSuiteCmd = (c) => {
  const hay = normCmd(c);
  return [TEST_BACKEND, TEST_FRONTEND, TEST_ALL].filter(Boolean).map(normCmd).some((t) => {
    let i = hay.indexOf(t);
    while (i >= 0) {
      const after = hay[i + t.length];
      if (after === undefined || ' \t;&|)'.includes(after)) return true;
      i = hay.indexOf(t, i + 1);
    }
    return false;
  });
};

// ── Memory (Imprints) — pure-JS helpers ─────────────────────────────────────────────────────
// The recall query is the wave's ghost-title words OR-ed. The server ANDs a plain phrase
// (websearch_to_tsquery), so posting a whole title matches only an Imprint containing EVERY word
// of it — i.e. nothing, for any realistic title. OR still ranks by how many terms hit. At today's
// corpus size this is effectively "the Haunting's top 8 Imprints" — do NOT tune it against one
// rite's first output. The server caps `query` at 500 chars (schemas/memory.py): whole terms are
// dropped from the end, never cut mid-word. `or`/`and`/`not` are dropped: websearch syntax reads
// a lowercase `or` as the operator. (The skills' jq idiom keeps them — websearch_to_tsquery is
// error-tolerant, so `fix OR or OR gate` still parses; do NOT "fix" one to match the other, the
// skill copies are pinned byte-identical to commence-haunt's.) Plain String/RegExp/Set — no globals.
// The shell/JSON channels below receive agent-authored free text: strip what bash or a JSON
// heredoc would interpret (backticks, $, backslashes, double quotes).
const shellSafe = (s) => String(s == null ? '' : s).replace(/[`$\\]/g, '').replace(/"/g, "'");
const RECALL_QUERY_MAX = 500;
const RECALL_STOP = ['or', 'and', 'not'];
// Whole terms drop from the END until the joined query fits the server's cap, never a mid-word cut.
// Shared by BOTH axes so neither can overrun the request while the other is trimmed.
const capTerms = (terms) => {
  const out = (Array.isArray(terms) ? terms : []).slice();
  while (out.length && out.join(' OR ').length > RECALL_QUERY_MAX) out.pop();
  return out;
};
// ── Axis 1: FEATURE vocabulary — the wave's ghost-title words ──
// Terms are interleaved ROUND-ROBIN across the wave's ghosts, not concatenated ghost-by-ghost.
// The 500-char cap drops whole terms from the END, so a flat concatenation silently spends the
// entire budget on ghost 1 and recalls NOTHING for the later ghosts of a multi-ghost wave. With
// interleaving, the tail-drop takes the least-significant round from every ghost evenly.
const recallTerms = (wave) => {
  const seen = new Set();
  const perGhost = ((wave && wave.ghosts) || []).map((g) => {
    const out = [];
    for (const w of String((g && g.title) || '').toLowerCase().match(/[a-z0-9]{2,}/g) || []) {
      if (RECALL_STOP.includes(w) || seen.has(w)) continue;
      seen.add(w);
      out.push(w);
    }
    return out;
  });
  const terms = [];
  for (let i = 0; perGhost.some((t) => i < t.length); i++)
    for (const t of perGhost) if (i < t.length) terms.push(t[i]);
  return terms;
};
const recallQuery = (wave) => capTerms(recallTerms(wave)).join(' OR ');
// ── Axis 2: MECHANISM vocabulary — the tokens of the wave's DECLARED FILE PATHS ──
// WHY A SECOND CALL AND NOT ONE WIDER QUERY. ts_rank has NO IDF (backend/app/repositories/memory.py:
// match = ts_rank/(ts_rank+1), one ORDER BY, one LIMIT), so rank rises with the NUMBER and weight of
// matched lexemes and never with a term's rarity. In a MERGED query a doc matching four generic
// title words outranks a doc matching the single rare mechanism word -- at ANY limit. Raising the
// server's 500-char cap therefore does NOT fix this and must not be mistaken for the fix: the axes
// stay two calls so each gets its own top-N quota.
// THE DEFECT THIS EXISTS FOR: ghost titles name FEATURES ("The Ashes -- cascading soft delete,
// purge, restore"); Imprints name MECHANISMS ("_ACTION_TO_EVENT_TYPE", "actionRegistry.js"). Imprint
// 9e59b78d was written BY the wave that learned it and recalled by none of the waves that needed it,
// because the two vocabularies never share a word.
const MECH_DROP = new Set(['js', 'jsx', 'ts', 'tsx', 'mjs', 'cjs', 'py', 'md', 'mdx', 'json', 'sh', 'bash', 'yml', 'yaml', 'toml', 'ini', 'sql', 'css', 'scss', 'html', 'txt', 'test', 'tests', 'spec', 'specs']);
// A basename STEM names the mechanism; a DIRECTORY names the layer. Every backend path in a layered
// repo yields app/api/services/repositories and every frontend path yields src/components/pages --
// and with no IDF those hand the same generic layering Imprints a multi-term boost in EVERY wave,
// crowding the quota with identical hits. So: stem first, and the parent directory ONLY when the
// stem is itself generic and names nothing.
const GENERIC_STEM = new Set(['index', 'main', 'init', 'app', 'mod', 'types', 'utils', 'helpers', 'constants']);
const splitWords = (s) => String(s == null ? '' : s).replace(/([a-z0-9])([A-Z])/g, '$1 $2').toLowerCase().match(/[a-z0-9]+/g) || [];
const pathTerms = (p) => {
  const parts = String(p == null ? '' : p).split('/').filter(Boolean);
  if (!parts.length) return [];
  const stem = parts[parts.length - 1].replace(/\.[^.]*$/, '');
  let out = splitWords(stem);
  if (!out.length || out.every((w) => GENERIC_STEM.has(w) || MECH_DROP.has(w)))
    if (parts.length > 1) out = splitWords(parts[parts.length - 2]).concat(out);
  return out;
};
const mechanismTerms = (files, featureTerms) => {
  const seen = new Set(Array.isArray(featureTerms) ? featureTerms : []);
  const terms = [];
  for (const f of Array.isArray(files) ? files : Array.from(files || []))
    for (const w of pathTerms(f)) {
      if (w.length < 3 || RECALL_STOP.includes(w) || MECH_DROP.has(w) || seen.has(w)) continue;
      seen.add(w);
      terms.push(w);
    }
  return terms;
};
const mechanismQuery = (wave, featureTerms) => capTerms(mechanismTerms(Array.from(declaredSet(wave)), featureTerms)).join(' OR ');
// Merge the two recall axes ROUND-ROBIN, deduped by id — IN THE ENGINE, never by the agent.
// WHY: formatRecall keeps entries in ARRAY ORDER until RECALL_BLOCK_MAX and then stops. When the
// agent pasted one concatenated union (feature first, mechanism second), a block sized for N items
// dropped the mechanism tail — so the very Imprint this second axis exists to deliver was the first
// thing cut, while the log still reported a successful recall. Interleaving makes the cap cost both
// axes evenly, and doing it here makes it testable instead of being a sonnet's paste order.
const interleaveRecalled = (a, b) => {
  const lists = [Array.isArray(a) ? a : [], Array.isArray(b) ? b : []];
  const seen = new Set();
  const out = [];
  for (let i = 0; lists.some((l) => i < l.length); i++)
    for (const l of lists) {
      const it = i < l.length ? l[i] : null;
      if (!it || !it.id || seen.has(it.id)) continue;
      seen.add(it.id);
      out.push(it);
    }
  return out;
};
// Render recalled Imprints as ONE block, prepended to every implementer's build prompt and passed
// to harden as context_notes. Budget: 10 items (5 per recall axis) × (1200 content + 200 title +
// ~110 fixed) ≈ 15.1 KB. Raised from 12000/8 when the mechanism axis was added; harden's
// CONTEXT_NOTES_MAX must move WITH it (the mjs suite pins the two numbers equal).
// CONTENT_MAX matches the jq projection in the recall stage — ONE cap, in two places that must
// agree, not two independent cuts of the same string. It is deliberately most of the server's
// 2000-char Imprint limit: the tail of a gotcha is where the "and here is what to do instead"
